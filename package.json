{
  "name": "mini-games",
  "version": "1.0.0",
  "description": "A collection of free browser-based mini games",
  "keywords": [
    "games",
    "browser-games",
    "html5-games"
  ],
  "author": "mazipan",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:css\" \"npm run dev:html\"",
    "dev:css": "tailwindcss -i ./src/css/main.css -o ./_site/css/main.css --watch",
    "dev:html": "eleventy --serve --incremental",
    "build": "npm run build:html && npm run build:css",
    "build:html": "eleventy",
    "build:css": "tailwindcss -i ./src/css/main.css -o ./_site/css/main.css --minify",
    "format": "prettier --write \"**/*.{html,njk,css,js,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{html,njk,css,js,json,md}\" --ignore-path .prettierignore",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17"
  },
  "lint-staged": {
    "*.{html,njk,css,js,json,md}": [
      "prettier --write"
    ]
  }
}
