<section id="games" class="py-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <h2 class="text-3xl font-bold text-white mb-12 text-center">All Games</h2>

    {% set categories = ["arcade", "puzzle", "board", "word"] %} {% for cat in categories %} {% set catGames = [] %} {%
    for g in games %} {% if g.category == cat %} {% set catGames = (catGames.push(g), catGames) %} {% endif %} {% endfor
    %} {% if catGames.length > 0 %}
    <div class="mb-14" id="{{ cat }}">
      <div class="flex items-center gap-3 mb-6">
        <span class="badge {{ cat | categoryColor }}">{{ cat | categoryLabel }}</span>
        <div class="flex-1 h-px bg-slate-800"></div>
        <span class="text-sm text-slate-500">{{ catGames.length }} game{{ "s" if catGames.length != 1 }}</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for game in catGames %}
        <a href="/games/{{ game.slug }}/" class="card p-6 group flex flex-col gap-4">
          <div class="flex items-start justify-between">
            <span class="text-4xl">{{ game.icon }}</span>
            <span class="badge {{ game.category | categoryColor }}">{{ game.category | categoryLabel }}</span>
          </div>
          <div class="flex-1">
            <h3 class="text-lg font-semibold text-white group-hover:text-violet-400 transition-colors mb-1">
              {{ game.name }}
            </h3>
            <p class="text-sm text-slate-400 leading-relaxed">{{ game.description }}</p>
          </div>
          <div class="flex items-center justify-between pt-2 border-t border-slate-700">
            <span class="text-xs {{ game.difficulty | difficultyColor }} font-medium capitalize"
              >{{ game.difficulty }}</span
            >
            <span class="text-xs text-violet-400 font-medium group-hover:underline">Play Now →</span>
          </div>
        </a>
        {% endfor %}
      </div>
    </div>
    {% endif %} {% endfor %}
  </div>
</section>
