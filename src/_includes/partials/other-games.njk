<section class="border-t border-slate-800 py-6">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-center gap-3 mb-4">
      <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">More Games</span>
      <div class="flex-1 h-px bg-slate-800"></div>
      <a href="/#games" class="text-xs text-violet-400 hover:text-violet-300 transition-colors">View all →</a>
    </div>

    <div class="flex flex-wrap gap-2">
      {% for game in games %} {% if game.slug !== gameSlug %}
      <a
        href="/games/{{ game.slug }}/"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-800 border border-slate-700 hover:border-violet-500/50 hover:bg-slate-700 transition-all duration-150 group"
      >
        <span class="text-sm leading-none">{{ game.icon }}</span>
        <span class="text-xs font-medium text-slate-300 group-hover:text-white transition-colors whitespace-nowrap"
          >{{ game.name }}</span
        >
      </a>
      {% endif %} {% endfor %}
    </div>
  </div>
</section>
