<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="{{ description or site.description }}" />
    <title>{{ title }} — {{ site.title }}</title>
    <link rel="stylesheet" href="/css/main.css" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎮</text></svg>"
    />
  </head>
  <body class="min-h-screen bg-slate-900 flex flex-col">
    <!-- Game Nav -->
    <nav
      class="flex items-center justify-between px-4 py-3 bg-slate-900/80 backdrop-blur border-b border-slate-800 sticky top-0 z-50"
    >
      <a href="/" class="flex items-center gap-2 text-slate-300 hover:text-white transition-colors group">
        <svg
          class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span class="text-sm font-medium">All Games</span>
      </a>
      <div class="flex items-center gap-2">
        <span class="text-lg">{{ icon or "🎮" }}</span>
        <span class="font-semibold text-white">{{ title }}</span>
        {% if category %}
        <span class="badge {{ category | categoryColor }}">{{ category | categoryLabel }}</span>
        {% endif %}
      </div>
      <a
        href="{{ site.repo }}"
        target="_blank"
        rel="noopener noreferrer"
        class="text-slate-400 hover:text-white transition-colors"
        title="View source"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
          />
        </svg>
      </a>
    </nav>

    <!-- Game Content -->
    <div class="flex-1 flex flex-col">{{ content | safe }}</div>

    {% include "partials/footer.njk" %}
  </body>
</html>
