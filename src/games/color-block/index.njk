---
layout: layouts/game.njk
title: Color Block
description: Place colorful block shapes on the grid and clear full rows and columns.
category: puzzle
icon: "🟦"
---

{% from "macros/game-components.njk" import infoDetails %}

<style>
  :root {
    --grid-cell: min(34px, calc((100vw - 3rem) / 10.5));
  }
  #game-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: calc(100vh - 60px);
    gap: 1rem;
    padding: 1rem;
  }
  .score-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.5rem 1.2rem;
    min-width: 64px;
  }
  .stat-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .stat-value {
    font-size: 1.2rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  #game-area {
    position: relative;
    user-select: none;
  }
  #grid {
    display: grid;
    grid-template-columns: repeat(10, var(--grid-cell));
    grid-template-rows: repeat(10, var(--grid-cell));
    gap: 3px;
    padding: 6px;
    background: #0f172a;
    border-radius: 10px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
  }
  .grid-cell {
    width: var(--grid-cell);
    height: var(--grid-cell);
    border-radius: 4px;
    background: #1e293b;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: background 0.05s;
  }
  .grid-cell.preview {
    opacity: 0.55;
  }
  #shelf {
    display: flex;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    min-height: 80px;
  }
  .piece-slot {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1e293b;
    border: 2px solid #334155;
    border-radius: 10px;
    padding: 10px;
    min-width: 72px;
    min-height: 72px;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition:
      border-color 0.15s,
      background 0.15s,
      opacity 0.15s;
  }
  .piece-slot.selected {
    border-color: #3b82f6;
    background: #1e3a5f;
  }
  .piece-slot.used {
    opacity: 0.2;
    cursor: default;
    pointer-events: none;
  }
  .piece-slot:not(.used):not(.selected):hover {
    border-color: #475569;
    background: #263447;
  }
  .piece-mini {
    display: grid;
    gap: 2px;
  }
  .piece-mini-cell {
    width: 12px;
    height: 12px;
    border-radius: 2px;
  }
  .hint-text {
    font-size: 0.75rem;
    color: #64748b;
    text-align: center;
    margin: 0;
  }
  #start-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.93);
    border-radius: 10px;
    gap: 0.75rem;
    z-index: 10;
  }
  #start-overlay h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #e2e8f0;
    margin: 0;
  }
  #start-overlay p {
    color: #94a3b8;
    font-size: 0.85rem;
    margin: 0;
    text-align: center;
    padding: 0 1rem;
  }
  #gameover-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.95);
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    z-index: 100;
    padding: 1rem;
  }
  #gameover-overlay h2 {
    font-size: 1.8rem;
    font-weight: 700;
    color: #e2e8f0;
    margin: 0;
    text-align: center;
  }
  #go-icon {
    font-size: 3rem;
    line-height: 1;
  }
  .summary-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .summary-stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.5rem 1.2rem;
    min-width: 70px;
  }
  .summary-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .summary-value {
    font-size: 1.4rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  #go-context {
    color: #94a3b8;
    font-size: 0.9rem;
    text-align: center;
    margin: 0;
  }
  .play-btn {
    padding: 0.5rem 1.5rem;
    background: #7c3aed;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .play-btn:hover {
    background: #6d28d9;
  }
  .info-section {
    width: 100%;
    max-width: 420px;
    padding: 0 1rem 2rem;
    margin: 0 auto;
  }
  .info-details {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    margin-bottom: 0.75rem;
    overflow: hidden;
  }
  .info-details summary {
    padding: 0.75rem 1rem;
    font-weight: 600;
    color: #e2e8f0;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
  }
  .info-details summary::-webkit-details-marker {
    display: none;
  }
  .info-details summary::after {
    content: "+";
    font-size: 1.1rem;
    color: #64748b;
  }
  .info-details[open] summary::after {
    content: "−";
  }
  .info-body {
    padding: 0.75rem 1rem 1rem;
    color: #94a3b8;
    font-size: 0.875rem;
    line-height: 1.6;
    border-top: 1px solid #334155;
  }
  .info-body h4 {
    color: #e2e8f0;
    font-weight: 600;
    margin: 0.75rem 0 0.25rem;
    font-size: 0.875rem;
  }
  .info-body h4:first-child {
    margin-top: 0;
  }
  .info-body ul {
    padding-left: 1.25rem;
    margin: 0.25rem 0;
  }
  .info-body li {
    margin-bottom: 0.25rem;
  }
  .info-body p {
    margin: 0.25rem 0;
  }
</style>

<div id="game-wrapper">
  <div class="score-row">
    <div class="stat">
      <div class="stat-label">Score</div>
      <div class="stat-value" id="score">0</div>
    </div>
    <div class="stat">
      <div class="stat-label">Best</div>
      <div class="stat-value" id="best">0</div>
    </div>
  </div>

  <div id="game-area">
    <div id="grid"></div>
    <div id="start-overlay">
      <span style="font-size: 2.5rem">🟦</span>
      <h2>Color Block</h2>
      <p>Place shapes on the grid and clear full rows &amp; columns!</p>
      <button class="play-btn" onclick="startGame()">New Game</button>
    </div>
  </div>

  <div id="shelf"></div>
  <p class="hint-text">Select a piece, then click the grid to place it</p>
</div>

<div id="gameover-overlay" style="display: none">
  <span id="go-icon">💀</span>
  <h2>Game Over</h2>
  <div class="summary-row">
    <div class="summary-stat">
      <div class="summary-label">Score</div>
      <div class="summary-value" id="go-score">0</div>
    </div>
    <div class="summary-stat">
      <div class="summary-label">Best</div>
      <div class="summary-value" id="go-best">0</div>
    </div>
  </div>
  <p id="go-context">No remaining pieces can fit on the board.</p>
  <button class="play-btn" onclick="startGame()">New Game</button>
</div>

<div class="info-section">
  {% call infoDetails("How to Play") %}
  <h4>Goal</h4>
  <p>
    Place colorful block shapes onto the 10×10 grid. Fill an entire row or column to clear it and score bonus points.
    Keep placing pieces as long as they fit — the game ends when none of your 3 current pieces can fit anywhere.
  </p>
  <h4>Controls</h4>
  <ul>
    <li><strong>Click a piece</strong> in the shelf below the grid to select it</li>
    <li><strong>Hover over the grid</strong> to preview where the piece will land (desktop)</li>
    <li><strong>Click a grid cell</strong> to place the selected piece with its top-left at that cell</li>
    <li>On <strong>mobile</strong>: tap a piece to select it, then tap the grid to place it</li>
  </ul>
  <h4>Scoring</h4>
  <ul>
    <li>Each cell you fill: <strong>+1 point</strong></li>
    <li>Clearing a full row: <strong>+10 bonus points</strong></li>
    <li>Clearing a full column: <strong>+10 bonus points</strong></li>
    <li>Multiple rows/columns cleared at once each give +10</li>
  </ul>
  {% endcall %} {% call infoDetails("FAQ") %}
  <h4>How do I earn bonus points?</h4>
  <p>
    Fill every cell in a row or column. When a line is completely filled it clears automatically and you earn +10 bonus
    points per line cleared.
  </p>
  <h4>When do I get new pieces?</h4>
  <p>
    You always have 3 pieces on the shelf. Once all 3 have been placed, a fresh set of 3 random pieces appears. You can
    place them in any order.
  </p>
  <h4>What counts as game over?</h4>
  <p>
    The game ends when none of the 3 pieces currently on your shelf can fit anywhere on the grid — not even in a single
    empty cell.
  </p>
  <h4>Is my best score saved?</h4>
  <p>Yes — your best score is automatically saved in your browser's local storage and persists between sessions.</p>
  {% endcall %}
</div>

<script>
  function launchConfetti() {
    const canvas = document.createElement("canvas");
    canvas.style.cssText = "position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999";
    document.body.appendChild(canvas);
    const ctx = canvas.getContext("2d");
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    const colors = ["#ef4444", "#fbbf24", "#10b981", "#3b82f6", "#a78bfa", "#f97316", "#ec4899"];
    const pieces = Array.from({ length: 80 }, () => ({
      x: Math.random() * canvas.width,
      y: -10 - Math.random() * 40,
      r: Math.random() * 6 + 3,
      color: colors[Math.floor(Math.random() * colors.length)],
      vx: (Math.random() - 0.5) * 5,
      vy: Math.random() * 4 + 2,
      angle: Math.random() * Math.PI * 2,
      va: (Math.random() - 0.5) * 0.15,
    }));
    const start = performance.now();
    function draw(now) {
      if (now - start > 3000) {
        canvas.remove();
        return;
      }
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      pieces.forEach((p) => {
        p.x += p.vx;
        p.y += p.vy;
        p.angle += p.va;
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.angle);
        ctx.fillStyle = p.color;
        ctx.fillRect(-p.r, -p.r / 2, p.r * 2, p.r);
        ctx.restore();
      });
      requestAnimationFrame(draw);
    }
    requestAnimationFrame(draw);
  }

  // ── Constants ─────────────────────────────────────────────────────────────
  const STORAGE_KEY = "mini-color-block-best";
  const GRID_SIZE = 10;

  const SHAPES = [
    [[0, 0]], // dot
    [
      [0, 0],
      [0, 1],
    ], // H2
    [
      [0, 0],
      [1, 0],
    ], // V2
    [
      [0, 0],
      [0, 1],
      [0, 2],
    ], // H3
    [
      [0, 0],
      [1, 0],
      [2, 0],
    ], // V3
    [
      [0, 0],
      [0, 1],
      [0, 2],
      [0, 3],
    ], // H4
    [
      [0, 0],
      [1, 0],
      [2, 0],
      [3, 0],
    ], // V4
    [
      [0, 0],
      [0, 1],
      [1, 0],
      [1, 1],
    ], // 2×2
    [
      [0, 0],
      [0, 1],
      [0, 2],
      [1, 0],
      [1, 1],
      [1, 2],
    ], // 2×3
    [
      [0, 0],
      [0, 1],
      [1, 0],
      [1, 1],
      [2, 0],
      [2, 1],
    ], // 3×2
    [
      [0, 0],
      [1, 0],
      [2, 0],
      [2, 1],
    ], // L
    [
      [0, 1],
      [1, 1],
      [2, 0],
      [2, 1],
    ], // J
    [
      [0, 0],
      [0, 1],
      [0, 2],
      [1, 1],
    ], // T
    [
      [0, 0],
      [1, 0],
      [1, 1],
    ], // corner
    [
      [0, 1],
      [1, 0],
      [1, 1],
    ], // corner2
    [
      [0, 0],
      [0, 1],
      [1, 1],
    ], // corner3
    [
      [0, 0],
      [0, 1],
      [0, 2],
      [1, 0],
    ], // L-wide
    [
      [0, 0],
      [0, 1],
      [0, 2],
      [1, 2],
    ], // J-wide
    [
      [0, 0],
      [0, 1],
      [0, 2],
      [1, 2],
      [2, 2],
    ], // large-L
    [
      [0, 0],
      [1, 0],
      [2, 0],
      [2, 1],
      [2, 2],
    ], // large-J
  ];

  const COLORS = ["#ef4444", "#f97316", "#eab308", "#22c55e", "#3b82f6", "#a855f7"];

  // ── State ─────────────────────────────────────────────────────────────────
  let grid = []; // 10×10 array: 0 = empty, else color string
  let score = 0;
  let best = parseInt(localStorage.getItem(STORAGE_KEY) || "0", 10);
  let shelfPieces = []; // array of {shape, color}
  let shelfUsed = [false, false, false]; // which shelf slots have been placed
  let selectedPiece = null; // index 0-2 or null
  let hoverCell = null; // {r, c} or null
  let gameActive = false;

  document.getElementById("best").textContent = best;

  // ── Piece generation ──────────────────────────────────────────────────────
  function randomPiece() {
    const shape = SHAPES[Math.floor(Math.random() * SHAPES.length)];
    const color = COLORS[Math.floor(Math.random() * COLORS.length)];
    return { shape, color };
  }

  function generateShelf() {
    shelfPieces = [randomPiece(), randomPiece(), randomPiece()];
    shelfUsed = [false, false, false];
    selectedPiece = null;
  }

  // ── Grid helpers ──────────────────────────────────────────────────────────
  function emptyGrid() {
    return Array.from({ length: GRID_SIZE }, () => Array(GRID_SIZE).fill(0));
  }

  function canPlace(shape, r, c) {
    for (const [dr, dc] of shape) {
      const nr = r + dr;
      const nc = c + dc;
      if (nr < 0 || nr >= GRID_SIZE || nc < 0 || nc >= GRID_SIZE) return false;
      if (grid[nr][nc] !== 0) return false;
    }
    return true;
  }

  function placePiece(shape, color, r, c) {
    for (const [dr, dc] of shape) {
      grid[r + dr][c + dc] = color;
    }
  }

  function clearLines() {
    let bonus = 0;
    const rowsToClear = [];
    const colsToClear = [];

    for (let r = 0; r < GRID_SIZE; r++) {
      if (grid[r].every((cell) => cell !== 0)) rowsToClear.push(r);
    }
    for (let c = 0; c < GRID_SIZE; c++) {
      if (grid.every((row) => row[c] !== 0)) colsToClear.push(c);
    }

    for (const r of rowsToClear) {
      for (let c = 0; c < GRID_SIZE; c++) grid[r][c] = 0;
      bonus += 10;
    }
    for (const c of colsToClear) {
      for (let r = 0; r < GRID_SIZE; r++) grid[r][c] = 0;
      bonus += 10;
    }

    return bonus;
  }

  // ── Game-over check ───────────────────────────────────────────────────────
  function pieceCanFitAnywhere(shape) {
    for (let r = 0; r < GRID_SIZE; r++) {
      for (let c = 0; c < GRID_SIZE; c++) {
        if (canPlace(shape, r, c)) return true;
      }
    }
    return false;
  }

  function isGameOver() {
    for (let i = 0; i < 3; i++) {
      if (!shelfUsed[i] && pieceCanFitAnywhere(shelfPieces[i].shape)) return false;
    }
    return true;
  }

  // ── Start / new game ──────────────────────────────────────────────────────
  function startGame() {
    grid = emptyGrid();
    score = 0;
    gameActive = true;
    selectedPiece = null;
    hoverCell = null;
    generateShelf();
    document.getElementById("score").textContent = 0;
    document.getElementById("start-overlay").style.display = "none";
    document.getElementById("gameover-overlay").style.display = "none";
    render();
  }

  // ── Placement handler ─────────────────────────────────────────────────────
  function handleCellClick(r, c) {
    if (!gameActive) return;
    if (selectedPiece === null) return;
    const { shape, color } = shelfPieces[selectedPiece];
    if (!canPlace(shape, r, c)) return;

    // Place the piece
    placePiece(shape, color, r, c);
    const cellsPlaced = shape.length;
    const bonus = clearLines();
    score += cellsPlaced + bonus;

    // Update best
    if (score > best) {
      best = score;
      localStorage.setItem(STORAGE_KEY, best);
      document.getElementById("best").textContent = best;
      launchConfetti();
    }
    document.getElementById("score").textContent = score;

    shelfUsed[selectedPiece] = true;
    selectedPiece = null;
    hoverCell = null;

    // If all 3 placed, refresh shelf
    if (shelfUsed.every((u) => u)) {
      generateShelf();
    }

    // Check game over after shelf might have been refreshed
    if (isGameOver()) {
      endGame();
      return;
    }

    render();
  }

  function endGame() {
    gameActive = false;
    document.getElementById("go-score").textContent = score;
    document.getElementById("go-best").textContent = best;
    document.getElementById("go-context").textContent = "No remaining pieces can fit on the board.";
    render();
    setTimeout(() => {
      document.getElementById("gameover-overlay").style.display = "flex";
    }, 400);
  }

  // ── Rendering ─────────────────────────────────────────────────────────────
  function getPreviewCells() {
    if (selectedPiece === null || hoverCell === null) return new Set();
    const { shape } = shelfPieces[selectedPiece];
    const { r, c } = hoverCell;
    if (!canPlace(shape, r, c)) return new Set();
    const cells = new Set();
    for (const [dr, dc] of shape) cells.add(`${r + dr},${c + dc}`);
    return cells;
  }

  function getPreviewColor() {
    if (selectedPiece === null) return null;
    return shelfPieces[selectedPiece].color;
  }

  function render() {
    renderGrid();
    renderShelf();
  }

  function renderGrid() {
    const gridEl = document.getElementById("grid");
    const previewCells = getPreviewCells();
    const previewColor = getPreviewColor();

    // Build cells array if not already built (first render)
    if (gridEl.children.length !== GRID_SIZE * GRID_SIZE) {
      gridEl.innerHTML = "";
      for (let r = 0; r < GRID_SIZE; r++) {
        for (let c = 0; c < GRID_SIZE; c++) {
          const cell = document.createElement("div");
          cell.className = "grid-cell";
          cell.dataset.r = r;
          cell.dataset.c = c;
          cell.addEventListener("click", () => handleCellClick(r, c));
          cell.addEventListener("mouseenter", () => {
            if (!gameActive || selectedPiece === null) return;
            hoverCell = { r, c };
            renderGrid();
          });
          cell.addEventListener("mouseleave", () => {
            if (!gameActive || selectedPiece === null) return;
            hoverCell = null;
            renderGrid();
          });
          gridEl.appendChild(cell);
        }
      }
    }

    // Update cell visuals
    const cells = gridEl.children;
    let idx = 0;
    for (let r = 0; r < GRID_SIZE; r++) {
      for (let c = 0; c < GRID_SIZE; c++) {
        const cell = cells[idx++];
        const key = `${r},${c}`;
        if (grid[r][c] !== 0) {
          // Filled cell
          cell.style.background = grid[r][c];
          cell.classList.remove("preview");
        } else if (previewCells.has(key)) {
          // Preview cell
          cell.style.background = previewColor;
          cell.classList.add("preview");
        } else {
          // Empty cell
          cell.style.background = "#1e293b";
          cell.classList.remove("preview");
        }
      }
    }
  }

  function getPieceBoundingBox(shape) {
    let maxR = 0,
      maxC = 0;
    for (const [dr, dc] of shape) {
      if (dr > maxR) maxR = dr;
      if (dc > maxC) maxC = dc;
    }
    return { rows: maxR + 1, cols: maxC + 1 };
  }

  function renderShelf() {
    const shelfEl = document.getElementById("shelf");
    shelfEl.innerHTML = "";

    for (let i = 0; i < 3; i++) {
      const { shape, color } = shelfPieces[i];
      const used = shelfUsed[i];
      const isSelected = selectedPiece === i;
      const { rows, cols } = getPieceBoundingBox(shape);

      // Build a set for fast lookup
      const cellSet = new Set(shape.map(([dr, dc]) => `${dr},${dc}`));

      const wrapper = document.createElement("div");
      wrapper.className = "piece-slot" + (used ? " used" : "") + (isSelected ? " selected" : "");
      if (!used) {
        wrapper.addEventListener("click", () => {
          if (!gameActive) return;
          selectedPiece = selectedPiece === i ? null : i;
          hoverCell = null;
          render();
        });
      }

      const miniGrid = document.createElement("div");
      miniGrid.className = "piece-mini";
      miniGrid.style.gridTemplateColumns = `repeat(${cols}, 12px)`;
      miniGrid.style.gridTemplateRows = `repeat(${rows}, 12px)`;

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const miniCell = document.createElement("div");
          miniCell.className = "piece-mini-cell";
          miniCell.style.background = cellSet.has(`${r},${c}`) ? color : "transparent";
          miniGrid.appendChild(miniCell);
        }
      }

      wrapper.appendChild(miniGrid);
      shelfEl.appendChild(wrapper);
    }
  }

  // ── Init ──────────────────────────────────────────────────────────────────
  // Build the grid DOM on load so the board is visible behind the start overlay.
  // Touch taps use the existing click listeners — touch-action:manipulation
  // removes the 300ms delay so taps feel instant on mobile.
  grid = emptyGrid();
  generateShelf();
  renderGrid();
  renderShelf();
