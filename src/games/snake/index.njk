<div id="game-wrapper">
  <div class="score-row">
    <div class="stat">
      <div class="stat-label">Score</div>
      <div class="stat-value" id="score">0</div>
    </div>
    <div class="stat">
      <div class="stat-label">Level</div>
      <div class="stat-value" id="level-display">1</div>
    </div>
    <div class="stat">
      <div class="stat-label">Best</div>
      <div class="stat-value" id="high-score">0</div>
    </div>
  </div>
  <div class="canvas-wrapper">
    <canvas id="snake-canvas" width="400" height="400"></canvas>
    <div id="overlay">
      <span class="demo-label" id="demo-label">Live Demo</span>
      <span style="font-size: 3rem">🐍</span>
      <h2 id="overlay-title">Snake</h2>
      <p id="overlay-msg" class="controls-hint" style="color: #94a3b8"></p>
      <button class="play-btn" onclick="startGame()">Play Game</button>
    </div>
  </div>
  <div id="dpad">
    <div></div>
    <button class="dpad-btn" data-dir="0,-1">▲</button>
    <div></div>
    <button class="dpad-btn" data-dir="-1,0">◀</button>
    <div></div>
    <button class="dpad-btn" data-dir="1,0">▶</button>
    <div></div>
    <button class="dpad-btn" data-dir="0,1">▼</button>
    <div></div>
  </div>
  <p class="controls-hint">Arrow keys or WASD to move</p>
</div>

<div class="info-section">
  <details class="info-details">
    <summary>How to Play</summary>
    <div class="info-body">
      <h4>Goal</h4>
      <p>
        Guide the snake to eat the red food dots. Each food makes the snake grow longer. Avoid hitting the walls or your
        own tail!
      </p>
      <h4>Controls</h4>
      <ul>
        <li><strong>Arrow keys</strong> or <strong>WASD</strong> — change direction (desktop)</li>
        <li><strong>D-pad buttons</strong> — tap to change direction (mobile)</li>
      </ul>
      <h4>Levels &amp; Speed</h4>
      <ul>
        <li>Starts at <strong>Level 1</strong> with a comfortable pace</li>
        <li>Every <strong>5 foods eaten</strong> = level up &amp; speed increase</li>
        <li>Maximum speed is reached at Level 8</li>
      </ul>
      <h4>Scoring</h4>
      <ul>
        <li>Each food eaten = <strong>10 points</strong></li>
        <li>Your best score is saved in your browser</li>
      </ul>
    </div>
  </details>
  <details class="info-details">
    <summary>FAQ</summary>
    <div class="info-body">
      <h4>What is the Live Demo?</h4>
      <p>Before you start, an AI snake plays automatically in the background so you can see how the game works.</p>
      <h4>Is my best score saved?</h4>
      <p>Yes — saved automatically in your browser's local storage, persisting between sessions on the same device.</p>
      <h4>Can I play on mobile?</h4>
      <p>Yes! The D-pad appears automatically on small screens. Tap the direction buttons to move.</p>
    </div>
  </details>
</div>

<script>
  const CELL = 20,
    COLS = 20,
    ROWS = 20;
  const canvas = document.getElementById("snake-canvas");
  const ctx = canvas.getContext("2d");
  const STORAGE_KEY = "mini-snake-best";

  let snake,
    dir,
    nextDir,
    food,
    score,
    foodEaten,
    level,
    highScore = parseInt(localStorage.getItem(STORAGE_KEY) || "0", 10),
    running = false,
    holding = false,
    interval,
    demoInterval;

  document.getElementById("high-score").textContent = highScore;

  function getSpeed(lvl) {
    return Math.max(100, 450 - (lvl - 1) * 25);
  }
  function getFastSpeed(lvl) {
    return Math.max(70, Math.floor(getSpeed(lvl) * 0.4));
  }
  function applySpeed() {
    if (!running) return;
    clearInterval(interval);
    interval = setInterval(tick, holding ? getFastSpeed(level) : getSpeed(level));
  }
  function startHold() {
    if (holding || !running) return;
    holding = true;
    applySpeed();
  }
  function stopHold() {
    if (!holding) return;
    holding = false;
    applySpeed();
  }
  function rnd(n) {
    return Math.floor(Math.random() * n);
  }

  function spawnFood() {
    let pos;
    do {
      pos = { x: rnd(COLS), y: rnd(ROWS) };
    } while (snake.some((s) => s.x === pos.x && s.y === pos.y));
    food = pos;
  }

  // Simple greedy AI for demo mode
  function demoAI() {
    const head = snake[0];
    const dx = food.x - head.x,
      dy = food.y - head.y;
    const preferred = [];
    if (Math.abs(dx) >= Math.abs(dy)) {
      if (dx > 0) preferred.push({ x: 1, y: 0 });
      else if (dx < 0) preferred.push({ x: -1, y: 0 });
      if (dy > 0) preferred.push({ x: 0, y: 1 });
      else if (dy < 0) preferred.push({ x: 0, y: -1 });
    } else {
      if (dy > 0) preferred.push({ x: 0, y: 1 });
      else if (dy < 0) preferred.push({ x: 0, y: -1 });
      if (dx > 0) preferred.push({ x: 1, y: 0 });
      else if (dx < 0) preferred.push({ x: -1, y: 0 });
    }
    const all = [
      { x: 1, y: 0 },
      { x: -1, y: 0 },
      { x: 0, y: 1 },
      { x: 0, y: -1 },
    ];
    for (const d of [...preferred, ...all]) {
      if (d.x === -dir.x && d.y === -dir.y) continue;
      const nx = head.x + d.x,
        ny = head.y + d.y;
      if (nx < 0 || nx >= COLS || ny < 0 || ny >= ROWS) continue;
      if (snake.some((s) => s.x === nx && s.y === ny)) continue;
      nextDir = d;
      return;
    }
  }

  function initDemoSnake() {
    snake = [
      { x: 10, y: 10 },
      { x: 9, y: 10 },
      { x: 8, y: 10 },
    ];
    dir = { x: 1, y: 0 };
    nextDir = { x: 1, y: 0 };
    spawnFood();
  }

  function demoTick() {
    demoAI();
    dir = nextDir;
    const head = { x: snake[0].x + dir.x, y: snake[0].y + dir.y };
    if (
      head.x < 0 ||
      head.x >= COLS ||
      head.y < 0 ||
      head.y >= ROWS ||
      snake.some((s) => s.x === head.x && s.y === head.y)
    ) {
      initDemoSnake(); // restart demo on death
      return;
    }
    snake.unshift(head);
    if (head.x === food.x && head.y === food.y) {
      spawnFood();
    } else {
      snake.pop();
    }
    draw();
  }

  function startDemo() {
    clearInterval(demoInterval);
    initDemoSnake();
    draw();
    demoInterval = setInterval(demoTick, 150);
  }

  function startGame() {
    clearInterval(demoInterval);
    document.getElementById("demo-label").style.display = "none";
    snake = [
      { x: 10, y: 10 },
      { x: 9, y: 10 },
      { x: 8, y: 10 },
    ];
    dir = { x: 1, y: 0 };
    nextDir = { x: 1, y: 0 };
    score = 0;
    foodEaten = 0;
    level = 1;
    document.getElementById("score").textContent = "0";
    document.getElementById("level-display").textContent = "1";
    spawnFood();
    running = true;
    holding = false;
    document.getElementById("overlay").style.display = "none";
    clearInterval(interval);
    interval = setInterval(tick, getSpeed(1));
  }

  function setDir(x, y) {
    if (x !== 0 && dir.x !== 0) return;
    if (y !== 0 && dir.y !== 0) return;
    nextDir = { x, y };
  }

  function tick() {
    dir = nextDir;
    const head = { x: snake[0].x + dir.x, y: snake[0].y + dir.y };
    if (
      head.x < 0 ||
      head.x >= COLS ||
      head.y < 0 ||
      head.y >= ROWS ||
      snake.some((s) => s.x === head.x && s.y === head.y)
    ) {
      endGame();
      return;
    }
    snake.unshift(head);
    if (head.x === food.x && head.y === food.y) {
      score += 10;
      foodEaten++;
      document.getElementById("score").textContent = score;
      const newLevel = Math.floor(foodEaten / 5) + 1;
      if (newLevel !== level) {
        level = newLevel;
        document.getElementById("level-display").textContent = level;
        applySpeed();
      }
      spawnFood();
    } else {
      snake.pop();
    }
    draw();
  }

  function draw() {
    ctx.fillStyle = "#0f172a";
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.strokeStyle = "#1e293b";
    ctx.lineWidth = 0.5;
    for (let r = 0; r < ROWS; r++) for (let c = 0; c < COLS; c++) ctx.strokeRect(c * CELL, r * CELL, CELL, CELL);
    snake.forEach((s, i) => {
      ctx.fillStyle = i === 0 ? "#22c55e" : "#16a34a";
      ctx.beginPath();
      ctx.roundRect(s.x * CELL + 1, s.y * CELL + 1, CELL - 2, CELL - 2, 3);
      ctx.fill();
    });
    ctx.fillStyle = "#f43f5e";
    ctx.beginPath();
    ctx.arc(food.x * CELL + CELL / 2, food.y * CELL + CELL / 2, CELL / 2 - 2, 0, Math.PI * 2);
    ctx.fill();
  }

  function endGame() {
    running = false;
    holding = false;
    clearInterval(interval);
    if (score > highScore) {
      highScore = score;
      localStorage.setItem(STORAGE_KEY, highScore);
      document.getElementById("high-score").textContent = highScore;
    }
    const overlay = document.getElementById("overlay");
    document.getElementById("demo-label").style.display = "none";
    document.getElementById("overlay-title").textContent = "Game Over";
    document.getElementById("overlay-msg").textContent = `Score: ${score} · Level: ${level}`;
    overlay.querySelector("button").textContent = "Play Again";
    overlay.style.display = "flex";
    startDemo();
  }

  const KEY_MAP = {
    ArrowUp: [0, -1],
    ArrowDown: [0, 1],
    ArrowLeft: [-1, 0],
    ArrowRight: [1, 0],
    w: [0, -1],
    s: [0, 1],
    a: [-1, 0],
    d: [1, 0],
  };

  document.addEventListener("keydown", (e) => {
    if (!KEY_MAP[e.key]) return;
    e.preventDefault();
    if (!e.repeat) {
      setDir(...KEY_MAP[e.key]);
      startHold();
    }
  });

  document.addEventListener("keyup", (e) => {
    if (KEY_MAP[e.key]) stopHold();
  });

  document.querySelectorAll(".dpad-btn").forEach((btn) => {
    const [x, y] = btn.dataset.dir.split(",").map(Number);
    btn.addEventListener(
      "touchstart",
      (e) => {
        e.preventDefault();
        setDir(x, y);
        startHold();
      },
      { passive: false }
    );
    btn.addEventListener("touchend", stopHold);
    btn.addEventListener("touchcancel", stopHold);
    btn.addEventListener("mousedown", () => {
      setDir(x, y);
      startHold();
    });
    btn.addEventListener("mouseup", stopHold);
    btn.addEventListener("mouseleave", stopHold);
  });

  // Start demo immediately
  startDemo();
</script>
