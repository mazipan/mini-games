---
layout: layouts/game.njk
title: Snake
description: Guide the snake to eat food and grow — but don't hit the walls or yourself!
category: arcade
icon: "🐍"
---

<style>
  #game-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 60px);
    gap: 1rem;
    padding: 1rem;
  }
  canvas {
    border: 2px solid #14532d;
    border-radius: 4px;
  }
  .canvas-wrapper {
    position: relative;
  }
  #overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.92);
    border-radius: 4px;
    gap: 1rem;
  }
  #overlay h2 {
    font-size: 1.6rem;
    font-weight: bold;
    color: white;
  }
  .score-row {
    display: flex;
    gap: 2rem;
  }
  .stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.6rem 1.2rem;
  }
  .stat-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .stat-value {
    font-size: 1.4rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  .play-btn {
    padding: 0.5rem 1.5rem;
    background: #16a34a;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
  }
  .play-btn:hover {
    background: #15803d;
  }
  .controls-hint {
    font-size: 0.75rem;
    color: #64748b;
    text-align: center;
  }
  #dpad {
    display: none;
    grid-template-columns: repeat(3, 48px);
    grid-template-rows: repeat(3, 48px);
    gap: 4px;
  }
  @media (max-width: 640px) {
    #dpad {
      display: grid;
    }
  }
  .dpad-btn {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    color: white;
    font-size: 1.2rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .dpad-btn:active {
    background: #334155;
  }
</style>
<div id="game-wrapper">
  <div class="score-row">
    <div class="stat">
      <div class="stat-label">Score</div>
      <div class="stat-value" id="score">0</div>
    </div>
    <div class="stat">
      <div class="stat-label">High Score</div>
      <div class="stat-value" id="high-score">0</div>
    </div>
  </div>
  <div class="canvas-wrapper">
    <canvas id="snake-canvas" width="400" height="400"></canvas>
    <div id="overlay">
      <span style="font-size: 3rem">🐍</span>
      <h2 id="overlay-title">Snake</h2>
      <p id="overlay-msg" class="controls-hint" style="color: #94a3b8"></p>
      <button class="play-btn" onclick="startGame()">Play Game</button>
    </div>
  </div>
  <div id="dpad">
    <div></div>
    <button class="dpad-btn" onclick="setDir(0, -1)">▲</button>
    <div></div>
    <button class="dpad-btn" onclick="setDir(-1, 0)">◀</button>
    <div></div>
    <button class="dpad-btn" onclick="setDir(1, 0)">▶</button>
    <div></div>
    <button class="dpad-btn" onclick="setDir(0, 1)">▼</button>
    <div></div>
  </div>
  <p class="controls-hint">Arrow keys or WASD to move</p>
</div>
<script>
  const CELL = 20,
    COLS = 20,
    ROWS = 20;
  const canvas = document.getElementById("snake-canvas");
  const ctx = canvas.getContext("2d");
  let snake,
    dir,
    nextDir,
    food,
    score,
    highScore = 0,
    running = false,
    interval;

  function rnd(n) {
    return Math.floor(Math.random() * n);
  }

  function spawnFood() {
    let pos;
    do {
      pos = { x: rnd(COLS), y: rnd(ROWS) };
    } while (snake.some((s) => s.x === pos.x && s.y === pos.y));
    food = pos;
  }

  function startGame() {
    snake = [
      { x: 10, y: 10 },
      { x: 9, y: 10 },
      { x: 8, y: 10 },
    ];
    dir = { x: 1, y: 0 };
    nextDir = { x: 1, y: 0 };
    score = 0;
    document.getElementById("score").textContent = "0";
    spawnFood();
    running = true;
    document.getElementById("overlay").style.display = "none";
    clearInterval(interval);
    interval = setInterval(tick, 120);
  }

  function setDir(x, y) {
    if (x !== 0 && dir.x !== 0) return;
    if (y !== 0 && dir.y !== 0) return;
    nextDir = { x, y };
  }

  function tick() {
    dir = nextDir;
    const head = { x: snake[0].x + dir.x, y: snake[0].y + dir.y };
    if (
      head.x < 0 ||
      head.x >= COLS ||
      head.y < 0 ||
      head.y >= ROWS ||
      snake.some((s) => s.x === head.x && s.y === head.y)
    ) {
      endGame();
      return;
    }
    snake.unshift(head);
    if (head.x === food.x && head.y === food.y) {
      score += 10;
      document.getElementById("score").textContent = score;
      spawnFood();
    } else {
      snake.pop();
    }
    draw();
  }

  function draw() {
    ctx.fillStyle = "#0f172a";
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.strokeStyle = "#1e293b";
    ctx.lineWidth = 0.5;
    for (let r = 0; r < ROWS; r++) for (let c = 0; c < COLS; c++) ctx.strokeRect(c * CELL, r * CELL, CELL, CELL);
    snake.forEach((s, i) => {
      const green = i === 0 ? "#22c55e" : "#16a34a";
      ctx.fillStyle = green;
      ctx.beginPath();
      ctx.roundRect(s.x * CELL + 1, s.y * CELL + 1, CELL - 2, CELL - 2, 3);
      ctx.fill();
    });
    ctx.fillStyle = "#f43f5e";
    ctx.beginPath();
    ctx.arc(food.x * CELL + CELL / 2, food.y * CELL + CELL / 2, CELL / 2 - 2, 0, Math.PI * 2);
    ctx.fill();
  }

  function endGame() {
    running = false;
    clearInterval(interval);
    if (score > highScore) {
      highScore = score;
      document.getElementById("high-score").textContent = highScore;
    }
    const overlay = document.getElementById("overlay");
    document.getElementById("overlay-title").textContent = "Game Over";
    document.getElementById("overlay-msg").textContent = `Score: ${score}`;
    const btn = overlay.querySelector("button");
    btn.textContent = "Play Again";
    overlay.style.display = "flex";
  }

  document.addEventListener("keydown", (e) => {
    const map = {
      ArrowUp: [0, -1],
      ArrowDown: [0, 1],
      ArrowLeft: [-1, 0],
      ArrowRight: [1, 0],
      w: [0, -1],
      s: [0, 1],
      a: [-1, 0],
      d: [1, 0],
    };
    if (map[e.key]) {
      e.preventDefault();
      setDir(...map[e.key]);
    }
  });

  ctx.fillStyle = "#0f172a";
  ctx.fillRect(0, 0, canvas.width, canvas.height);
</script>
