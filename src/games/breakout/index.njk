---
layout: layouts/game.njk
title: Breakout
description: Break all the bricks by bouncing the ball with your paddle.
category: arcade
icon: "🧱"
---

<style>
  #game-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 60px);
    gap: 1rem;
    padding: 1rem;
  }
  canvas {
    border: 2px solid #7c2d12;
    border-radius: 4px;
    cursor: none;
  }
  .canvas-wrapper {
    position: relative;
  }
  #overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.92);
    border-radius: 4px;
    gap: 1rem;
  }
  #overlay h2 {
    font-size: 1.6rem;
    font-weight: bold;
    color: white;
  }
  .score-row {
    display: flex;
    gap: 2rem;
  }
  .stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.6rem 1.2rem;
  }
  .stat-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .stat-value {
    font-size: 1.4rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  .play-btn {
    padding: 0.5rem 1.5rem;
    background: #ea580c;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
  }
  .play-btn:hover {
    background: #c2410c;
  }
  .controls-hint {
    font-size: 0.75rem;
    color: #64748b;
  }
  .lives {
    display: flex;
    gap: 0.5rem;
  }
  .life {
    font-size: 1rem;
  }
</style>
<div id="game-wrapper">
  <div class="score-row">
    <div class="stat">
      <div class="stat-label">Score</div>
      <div class="stat-value" id="score">0</div>
    </div>
    <div class="stat">
      <div class="stat-label">Lives</div>
      <div class="stat-value lives" id="lives">
        <span class="life">❤️</span><span class="life">❤️</span><span class="life">❤️</span>
      </div>
    </div>
    <div class="stat">
      <div class="stat-label">Level</div>
      <div class="stat-value" id="level">1</div>
    </div>
  </div>
  <div class="canvas-wrapper">
    <canvas id="breakout" width="480" height="480"></canvas>
    <div id="overlay">
      <span style="font-size: 3rem">🧱</span>
      <h2>Breakout</h2>
      <p style="color: #94a3b8; font-size: 0.85rem">Mouse or ← → keys to move paddle</p>
      <button class="play-btn" onclick="startGame()">Play Game</button>
    </div>
  </div>
  <p class="controls-hint">Move mouse or use ← → arrow keys</p>
</div>
<script>
  const canvas = document.getElementById("breakout");
  const ctx = canvas.getContext("2d");
  const W = canvas.width,
    H = canvas.height;
  const PADDLE_W = 80,
    PADDLE_H = 10,
    BALL_R = 8;
  const BRICK_ROWS = 5,
    BRICK_COLS = 10,
    BRICK_H = 18,
    BRICK_GAP = 4;
  const BRICK_W = (W - BRICK_GAP) / BRICK_COLS - BRICK_GAP;
  const BRICK_COLORS = ["#f43f5e", "#f97316", "#eab308", "#22c55e", "#3b82f6"];

  let paddle,
    ball,
    bricks,
    score,
    lives,
    level,
    running = false,
    animId;

  function createBricks(lvl) {
    const arr = [];
    for (let r = 0; r < BRICK_ROWS; r++) {
      for (let c = 0; c < BRICK_COLS; c++) {
        arr.push({
          x: BRICK_GAP + c * (BRICK_W + BRICK_GAP),
          y: 50 + r * (BRICK_H + BRICK_GAP),
          w: BRICK_W,
          h: BRICK_H,
          color: BRICK_COLORS[r],
          alive: true,
          hits: r < 2 ? 2 : 1,
        });
      }
    }
    return arr;
  }

  function startGame() {
    level = 1;
    score = 0;
    lives = 3;
    updateUI();
    resetRound();
    document.getElementById("overlay").style.display = "none";
    running = true;
    cancelAnimationFrame(animId);
    animId = requestAnimationFrame(loop);
  }

  function resetRound() {
    paddle = { x: W / 2 - PADDLE_W / 2, y: H - 30 };
    ball = { x: W / 2, y: H - 50, vx: (2 + level * 0.5) * (Math.random() > 0.5 ? 1 : -1), vy: -(3 + level * 0.5) };
    bricks = createBricks(level);
  }

  function updateUI() {
    document.getElementById("score").textContent = score;
    document.getElementById("level").textContent = level;
    const livesEl = document.getElementById("lives");
    livesEl.innerHTML = Array.from({ length: lives }, () => '<span class="life">❤️</span>').join("") || "💀";
  }

  function loop() {
    if (!running) return;
    update();
    draw();
    animId = requestAnimationFrame(loop);
  }

  function update() {
    ball.x += ball.vx;
    ball.y += ball.vy;
    if (ball.x - BALL_R < 0) {
      ball.x = BALL_R;
      ball.vx *= -1;
    }
    if (ball.x + BALL_R > W) {
      ball.x = W - BALL_R;
      ball.vx *= -1;
    }
    if (ball.y - BALL_R < 0) {
      ball.y = BALL_R;
      ball.vy *= -1;
    }
    if (ball.y + BALL_R > H) {
      lives--;
      if (lives <= 0) {
        showEnd("Game Over!");
        return;
      }
      updateUI();
      resetRound();
      return;
    }
    if (
      ball.y + BALL_R > paddle.y &&
      ball.y - BALL_R < paddle.y + PADDLE_H &&
      ball.x > paddle.x &&
      ball.x < paddle.x + PADDLE_W
    ) {
      ball.vy = -Math.abs(ball.vy);
      const rel = (ball.x - (paddle.x + PADDLE_W / 2)) / (PADDLE_W / 2);
      ball.vx = rel * 5;
    }
    for (const b of bricks) {
      if (!b.alive) continue;
      if (
        ball.x + BALL_R > b.x &&
        ball.x - BALL_R < b.x + b.w &&
        ball.y + BALL_R > b.y &&
        ball.y - BALL_R < b.y + b.h
      ) {
        b.hits--;
        if (b.hits <= 0) {
          b.alive = false;
          score += 10;
        }
        ball.vy *= -1;
        updateUI();
        break;
      }
    }
    if (bricks.every((b) => !b.alive)) {
      level++;
      if (level > 5) {
        showEnd("You Win! 🎉");
        return;
      }
      updateUI();
      resetRound();
    }
  }

  function draw() {
    ctx.fillStyle = "#0f172a";
    ctx.fillRect(0, 0, W, H);
    for (const b of bricks) {
      if (!b.alive) continue;
      ctx.fillStyle = b.hits > 1 ? b.color : b.color + "99";
      ctx.beginPath();
      ctx.roundRect(b.x, b.y, b.w, b.h, 3);
      ctx.fill();
    }
    ctx.fillStyle = "#7c3aed";
    ctx.beginPath();
    ctx.roundRect(paddle.x, paddle.y, PADDLE_W, PADDLE_H, 5);
    ctx.fill();
    ctx.fillStyle = "#f8fafc";
    ctx.beginPath();
    ctx.arc(ball.x, ball.y, BALL_R, 0, Math.PI * 2);
    ctx.fill();
  }

  function showEnd(msg) {
    running = false;
    cancelAnimationFrame(animId);
    draw();
    const overlay = document.getElementById("overlay");
    overlay.querySelector("h2").textContent = msg;
    overlay.querySelector("p").textContent = `Score: ${score}`;
    overlay.querySelector("button").textContent = "Play Again";
    overlay.style.display = "flex";
  }

  canvas.addEventListener("mousemove", (e) => {
    const rect = canvas.getBoundingClientRect();
    paddle.x = Math.max(0, Math.min(W - PADDLE_W, e.clientX - rect.left - PADDLE_W / 2));
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft") paddle.x = Math.max(0, paddle.x - 15);
    if (e.key === "ArrowRight") paddle.x = Math.min(W - PADDLE_W, paddle.x + 15);
  });

  ctx.fillStyle = "#0f172a";
  ctx.fillRect(0, 0, W, H);
</script>
