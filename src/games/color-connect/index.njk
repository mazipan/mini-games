          ],
          green: [
            [0, 2],
            [4, 4],
          ],
          yellow: [
            [2, 0],
            [4, 6],
          ],
          orange: [
            [2, 6],
            [6, 2],
          ],
          purple: [
            [4, 0],
            [6, 4],
          ],
        },
      },
    ],
    hard: [
      {
        size: 9,
        dots: {
          red: [
            [0, 0],
            [8, 8],
          ],
          blue: [
            [0, 8],
            [8, 0],
          ],
          green: [
            [0, 4],
            [8, 4],
          ],
          yellow: [
            [4, 0],
            [4, 8],
          ],
          orange: [
            [1, 1],
            [7, 7],
          ],
          purple: [
            [1, 7],
            [7, 1],
          ],
          pink: [
            [2, 4],
            [6, 4],
          ],
          cyan: [
            [4, 2],
            [4, 6],
          ],
        },
      },
      {
        size: 9,
        dots: {
          red: [
            [0, 0],
            [4, 4],
          ],
          blue: [
            [0, 8],
            [4, 4],
          ],
          green: [
            [8, 0],
            [4, 4],
          ],
          yellow: [
            [8, 8],
            [4, 4],
          ],
          orange: [
            [0, 4],
            [8, 4],
          ],
          purple: [
            [4, 0],
            [4, 8],
          ],
          pink: [
            [2, 2],
            [6, 6],
          ],
          cyan: [
            [2, 6],
            [6, 2],
          ],
        },
      },
      {
        size: 9,
        dots: {
          red: [
            [0, 0],
            [0, 8],
          ],
          blue: [
            [8, 0],
            [8, 8],
          ],
          green: [
            [0, 2],
            [6, 6],
          ],
          yellow: [
            [0, 6],
            [6, 2],
          ],
          orange: [
            [2, 0],
            [6, 8],
          ],
          purple: [
            [2, 8],
            [8, 2],
          ],
          pink: [
            [4, 0],
            [4, 8],
          ],
          cyan: [
            [8, 4],
            [4, 4],
          ],
        },
      },
    ],
  };

  const STORAGE_KEYS = {
    easy: "mini-color-connect-best-easy",
    medium: "mini-color-connect-best-medium",
    hard: "mini-color-connect-best-hard",
  };

  let difficulty = "medium";
  let currentLevel = null;
  let size = 7;
  let paths = {};
  let grid = [];
  let activeColor = null;
  let moves = 0;
  let gameWon = false;
  let levelIdx = { easy: 0, medium: 0, hard: 0 };

  let bests = {
    easy: parseInt(localStorage.getItem(STORAGE_KEYS.easy) || "0", 10) || null,
    medium: parseInt(localStorage.getItem(STORAGE_KEYS.medium) || "0", 10) || null,
    hard: parseInt(localStorage.getItem(STORAGE_KEYS.hard) || "0", 10) || null,
  };

  function getBestDisplay(diff) {
    return bests[diff] !== null ? String(bests[diff]) : "—";
  }

  function getCellSize() {
    const maxBoard = Math.min(window.innerWidth - 32, 480);
    return Math.floor((maxBoard - 8) / size);
  }

  function initGrid() {
    grid = Array.from({ length: size }, () => Array.from({ length: size }, () => ({ color: null, isEndpoint: false })));
    paths = {};
    for (const [color, [a, b]] of Object.entries(currentLevel.dots)) {
      paths[color] = [];
      grid[a[0]][a[1]].color = color;
      grid[a[0]][a[1]].isEndpoint = true;
      grid[b[0]][b[1]].color = color;
      grid[b[0]][b[1]].isEndpoint = true;
    }
  }

  function isAdjacent([r1, c1], [r2, c2]) {
    return (r1 === r2 && Math.abs(c1 - c2) === 1) || (c1 === c2 && Math.abs(r1 - r2) === 1);
  }

  function clearPath(color) {
    for (const [r, c] of paths[color]) {
      if (!grid[r][c].isEndpoint) {
        grid[r][c].color = null;
      }
    }
    paths[color] = [];
  }

  function clearPathFromCell(color, row, col) {
    const path = paths[color];
    const idx = path.findIndex(([r, c]) => r === row && c === col);
    if (idx === -1) return;
    const removed = path.splice(idx);
    for (const [r, c] of removed) {
      if (!grid[r][c].isEndpoint) {
        grid[r][c].color = null;
      }
    }
  }

  function truncatePathAt(color, row, col) {
    const path = paths[color];
    const idx = path.findIndex(([r, c]) => r === row && c === col);
    if (idx === -1) return;
    const removed = path.splice(idx + 1);
    for (const [r, c] of removed) {
      if (!grid[r][c].isEndpoint) {
        grid[r][c].color = null;
      }
    }
  }

  function startDraw(row, col) {
    if (gameWon) return;
    const cell = grid[row][col];
    if (cell.isEndpoint && cell.color) {
      activeColor = cell.color;
      clearPath(activeColor);
      paths[activeColor] = [[row, col]];
      grid[row][col].color = activeColor;
    } else if (cell.color) {
      activeColor = cell.color;
      truncatePathAt(activeColor, row, col);
    }
  }

  function extendDraw(row, col) {
    if (!activeColor || gameWon) return;
    const path = paths[activeColor];
    if (!path.length) return;
    const head = path[path.length - 1];
    if (head[0] === row && head[1] === col) return;

    const prevIdx = path.findIndex(([r, c]) => r === row && c === col);
    if (prevIdx !== -1) {
      const removed = path.splice(prevIdx + 1);
      for (const [r, c] of removed) {
        if (!grid[r][c].isEndpoint) grid[r][c].color = null;
      }
      renderGrid();
      return;
    }

    if (!isAdjacent(head, [row, col])) return;

    const cell = grid[row][col];
    if (cell.isEndpoint && cell.color !== activeColor) return;

    if (cell.color && cell.color !== activeColor) {
      clearPathFromCell(cell.color, row, col);
    }

    path.push([row, col]);
    grid[row][col].color = activeColor;
    moves++;
    document.getElementById("moves-display").textContent = moves;
    updateFilledDisplay();
    renderGrid();

    if (isSolved()) handleWin();
  }

  function stopDraw() {
    activeColor = null;
  }

  function filledCount() {
    let count = 0;
    for (let r = 0; r < size; r++) for (let c = 0; c < size; c++) if (grid[r][c].color) count++;
    return count;
  }

  function updateFilledDisplay() {
    const pct = Math.round((filledCount() / (size * size)) * 100);
    document.getElementById("filled-display").textContent = pct + "%";
  }

  function isSolved() {
    const dots = currentLevel.dots;
    const allConnected = Object.entries(dots).every(([color, [a, b]]) => {
      const path = paths[color];
      if (path.length < 2) return false;
      const head = path[path.length - 1];
      return head[0] === b[0] && head[1] === b[1];
    });
    return allConnected && filledCount() === size * size;
  }

  function handleWin() {
    gameWon = true;
    const isNewBest = bests[difficulty] === null || moves < bests[difficulty];
    if (isNewBest) {
      bests[difficulty] = moves;
      localStorage.setItem(STORAGE_KEYS[difficulty], moves);
      document.getElementById("best-display").textContent = String(moves);
      launchConfetti();
    }
    document.getElementById("go-moves").textContent = moves;
    document.getElementById("go-best").textContent = getBestDisplay(difficulty);
    document.getElementById("go-diff").textContent = difficulty.charAt(0).toUpperCase() + difficulty.slice(1);
    document.getElementById("win-overlay").style.display = "flex";
  }

  function getConnections(row, col) {
    const path = paths[grid[row][col].color];
    if (!path) return { up: false, down: false, left: false, right: false };
    const idx = path.findIndex(([r, c]) => r === row && c === col);
    if (idx === -1) return { up: false, down: false, left: false, right: false };
    const prev = idx > 0 ? path[idx - 1] : null;
    const next = idx < path.length - 1 ? path[idx + 1] : null;
    const connects = (neighbor) => {
      if (!neighbor) return false;
      const dr = neighbor[0] - row;
      const dc = neighbor[1] - col;
      return { up: dr === -1, down: dr === 1, left: dc === -1, right: dc === 1 };
    };
    const p = connects(prev);
    const n = connects(next);
    return {
      up: (p && p.up) || (n && n.up),
      down: (p && p.down) || (n && n.down),
      left: (p && p.left) || (n && n.left),
      right: (p && p.right) || (n && n.right),
    };
  }

  function renderGrid() {
    const gridEl = document.getElementById("grid");
    const cs = getCellSize();
    gridEl.style.gridTemplateColumns = `repeat(${size}, ${cs}px)`;
    const cells = gridEl.querySelectorAll(".gc");
    for (let r = 0; r < size; r++) {
      for (let c = 0; c < size; c++) {
        const idx = r * size + c;
        const cell = cells[idx];
        const g = grid[r][c];
        const hex = g.color ? COLOR_HEX[g.color] : null;

        cell.style.background = hex ? hex + "33" : "#1e293b";
        cell.innerHTML = "";

        if (hex) {
          cell.classList.add("filled");
          const conn = getConnections(r, c);
          const center = document.createElement("div");
          center.className = "center-fill";
          center.style.background = hex;
          cell.appendChild(center);

          if (conn.right) {
            const el = document.createElement("div");
            el.className = "conn-right";
            el.style.background = hex;
            cell.appendChild(el);
          }
          if (conn.left) {
            const el = document.createElement("div");
            el.className = "conn-left";
            el.style.background = hex;
            cell.appendChild(el);
          }
          if (conn.down) {
            const el = document.createElement("div");
            el.className = "conn-down";
            el.style.background = hex;
            cell.appendChild(el);
          }
          if (conn.up) {
            const el = document.createElement("div");
            el.className = "conn-up";
            el.style.background = hex;
            cell.appendChild(el);
          }

          if (g.isEndpoint) {
            const dot = document.createElement("div");
            dot.className = "dot";
            dot.style.background = hex;
            dot.style.border = "3px solid white";
            dot.style.boxShadow = `0 0 0 2px ${hex}`;
            cell.appendChild(dot);
          }
        } else {
          cell.classList.remove("filled");
        }
      }
    }
  }

  function buildGrid() {
    const gridEl = document.getElementById("grid");
    const cs = getCellSize();
    gridEl.style.gridTemplateColumns = `repeat(${size}, ${cs}px)`;
    gridEl.innerHTML = "";
    for (let r = 0; r < size; r++) {
      for (let c = 0; c < size; c++) {
        const cell = document.createElement("div");
        cell.className = "gc";
        cell.style.width = cs + "px";
        cell.style.height = cs + "px";
        gridEl.appendChild(cell);
      }
    }
    renderGrid();
  }

  function cellFromPoint(x, y) {
    const gridEl = document.getElementById("grid");
    const rect = gridEl.getBoundingClientRect();
    const cs = getCellSize();
    const col = Math.floor((x - rect.left) / (cs + 2));
    const row = Math.floor((y - rect.top) / (cs + 2));
    if (row < 0 || row >= size || col < 0 || col >= size) return null;
    return { row, col };
  }

  const gridEl = document.getElementById("grid");

  gridEl.addEventListener("mousedown", (e) => {
    const pos = cellFromPoint(e.clientX, e.clientY);
    if (pos) startDraw(pos.row, pos.col);
    renderGrid();
  });

  gridEl.addEventListener("mousemove", (e) => {
    if (!activeColor) return;
    const pos = cellFromPoint(e.clientX, e.clientY);
    if (pos) extendDraw(pos.row, pos.col);
  });

  window.addEventListener("mouseup", () => stopDraw());

  gridEl.addEventListener(
    "touchstart",
    (e) => {
      e.preventDefault();
      const t = e.touches[0];
      const pos = cellFromPoint(t.clientX, t.clientY);
      if (pos) startDraw(pos.row, pos.col);
      renderGrid();
    },
    { passive: false }
  );

  gridEl.addEventListener(
    "touchmove",
    (e) => {
      e.preventDefault();
      if (!activeColor) return;
      const t = e.touches[0];
      const pos = cellFromPoint(t.clientX, t.clientY);
      if (pos) extendDraw(pos.row, pos.col);
    },
    { passive: false }
  );

  gridEl.addEventListener("touchend", () => stopDraw());

  function newGame() {
    gameWon = false;
    moves = 0;
    activeColor = null;
    document.getElementById("moves-display").textContent = "0";
    document.getElementById("filled-display").textContent = "0%";
    document.getElementById("win-overlay").style.display = "none";
    const levels = LEVELS[difficulty];
    currentLevel = levels[levelIdx[difficulty] % levels.length];
    levelIdx[difficulty] = (levelIdx[difficulty] + 1) % levels.length;
    size = currentLevel.size;
    initGrid();
    document.getElementById("best-display").textContent = getBestDisplay(difficulty);
    buildGrid();
  }

  function setDifficulty(diff) {
    difficulty = diff;
    ["easy", "medium", "hard"].forEach((d) => {
      document.getElementById("btn-" + d).classList.toggle("active", d === diff);
    });
    newGame();
  }

  newGame();
</script>
