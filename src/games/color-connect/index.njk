---
layout: layouts/game.njk
title: Color Connect
description: Connect matching colored dots by drawing paths — fill every cell without crossing lines.
category: puzzle
icon: "🔗"
---

{% from "macros/game-components.njk" import statCard, summaryStatCard, infoDetails %}

<style>
  #game-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: calc(100vh - 60px);
    gap: 1rem;
    padding: 1rem;
  }
  .score-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.6rem 1.2rem;
  }
  .stat-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .stat-value {
    font-size: 1.4rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  .diff-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .diff-btn {
    padding: 0.4rem 1rem;
    background: #1e293b;
    color: #94a3b8;
    border: 1px solid #334155;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition:
      background 0.15s,
      color 0.15s,
      border-color 0.15s;
  }
  .diff-btn.active {
    background: #4c1d95;
    color: #e9d5ff;
    border-color: #7c3aed;
  }
  .diff-btn:hover:not(.active) {
    background: #273449;
    border-color: #7c3aed;
  }
  .board-wrapper {
    position: relative;
    touch-action: none;
  }
  #grid {
    display: grid;
    gap: 2px;
    background: #0f172a;
    border: 2px solid #334155;
    border-radius: 6px;
    padding: 2px;
    user-select: none;
    touch-action: none;
  }
  .gc {
    border-radius: 4px;
    position: relative;
    background: #1e293b;
    transition: background 0.05s;
  }
  .gc.filled {
    opacity: 0.9;
  }
  .gc .dot {
    position: absolute;
    inset: 15%;
    border-radius: 50%;
    z-index: 2;
  }
  .gc .conn-right {
    position: absolute;
    top: 30%;
    right: -2px;
    width: calc(50% + 2px);
    height: 40%;
    z-index: 1;
  }
  .gc .conn-left {
    position: absolute;
    top: 30%;
    left: -2px;
    width: calc(50% + 2px);
    height: 40%;
    z-index: 1;
  }
  .gc .conn-down {
    position: absolute;
    left: 30%;
    bottom: -2px;
    width: 40%;
    height: calc(50% + 2px);
    z-index: 1;
  }
  .gc .conn-up {
    position: absolute;
    left: 30%;
    top: -2px;
    width: 40%;
    height: calc(50% + 2px);
    z-index: 1;
  }
  .gc .center-fill {
    position: absolute;
    inset: 30%;
    border-radius: 2px;
    z-index: 1;
  }
  #win-overlay {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.95);
    border-radius: 6px;
    gap: 0.75rem;
  }
  #win-overlay h2 {
    font-size: 1.6rem;
    font-weight: bold;
    color: white;
  }
  .summary-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .summary-stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.5rem 0.9rem;
    min-width: 72px;
  }
  .summary-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .summary-value {
    font-size: 1.2rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  .play-btn {
    padding: 0.5rem 1.5rem;
    background: #7c3aed;
    color: white;
    font-size: 1rem;
    font-weight: 600;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .play-btn:hover {
    background: #6d28d9;
  }
  .action-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .hint-btn {
    padding: 0.5rem 1.25rem;
    background: #0e7490;
    color: white;
    font-size: 0.95rem;
    font-weight: 600;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .hint-btn:hover {
    background: #0c6079;
  }
  .hint-btn:disabled {
    background: #1e293b;
    color: #475569;
    cursor: default;
  }
  .new-game-btn {
    padding: 0.5rem 1.25rem;
    background: #1e293b;
    color: #94a3b8;
    font-size: 0.95rem;
    font-weight: 600;
    border: 1px solid #334155;
    border-radius: 6px;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .new-game-btn:hover {
    background: #273449;
    border-color: #7c3aed;
    color: #e2e8f0;
  }
  .info-section {
    width: 100%;
    max-width: 480px;
    padding: 0 1rem 2rem;
    margin: 0 auto;
  }
  .info-details {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    margin-bottom: 0.75rem;
    overflow: hidden;
  }
  .info-details summary {
    padding: 0.75rem 1rem;
    font-weight: 600;
    color: #e2e8f0;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
  }
  .info-details summary::-webkit-details-marker {
    display: none;
  }
