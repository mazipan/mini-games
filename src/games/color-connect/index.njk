---
layout: layouts/game.njk
title: Color Connect
description: Connect matching colored dots by drawing paths — fill every cell without crossing lines.
category: puzzle
icon: "🔗"
---

{% from "macros/game-components.njk" import statCard, summaryStatCard, infoDetails %}

<style>
  #game-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: calc(100vh - 60px);
    gap: 1rem;
    padding: 1rem;
  }
  .score-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.6rem 1.2rem;
  }
  .stat-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .stat-value {
    font-size: 1.4rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  .diff-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .diff-btn {
    padding: 0.4rem 1rem;
    background: #1e293b;
    color: #94a3b8;
    border: 1px solid #334155;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition:
      background 0.15s,
      color 0.15s,
      border-color 0.15s;
  }
  .diff-btn.active {
    background: #4c1d95;
    color: #e9d5ff;
    border-color: #7c3aed;
  }
  .diff-btn:hover:not(.active) {
    background: #273449;
    border-color: #7c3aed;
  }
  .board-wrapper {
    position: relative;
    touch-action: none;
  }
  #grid {
    display: grid;
    gap: 2px;
    background: #0f172a;
    border: 2px solid #334155;
    border-radius: 6px;
    padding: 2px;
    user-select: none;
  }
  .gc {
    border-radius: 4px;
    position: relative;
    background: #1e293b;
    transition: background 0.05s;
  }
  .gc.filled {
    opacity: 0.9;
  }
  .gc .dot {
    position: absolute;
    inset: 15%;
    border-radius: 50%;
    z-index: 2;
  }
  .gc .conn-right {
    position: absolute;
    top: 30%;
    right: -2px;
    width: calc(50% + 2px);
    height: 40%;
    z-index: 1;
  }
  .gc .conn-left {
    position: absolute;
    top: 30%;
    left: -2px;
    width: calc(50% + 2px);
    height: 40%;
    z-index: 1;
  }
  .gc .conn-down {
    position: absolute;
    left: 30%;
    bottom: -2px;
    width: 40%;
    height: calc(50% + 2px);
    z-index: 1;
  }
  .gc .conn-up {
    position: absolute;
    left: 30%;
    top: -2px;
    width: 40%;
    height: calc(50% + 2px);
    z-index: 1;
  }
  .gc .center-fill {
    position: absolute;
    inset: 30%;
    border-radius: 2px;
    z-index: 1;
  }
  #win-overlay {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.95);
    border-radius: 6px;
    gap: 0.75rem;
  }
  #win-overlay h2 {
    font-size: 1.6rem;
    font-weight: bold;
    color: white;
  }
  .summary-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .summary-stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.5rem 0.9rem;
    min-width: 72px;
  }
  .summary-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .summary-value {
    font-size: 1.2rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  .play-btn {
    padding: 0.5rem 1.5rem;
    background: #7c3aed;
    color: white;
    font-size: 1rem;
    font-weight: 600;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .play-btn:hover {
    background: #6d28d9;
  }
  .info-section {
    width: 100%;
    max-width: 480px;
    padding: 0 1rem 2rem;
    margin: 0 auto;
  }
  .info-details {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    margin-bottom: 0.75rem;
    overflow: hidden;
  }
  .info-details summary {
    padding: 0.75rem 1rem;
    font-weight: 600;
    color: #e2e8f0;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
  }
  .info-details summary::-webkit-details-marker {
    display: none;
  }
  .info-details summary::after {
    content: "+";
    font-size: 1.1rem;
    color: #64748b;
  }
  .info-details[open] summary::after {
    content: "−";
  }
  .info-body {
    padding: 0.75rem 1rem 1rem;
    color: #94a3b8;
    font-size: 0.875rem;
    line-height: 1.6;
    border-top: 1px solid #334155;
  }
  .info-body h4 {
    color: #e2e8f0;
    font-weight: 600;
    margin: 0.75rem 0 0.25rem;
    font-size: 0.875rem;
  }
  .info-body h4:first-child {
    margin-top: 0;
  }
  .info-body ul {
    padding-left: 1.25rem;
    margin: 0.25rem 0;
  }
  .info-body li {
    margin-bottom: 0.25rem;
  }
  .info-body p {
    margin: 0.25rem 0;
  }
</style>

<div id="game-wrapper">
  <div class="score-row">
    {{ statCard("Moves", "moves-display") }} {{ statCard("Filled", "filled-display", "0%") }} {{ statCard("Best",
    "best-display", "—") }}
  </div>
  <div class="diff-row">
    <button class="diff-btn" id="btn-easy" onclick="setDifficulty('easy')">Easy (5×5)</button>
    <button class="diff-btn active" id="btn-medium" onclick="setDifficulty('medium')">Medium (7×7)</button>
    <button class="diff-btn" id="btn-hard" onclick="setDifficulty('hard')">Hard (9×9)</button>
  </div>
  <div class="board-wrapper" id="board-wrapper">
    <div id="grid"></div>
    <div id="win-overlay">
      <span style="font-size: 2.5rem">🏆</span>
      <h2>You Win!</h2>
      <div class="summary-row">
        {{ summaryStatCard("Moves", "go-moves") }} {{ summaryStatCard("Best", "go-best") }} {{
        summaryStatCard("Difficulty", "go-diff", "Medium") }}
      </div>
      <button class="play-btn" onclick="newGame()">New Game</button>
    </div>
  </div>
</div>

<div class="info-section">
  {% call infoDetails("How to Play") %}
  <h4>Goal</h4>
  <p>
    Connect each pair of matching colored dots with a continuous path. Fill <strong>every cell</strong> in the grid — no
    empty cells allowed!
  </p>
  <h4>Controls</h4>
  <ul>
    <li><strong>Click/tap and drag</strong> from any dot or existing path cell to draw</li>
    <li>Drag back over your own path to shorten it</li>
    <li>Drawing over another color erases that color's path from that point onward</li>
    <li>Only horizontal and vertical moves — no diagonals</li>
  </ul>
  <h4>Winning</h4>
  <ul>
    <li>All color pairs must be connected</li>
    <li>Every cell in the grid must be covered</li>
    <li>No paths may overlap or cross</li>
  </ul>
  <h4>Difficulty</h4>
  <ul>
    <li><strong>Easy (5×5)</strong> — 4 color pairs</li>
    <li><strong>Medium (7×7)</strong> — 6 color pairs</li>
    <li><strong>Hard (9×9)</strong> — 8 color pairs</li>
  </ul>
  {% endcall %} {% call infoDetails("FAQ") %}
  <h4>Is every puzzle solvable?</h4>
  <p>Yes — all levels are hand-crafted and verified to have a valid solution that fills the entire grid.</p>
  <h4>Is my best score saved?</h4>
  <p>Yes — your best move count is saved per difficulty in your browser's local storage.</p>
  <h4>What happens if I draw over another color?</h4>
  <p>That color's path is erased from the point you drew over. You can then connect it again differently.</p>
  <h4>Why can't I draw diagonally?</h4>
  <p>Paths only travel horizontally or vertically — this is the core rule of Color Connect puzzles.</p>
  {% endcall %}
</div>

<script>
  function launchConfetti() {
    const canvas = document.createElement("canvas");
    canvas.style.cssText = "position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999";
    document.body.appendChild(canvas);
    const ctx = canvas.getContext("2d");
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    const colors = ["#7c3aed", "#db2777", "#f59e0b", "#10b981", "#3b82f6", "#ef4444", "#fbbf24"];
    const pieces = Array.from({ length: 80 }, () => ({
      x: Math.random() * canvas.width,
      y: -10 - Math.random() * 40,
      r: Math.random() * 6 + 3,
      color: colors[Math.floor(Math.random() * colors.length)],
      vx: (Math.random() - 0.5) * 5,
      vy: Math.random() * 4 + 2,
      angle: Math.random() * Math.PI * 2,
      va: (Math.random() - 0.5) * 0.15,
    }));
    const start = performance.now();
    function draw(now) {
      if (now - start > 3000) {
        canvas.remove();
        return;
      }
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      pieces.forEach((p) => {
        p.x += p.vx;
        p.y += p.vy;
        p.angle += p.va;
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.angle);
        ctx.fillStyle = p.color;
        ctx.fillRect(-p.r, -p.r / 2, p.r * 2, p.r);
        ctx.restore();
      });
      requestAnimationFrame(draw);
    }
    requestAnimationFrame(draw);
  }

  const COLOR_HEX = {
    red: "#ef4444",
    blue: "#3b82f6",
    green: "#22c55e",
    yellow: "#eab308",
    orange: "#f97316",
    purple: "#a855f7",
    pink: "#ec4899",
    cyan: "#06b6d4",
    maroon: "#be123c",
  };

  const LEVELS = {
    easy: [
      {
        size: 5,
        dots: {
          red: [
            [0, 0],
            [4, 4],
          ],
          blue: [
            [0, 4],
            [4, 0],
          ],
          green: [
            [0, 2],
            [2, 4],
          ],
          yellow: [
            [2, 0],
            [4, 2],
          ],
        },
      },
      {
        size: 5,
        dots: {
          red: [
            [0, 0],
