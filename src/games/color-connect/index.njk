          ],
          blue: [
            [0, 3],
            [4, 1],
          ],
          green: [
            [2, 0],
            [2, 4],
          ],
          yellow: [
            [0, 0],
            [4, 0],
          ],
        },
      },
    ],
    medium: [
      {
        size: 7,
        dots: {
          red: [
            [0, 0],
            [6, 6],
          ],
          blue: [
            [0, 6],
            [6, 0],
          ],
          green: [
            [0, 3],
            [6, 3],
          ],
          yellow: [
            [3, 0],
            [3, 6],
          ],
          orange: [
            [1, 1],
            [5, 5],
          ],
          purple: [
            [1, 5],
            [5, 1],
          ],
        },
      },
      {
        size: 7,
        dots: {
          red: [
            [0, 0],
            [3, 3],
          ],
          blue: [
            [0, 6],
            [3, 3],
          ],
          green: [
            [6, 0],
            [3, 3],
          ],
          yellow: [
            [6, 6],
            [3, 3],
          ],
          orange: [
            [0, 3],
