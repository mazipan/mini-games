---
layout: layouts/game.njk
title: Match Three
description: Swap adjacent tiles to line up 3 or more of the same color and chain reactions for big scores!
category: puzzle
icon: "🍬"
---

{% from "macros/game-components.njk" import statCard, summaryStatCard, infoDetails %}

<style>
  :root {
    --cell: min(52px, calc((100vw - 3rem) / 8.4));
  }
  #game-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: calc(100vh - 60px);
    gap: 1rem;
    padding: 1rem;
  }
  .score-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    min-width: 64px;
  }
  .stat-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .stat-value {
    font-size: 1.2rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  #tools-row {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    align-items: center;
  }
  .tool-btn {
    background: #1e293b;
    border: 2px solid #334155;
    border-radius: 8px;
    padding: 0.4rem 1.1rem;
    color: #e2e8f0;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition:
      border-color 0.15s,
      background 0.15s,
      transform 0.1s;
  }
  .tool-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .bomb-btn:hover:not(:disabled) {
    border-color: #ef4444;
    background: #2d1b1b;
  }
  .bomb-btn.active {
    border-color: #ef4444;
    background: #2d1b1b;
    animation: pulse-bomb 0.7s ease-in-out infinite;
  }
  @keyframes pulse-bomb {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.06);
    }
  }
  .hint-btn:hover:not(:disabled) {
    border-color: #f59e0b;
    background: #1c1a0a;
  }
  .tile.hint-highlight {
    box-shadow: 0 0 0 3px rgba(251, 191, 36, 0.9);
    animation: hint-pulse 0.55s ease-in-out infinite;
    z-index: 3;
  }
  @keyframes hint-pulse {
    0%,
    100% {
      filter: brightness(1);
    }
    50% {
      filter: brightness(1.45);
    }
  }
  #board-container {
    position: relative;
  }
  #board {
    display: grid;
    grid-template-columns: repeat(8, var(--cell));
    grid-template-rows: repeat(8, var(--cell));
    gap: 3px;
    padding: 6px;
    background: #0f172a;
    border-radius: 10px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
    user-select: none;
  }
  .tile {
    width: var(--cell);
    height: var(--cell);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: calc(var(--cell) * 0.5);
    cursor: pointer;
    transition:
      transform 0.1s,
      opacity 0.15s;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    box-sizing: border-box;
    border: 2px solid transparent;
    position: relative;
  }
  .tile:hover {
    transform: scale(1.08);
    z-index: 1;
  }
  .tile.selected {
    border-color: #fff;
    transform: scale(1.12);
    z-index: 2;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.4);
  }
  .tile.removing {
    transform: scale(0);
    opacity: 0;
  }
  .tile-empty {
    width: var(--cell);
    height: var(--cell);
    border-radius: 8px;
    box-sizing: border-box;
    background: rgba(15, 23, 42, 0.3);
    border: 1px dashed #1e293b;
  }
  .tile.bomb-preview {
    outline: 2px solid rgba(239, 68, 68, 0.85);
    outline-offset: -2px;
    filter: brightness(1.3);
  }
  .tile.blasting {
    animation: blast 0.22s ease-out forwards;
  }
  @keyframes blast {
    0% {
      transform: scale(1);
      opacity: 1;
    }
    40% {
      transform: scale(1.35);
      opacity: 0.9;
    }
    100% {
      transform: scale(0);
      opacity: 0;
    }
  }
  .tile[data-color="0"] {
    background: #ef4444;
  }
  .tile[data-color="1"] {
    background: #3b82f6;
  }
  .tile[data-color="2"] {
    background: #22c55e;
  }
  .tile[data-color="3"] {
    background: #f59e0b;
  }
  .tile[data-color="4"] {
    background: #a855f7;
  }
  .tile[data-color="5"] {
    background: #f97316;
  }

  #overlay {
    position: fixed;
    inset: 0;
    border-radius: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    text-align: center;
    padding: 1.5rem;
    z-index: 100;
    background: rgba(15, 23, 42, 0.97);
  }
  #gameover-overlay {
    position: absolute;
    inset: 0;
    border-radius: 10px;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    text-align: center;
    padding: 1.5rem;
    z-index: 10;
    background: rgba(15, 23, 42, 0.96);
  }
  #overlay h2,
  #gameover-overlay h2 {
    font-size: 1.4rem;
    font-weight: 700;
    color: #e2e8f0;
    margin: 0;
  }
  #overlay p,
  #gameover-overlay p {
    color: #94a3b8;
    font-size: 0.85rem;
    margin: 0;
  }
  .overlay-icon {
    font-size: 2rem;
  }
  .summary-row {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .summary-stat {
    text-align: center;
    background: #1e293b;
    border-radius: 8px;
    padding: 0.4rem 0.8rem;
    min-width: 56px;
  }
  .summary-label {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .summary-value {
    font-size: 1.1rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  .play-btn {
    padding: 0.5rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    background: #7c3aed;
    color: #fff;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .play-btn:hover {
    background: #6d28d9;
  }
  .info-section {
    width: 100%;
    max-width: calc(8 * var(--cell) + 12px + 1rem);
  }
  .info-details {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    margin-bottom: 0.5rem;
    overflow: hidden;
  }
  .info-details summary {
    padding: 0.75rem 1rem;
    cursor: pointer;
    font-weight: 600;
    color: #e2e8f0;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .info-details summary::after {
    content: "▼";
    font-size: 0.7rem;
    color: #94a3b8;
    transition: transform 0.2s;
  }
  .info-details[open] summary::after {
    transform: rotate(180deg);
  }
  .info-body {
    padding: 0 1rem 1rem;
    color: #94a3b8;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .info-body h4 {
    color: #e2e8f0;
    margin: 0.75rem 0 0.25rem;
    font-size: 0.9rem;
  }
  .info-body p,
  .info-body ul {
    margin: 0 0 0.5rem;
  }
  .info-body ul {
    padding-left: 1.25rem;
  }
</style>

<div id="game-wrapper">
  <div class="score-row">
    {{ statCard("Score", "score-display", "0") }} {{ statCard("Best", "best-display", "0") }} {{ statCard("Level",
    "level-display", "1") }} {{ statCard("Moves", "moves-display", "20") }}
  </div>

  <div id="board-container">
    <div id="board"></div>

    <div id="overlay">
      <span class="overlay-icon">🍬</span>
      <h2>Match Three</h2>
      <p>Swap tiles to match 3+ in a row or column.<br />Reach the target score, then clear the board!</p>
      <button class="play-btn" onclick="startGame()">Play Game</button>
    </div>

    <div id="gameover-overlay">
      <span class="overlay-icon" id="go-icon">💀</span>
      <h2 id="go-title">Game Over</h2>
      <div class="summary-row">
        {{ summaryStatCard("Score", "go-score") }} {{ summaryStatCard("Best", "go-best") }} {{ summaryStatCard("Level",
        "go-level", "1") }}
      </div>
      <button class="play-btn" onclick="startGame()">New Game</button>
    </div>
  </div>

  <div id="tools-row">
    <button class="tool-btn bomb-btn" id="bomb-btn" onclick="toggleBombMode()" title="Bomb: blasts a 5×5 area">
      💣 Bomb ×<span id="bomb-count">3</span>
    </button>
    <button class="tool-btn hint-btn" id="hint-btn" onclick="useHint()" title="Hint: shows a valid swap">
      💡 Hint ×<span id="hint-count">3</span>
    </button>
  </div>

  <div class="info-section">
    {% call infoDetails("How to Play") %}
    <h4>Goal</h4>
    <p>
      Match tiles to score points. Once you've scored enough, new tiles stop dropping — clear the remaining tiles to
      advance to the next level.
    </p>
    <h4>Controls — Desktop</h4>
    <ul>
      <li>Click a tile to select it (glows white), then click an adjacent tile to swap</li>
      <li>Clicking a non-adjacent tile re-selects it as your new choice</li>
      <li>Only swaps that create a match are allowed</li>
    </ul>
    <h4>Controls — Mobile</h4>
    <ul>
      <li>Tap to select, tap adjacent to swap — or swipe directly from one tile to a neighbor</li>
    </ul>
    <h4>Bomb</h4>
    <p>Press 💣 Bomb, then click any tile to blast a 5×5 area. You start with 3 and earn +1 per level (max 3).</p>
    <h4>Hint</h4>
    <p>
      Press 💡 Hint to see a valid swap highlighted in gold — the tiles slowly animate to show the move. You start with
      3 hints and earn +1 per level (max 3).
    </p>
    <h4>Scoring</h4>
    <ul>
      <li>3 tiles → 30 pts · 4 tiles → 60 pts · 5+ tiles → 150 pts</li>
      <li>Each cascade step doubles the multiplier</li>
    </ul>
    <h4>Level Progression</h4>
    <p>Each level is harder and gives you fewer moves (min 12). Clear the board to advance.</p>
    {% endcall %} {% call infoDetails("FAQ") %}
    <h4>Why did tiles stop dropping from the top?</h4>
    <p>You've scored enough — match the remaining tiles until the board is empty to advance to the next level.</p>
    <h4>Why can't I swap these two tiles?</h4>
    <p>Only swaps that immediately create a match of 3 or more are allowed. Invalid swaps animate back.</p>
    <h4>What if there are no valid moves left during clearing?</h4>
    <p>The board shuffles the remaining tiles so you can always keep playing.</p>
    <h4>Is my best score saved?</h4>
    <p>Yes — saved in your browser's local storage and persists across sessions.</p>
    {% endcall %}
  </div>
</div>

<script>
  const ROWS = 8;
  const COLS = 8;
  const COLORS = 6;
  const BOMB_RADIUS = 2;
  const EMOJIS = ["🔴", "🔵", "🟢", "🟡", "🟣", "🟠"];
  const STORAGE_KEY = "mini-match-three-best";

  let board = [];
  let score = 0;
  let best = parseInt(localStorage.getItem(STORAGE_KEY) || "0", 10);
  let level = 1;
  let moves = 0;
  let target = 0;
  let selected = null;
  let busy = false;
  let touchStartTile = null;
  let clearingMode = false;
  let bombs = 3;
  let bombMode = false;
  let hints = 3;

  const boardEl = document.getElementById("board");
  const scoreEl = document.getElementById("score-display");
  const bestEl = document.getElementById("best-display");
  const levelEl = document.getElementById("level-display");
  const movesEl = document.getElementById("moves-display");
  const overlayEl = document.getElementById("overlay");
  const gameoverEl = document.getElementById("gameover-overlay");

  bestEl.textContent = best;

  function movesForLevel(lvl) {
    return Math.max(12, 20 - (lvl - 1));
  }

  function targetForLevel(lvl) {
    return 500 + (lvl - 1) * 300;
  }

  function randomColor() {
    return Math.floor(Math.random() * COLORS);
  }

  function makeBoard() {
    const b = Array.from({ length: ROWS }, () => Array(COLS).fill(0));
    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++) {
        let color;
        do {
          color = randomColor();
        } while (
          (c >= 2 && b[r][c - 1] === color && b[r][c - 2] === color) ||
          (r >= 2 && b[r - 1][c] === color && b[r - 2][c] === color)
        );
        b[r][c] = color;
      }
    }
    return b;
  }

  function findMatches(b) {
    const matched = new Set();
    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS - 2; c++) {
        if (b[r][c] !== null && b[r][c] === b[r][c + 1] && b[r][c] === b[r][c + 2]) {
          let len = 3;
          while (c + len < COLS && b[r][c + len] === b[r][c]) len++;
          for (let k = 0; k < len; k++) matched.add(`${r},${c + k}`);
        }
      }
    }
    for (let c = 0; c < COLS; c++) {
      for (let r = 0; r < ROWS - 2; r++) {
        if (b[r][c] !== null && b[r][c] === b[r + 1][c] && b[r][c] === b[r + 2][c]) {
          let len = 3;
          while (r + len < ROWS && b[r + len][c] === b[r][c]) len++;
          for (let k = 0; k < len; k++) matched.add(`${r + k},${c}`);
        }
      }
    }
    return matched;
  }

  function isBoardEmpty() {
    return board.every((row) => row.every((cell) => cell === null));
  }

  function hasValidMoves(b) {
    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++) {
        if (b[r][c] === null) continue;
        if (c + 1 < COLS && b[r][c + 1] !== null && wouldMatch(b, r, c, r, c + 1)) return true;
        if (r + 1 < ROWS && b[r + 1][c] !== null && wouldMatch(b, r, c, r + 1, c)) return true;
      }
    }
    return false;
  }

  function wouldMatch(b, r1, c1, r2, c2) {
    swapBoard(b, r1, c1, r2, c2);
    const m = findMatches(b).size > 0;
    swapBoard(b, r1, c1, r2, c2);
    return m;
  }

  function swapBoard(b, r1, c1, r2, c2) {
    const tmp = b[r1][c1];
    b[r1][c1] = b[r2][c2];
    b[r2][c2] = tmp;
  }

  function scoreForCount(n) {
    if (n >= 5) return 150;
    if (n === 4) return 60;
    return 30;
  }

  function getTileEl(r, c) {
    return boardEl.querySelector(`[data-row="${r}"][data-col="${c}"]`);
  }

  function renderBoard() {
    selected = null;
    boardEl.innerHTML = "";
    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++) {
        const el = document.createElement("div");
        el.dataset.row = r;
        el.dataset.col = c;
        if (board[r][c] === null) {
          el.className = "tile-empty";
        } else {
          el.className = "tile";
          el.dataset.color = board[r][c];
          el.textContent = EMOJIS[board[r][c]];
          el.addEventListener("click", () => onTileClick(r, c));
          el.addEventListener("touchstart", (e) => onTouchStart(e, r, c), { passive: true });
          el.addEventListener("touchend", (e) => onTouchEnd(e, r, c), { passive: true });
          el.addEventListener("mouseover", () => {
            if (bombMode) showBombPreview(r, c);
          });
          el.addEventListener("mouseleave", () => {
            if (bombMode) clearBombPreview();
          });
        }
        boardEl.appendChild(el);
      }
    }
  }

  function onTouchStart(e, r, c) {
    touchStartTile = { r, c, x: e.touches[0].clientX, y: e.touches[0].clientY };
  }

  function onTouchEnd(e, r, c) {
    if (!touchStartTile) return;
    const dx = e.changedTouches[0].clientX - touchStartTile.x;
    const dy = e.changedTouches[0].clientY - touchStartTile.y;
    const absDx = Math.abs(dx);
    const absDy = Math.abs(dy);
    if (absDx < 10 && absDy < 10) {
      onTileClick(r, c);
    } else if (!bombMode) {
      let tr = touchStartTile.r;
      let tc = touchStartTile.c;
      if (absDx > absDy) {
        tc += dx > 0 ? 1 : -1;
      } else {
        tr += dy > 0 ? 1 : -1;
      }
      if (tr >= 0 && tr < ROWS && tc >= 0 && tc < COLS) {
        doSwap(touchStartTile.r, touchStartTile.c, tr, tc);
      }
    }
    touchStartTile = null;
  }

  function onTileClick(r, c) {
    if (busy) return;
    if (bombMode) {
      useBomb(r, c);
      return;
    }
    if (selected === null) {
      selected = { r, c };
      getTileEl(r, c).classList.add("selected");
    } else {
      const { r: sr, c: sc } = selected;
      getTileEl(sr, sc).classList.remove("selected");
      selected = null;
      if (sr === r && sc === c) return;
      const isAdjacent = (Math.abs(sr - r) === 1 && sc === c) || (Math.abs(sc - c) === 1 && sr === r);
      if (isAdjacent) {
        doSwap(sr, sc, r, c);
      } else {
        selected = { r, c };
        getTileEl(r, c).classList.add("selected");
      }
    }
  }

  async function doSwap(r1, c1, r2, c2) {
    if (busy) return;
    busy = true;

    const el1 = getTileEl(r1, c1);
    const el2 = getTileEl(r2, c2);
    if (el1 && el2) {
      const rect1 = el1.getBoundingClientRect();
      const rect2 = el2.getBoundingClientRect();
      const dx = rect2.left - rect1.left;
      const dy = rect2.top - rect1.top;
      el1.style.transition = "transform 0.15s ease-in-out";
      el2.style.transition = "transform 0.15s ease-in-out";
      el1.style.zIndex = "5";
      el2.style.zIndex = "5";
      el1.style.transform = `translate(${dx}px, ${dy}px)`;
      el2.style.transform = `translate(${-dx}px, ${-dy}px)`;
      await delay(170);
    }

    swapBoard(board, r1, c1, r2, c2);
    const matches = findMatches(board);
    if (matches.size === 0) {
      swapBoard(board, r1, c1, r2, c2);
      if (el1 && el2) {
        el1.style.transform = "";
        el2.style.transform = "";
        await delay(170);
        el1.style.transition = "";
        el2.style.transition = "";
        el1.style.zIndex = "";
        el2.style.zIndex = "";
      }
      busy = false;
      return;
    }

    moves--;
    movesEl.textContent = moves;
    await resolveBoard();
    busy = false;
    checkEndCondition();
  }

  async function resolveBoard() {
    let matches = findMatches(board);
    let multiplier = 1;
    while (matches.size > 0) {
      const grouped = new Map();
      for (const key of matches) {
        const [r, c] = key.split(",").map(Number);
        const color = board[r][c];
        grouped.set(color, (grouped.get(color) || 0) + 1);
      }
      for (const [, count] of grouped) {
        score += scoreForCount(count) * multiplier;
      }
      score += (matches.size - 3) * 5 * multiplier;
      updateScoreDisplay();

      for (const key of matches) {
        const [r, c] = key.split(",").map(Number);
        const el = getTileEl(r, c);
        if (el) el.classList.add("removing");
        board[r][c] = null;
      }
      await delay(170);

      const drops = computeDropDistances();
      applyGravity();
      refillBoard();
      renderBoard();
      await animateDrop(drops);

      multiplier++;
      matches = findMatches(board);
    }

    if (!isBoardEmpty() && !hasValidMoves(board)) {
      shuffleBoard();
      renderBoard();
    }
  }

  function applyGravity() {
    for (let c = 0; c < COLS; c++) {
      const filled = [];
      for (let r = ROWS - 1; r >= 0; r--) {
        if (board[r][c] !== null) filled.push(board[r][c]);
      }
      for (let r = ROWS - 1; r >= 0; r--) {
        board[r][c] = filled.shift() ?? null;
      }
    }
  }

  function refillBoard() {
    if (clearingMode) return;
    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++) {
        if (board[r][c] === null) board[r][c] = randomColor();
      }
    }
  }

  function shuffleBoard() {
    const nonNull = [];
    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++) {
        if (board[r][c] !== null) nonNull.push(board[r][c]);
      }
    }
    for (let i = nonNull.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [nonNull[i], nonNull[j]] = [nonNull[j], nonNull[i]];
    }
    let idx = 0;
    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++) {
        if (board[r][c] !== null) board[r][c] = nonNull[idx++];
      }
    }
  }

  function updateScoreDisplay() {
    scoreEl.textContent = score;
    if (score > best) {
      best = score;
      localStorage.setItem(STORAGE_KEY, best);
      bestEl.textContent = best;
    }
  }

  function updateBombDisplay() {
    document.getElementById("bomb-count").textContent = bombs;
    const btn = document.getElementById("bomb-btn");
    btn.disabled = bombs <= 0;
    btn.classList.toggle("active", bombMode);
  }

  function updateHintDisplay() {
    document.getElementById("hint-count").textContent = hints;
    document.getElementById("hint-btn").disabled = hints <= 0;
  }

  function findHintMove() {
    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++) {
        if (board[r][c] === null) continue;
        if (c + 1 < COLS && board[r][c + 1] !== null && wouldMatch(board, r, c, r, c + 1))
          return { r1: r, c1: c, r2: r, c2: c + 1 };
        if (r + 1 < ROWS && board[r + 1][c] !== null && wouldMatch(board, r, c, r + 1, c))
          return { r1: r, c1: c, r2: r + 1, c2: c };
      }
    }
    return null;
  }

  async function useHint() {
    if (busy || hints <= 0) return;
    busy = true;
    hints--;
    updateHintDisplay();

    const move = findHintMove();
    if (!move) {
      busy = false;
      return;
    }

    const { r1, c1, r2, c2 } = move;
    const el1 = getTileEl(r1, c1);
    const el2 = getTileEl(r2, c2);
    if (!el1 || !el2) {
      busy = false;
      return;
    }

    el1.classList.add("hint-highlight");
    el2.classList.add("hint-highlight");
    await delay(350);

    const rect1 = el1.getBoundingClientRect();
    const rect2 = el2.getBoundingClientRect();
    const dx = rect2.left - rect1.left;
    const dy = rect2.top - rect1.top;

    el1.style.transition = "transform 0.55s ease-in-out";
    el2.style.transition = "transform 0.55s ease-in-out";
    el1.style.zIndex = "5";
    el2.style.zIndex = "5";
    el1.style.transform = `translate(${dx}px, ${dy}px)`;
    el2.style.transform = `translate(${-dx}px, ${-dy}px)`;
    await delay(650);

    await delay(180);

    el1.style.transform = "";
    el2.style.transform = "";
    await delay(650);

    el1.style.transition = "";
    el2.style.transition = "";
    el1.style.zIndex = "";
    el2.style.zIndex = "";
    el1.classList.remove("hint-highlight");
    el2.classList.remove("hint-highlight");

    busy = false;
  }

  function toggleBombMode() {
    if (busy || bombs <= 0) return;
    bombMode = !bombMode;
    if (!bombMode) clearBombPreview();
    if (selected !== null) {
      const el = getTileEl(selected.r, selected.c);
      if (el) el.classList.remove("selected");
      selected = null;
    }
    updateBombDisplay();
    boardEl.style.cursor = bombMode ? "crosshair" : "";
  }

  async function useBomb(r, c) {
    if (busy || bombs <= 0) return;
    busy = true;
    bombMode = false;
    clearBombPreview();
    boardEl.style.cursor = "";
    bombs--;
    updateBombDisplay();

    const toRemove = [];
    for (let dr = -BOMB_RADIUS; dr <= BOMB_RADIUS; dr++) {
      for (let dc = -BOMB_RADIUS; dc <= BOMB_RADIUS; dc++) {
        const nr = r + dr;
        const nc = c + dc;
        if (nr >= 0 && nr < ROWS && nc >= 0 && nc < COLS && board[nr][nc] !== null) {
          toRemove.push([nr, nc]);
        }
      }
    }

    for (const [nr, nc] of toRemove) {
      const el = getTileEl(nr, nc);
      if (el) el.classList.add("blasting");
    }
    await delay(240);

    for (const [nr, nc] of toRemove) {
      board[nr][nc] = null;
    }

    const drops = computeDropDistances();
    applyGravity();
    refillBoard();
    renderBoard();
    await animateDrop(drops);

    const matches = findMatches(board);
    if (matches.size > 0) {
      await resolveBoard();
    } else if (!isBoardEmpty() && !hasValidMoves(board)) {
      shuffleBoard();
      renderBoard();
    }

    busy = false;
    checkEndCondition();
  }

  function showBombPreview(cr, cc) {
    clearBombPreview();
    for (let dr = -BOMB_RADIUS; dr <= BOMB_RADIUS; dr++) {
      for (let dc = -BOMB_RADIUS; dc <= BOMB_RADIUS; dc++) {
        const el = getTileEl(cr + dr, cc + dc);
        if (el) el.classList.add("bomb-preview");
      }
    }
  }

  function clearBombPreview() {
    boardEl.querySelectorAll(".bomb-preview").forEach((el) => el.classList.remove("bomb-preview"));
  }

  function computeDropDistances() {
    // Call before applyGravity() — board has null for cleared tiles.
    // Returns { "newRow,col": cellsFallen } only for tiles that actually moved.
    const drops = {};
    for (let c = 0; c < COLS; c++) {
      let nullsBelow = 0;
      for (let r = ROWS - 1; r >= 0; r--) {
        if (board[r][c] === null) {
          nullsBelow++;
        } else if (nullsBelow > 0) {
          drops[`${r + nullsBelow},${c}`] = nullsBelow;
        }
      }
      // nullsBelow is now the total null count for this column.
      // In normal mode, new tiles fill from the top — all start from the same
      // height above (nullsBelow cells) so the drop distance is uniform.
      if (!clearingMode) {
        for (let r = 0; r < nullsBelow; r++) {
          drops[`${r},${c}`] = nullsBelow;
        }
      }
    }
    return drops;
  }

  async function animateDrop(drops) {
    const entries = Object.entries(drops);
    if (entries.length === 0) return;
    const firstTile = boardEl.querySelector(".tile");
    if (!firstTile) return;
    const cellH = firstTile.getBoundingClientRect().height;
    const step = cellH + 3;

    for (const [key, dist] of entries) {
      const [r, c] = key.split(",").map(Number);
      const el = getTileEl(r, c);
      if (!el || !el.classList.contains("tile")) continue;
      el.style.transition = "none";
      el.style.transform = `translateY(${-dist * step}px)`;
    }

    boardEl.offsetHeight;

    for (const [key] of entries) {
      const [r, c] = key.split(",").map(Number);
      const el = getTileEl(r, c);
      if (!el || !el.classList.contains("tile")) continue;
      el.style.transition = "transform 0.38s ease-in";
      el.style.transform = "";
    }

    await delay(400);

    for (const [key] of entries) {
      const [r, c] = key.split(",").map(Number);
      const el = getTileEl(r, c);
      if (!el) continue;
      el.style.transition = "";
    }
  }

  function checkEndCondition() {
    if (clearingMode) {
      if (isBoardEmpty()) {
        launchConfetti();
        clearingMode = false;
        level++;
        bombs = Math.min(bombs + 1, 3);
        hints = Math.min(hints + 1, 3);
        moves = movesForLevel(level);
        target = targetForLevel(level);
        levelEl.textContent = level;
        movesEl.textContent = moves;
        updateBombDisplay();
        updateHintDisplay();
        board = makeBoard();
        renderBoard();
      } else if (moves <= 0) {
        showEnd(false);
      }
      return;
    }
    if (score >= target) {
      clearingMode = true;
      return;
    }
    if (moves <= 0) {
      showEnd(false);
    }
  }

  function showEnd(isWin) {
    if (score > parseInt(localStorage.getItem(STORAGE_KEY) || "0", 10)) {
      launchConfetti();
    }
    document.getElementById("go-icon").textContent = isWin ? "🏆" : "💀";
    document.getElementById("go-title").textContent = isWin ? "You Win!" : "Game Over";
    document.getElementById("go-score").textContent = score;
    document.getElementById("go-best").textContent = best;
    document.getElementById("go-level").textContent = level;
    overlayEl.style.display = "none";
    gameoverEl.style.display = "flex";
  }

  function startGame() {
    score = 0;
    level = 1;
    moves = movesForLevel(level);
    target = targetForLevel(level);
    selected = null;
    busy = false;
    clearingMode = false;
    bombs = 3;
    bombMode = false;
    hints = 3;
    board = makeBoard();
    scoreEl.textContent = 0;
    levelEl.textContent = 1;
    movesEl.textContent = moves;
    updateBombDisplay();
    updateHintDisplay();
    boardEl.style.cursor = "";
    overlayEl.style.display = "none";
    gameoverEl.style.display = "none";
    renderBoard();
  }

  function delay(ms) {
    return new Promise((res) => setTimeout(res, ms));
  }

  function launchConfetti() {
    const canvas = document.createElement("canvas");
    canvas.style.cssText = "position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999";
    document.body.appendChild(canvas);
    const ctx = canvas.getContext("2d");
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    const particles = Array.from({ length: 80 }, () => ({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height - canvas.height,
      r: Math.random() * 6 + 3,
      d: Math.random() * 80 + 10,
      color: `hsl(${Math.random() * 360},90%,60%)`,
      tilt: Math.random() * 10 - 10,
      tiltAngleIncrement: Math.random() * 0.07 + 0.05,
      tiltAngle: 0,
    }));
    let angle = 0;
    const end = Date.now() + 3000;
    (function frame() {
      if (Date.now() > end) {
        canvas.remove();
        return;
      }
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      angle += 0.01;
      particles.forEach((p) => {
        p.tiltAngle += p.tiltAngleIncrement;
        p.y += (Math.cos(angle + p.d) + 3 + p.r / 2) * 0.8;
        p.tilt = Math.sin(p.tiltAngle) * 15;
        if (p.y > canvas.height) {
          p.x = Math.random() * canvas.width;
          p.y = -10;
        }
        ctx.beginPath();
        ctx.lineWidth = p.r;
        ctx.strokeStyle = p.color;
        ctx.moveTo(p.x + p.tilt + p.r / 4, p.y);
        ctx.lineTo(p.x + p.tilt, p.y + p.tilt + p.r / 4);
        ctx.stroke();
      });
      requestAnimationFrame(frame);
    })();
  }

  renderBoard();
</script>
