---
layout: layouts/game.njk
title: Pong
description: Two paddles, one ball — first to 7 points wins. Play vs AI or a friend!
category: arcade
icon: "🏓"
---

{% from "macros/game-components.njk" import statCard, summaryStatCard, infoDetails %}

<style>
  #game-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: calc(100vh - 60px);
    gap: 1rem;
    padding: 1rem;
  }
  .score-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.5rem 1rem;
  }
  .stat-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .stat-value {
    font-size: 1.2rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  .mode-row {
    display: flex;
    gap: 0.5rem;
  }
  .mode-btn {
    padding: 0.3rem 0.9rem;
    background: #1e293b;
    color: #94a3b8;
    border: 1px solid #334155;
    border-radius: 6px;
    font-size: 0.8rem;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .mode-btn.active,
  .mode-btn:hover {
    background: #334155;
    color: white;
    border-color: #3b82f6;
  }
  .canvas-wrapper {
    position: relative;
    touch-action: none;
    line-height: 0;
  }
  canvas {
    border: 2px solid #1e3a5f;
    border-radius: 4px;
    display: block;
  }
  #overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.83);
    border-radius: 4px;
    gap: 0.75rem;
    line-height: normal;
  }
  #overlay span:first-child {
    font-size: 3rem;
  }
  #overlay h2 {
    font-size: 1.6rem;
    font-weight: bold;
    color: white;
    margin: 0;
  }
  #overlay p {
    color: #94a3b8;
    font-size: 0.85rem;
    text-align: center;
    margin: 0;
  }
  .demo-label {
    font-size: 0.7rem;
    color: #3b82f6;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  #gameover-overlay {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.96);
    border-radius: 4px;
    gap: 0.75rem;
    line-height: normal;
  }
  #gameover-overlay span:first-child {
    font-size: 2.5rem;
  }
  #gameover-overlay h2 {
    font-size: 1.6rem;
    font-weight: bold;
    color: white;
    margin: 0;
  }
  .summary-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .summary-stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.5rem 0.9rem;
    min-width: 72px;
  }
  .summary-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .summary-value {
    font-size: 1.2rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  .play-btn {
    padding: 0.5rem 1.5rem;
    background: #2563eb;
    color: white;
    font-size: 1rem;
    font-weight: 600;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .play-btn:hover {
    background: #1d4ed8;
  }
  .controls-hint {
    font-size: 0.75rem;
    color: #64748b;
    text-align: center;
  }
  .info-section {
    width: 100%;
    max-width: 500px;
    padding: 0 1rem 2rem;
    margin: 0 auto;
  }
  .info-details {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    margin-bottom: 0.75rem;
    overflow: hidden;
  }
  .info-details summary {
    padding: 0.75rem 1rem;
    font-weight: 600;
    color: #e2e8f0;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
  }
  .info-details summary::-webkit-details-marker {
    display: none;
  }
  .info-details summary::after {
    content: "+";
    font-size: 1.1rem;
    color: #64748b;
  }
  .info-details[open] summary::after {
    content: "−";
  }
  .info-body {
    padding: 0.75rem 1rem 1rem;
    color: #94a3b8;
    font-size: 0.875rem;
    line-height: 1.6;
    border-top: 1px solid #334155;
  }
  .info-body h4 {
    color: #e2e8f0;
    font-weight: 600;
    margin: 0.75rem 0 0.25rem;
    font-size: 0.875rem;
  }
  .info-body h4:first-child {
    margin-top: 0;
  }
  .info-body ul {
    padding-left: 1.25rem;
    margin: 0.25rem 0;
  }
  .info-body li {
    margin-bottom: 0.25rem;
  }
  .info-body p {
    margin: 0.25rem 0;
  }
</style>

<div id="game-wrapper">
  <div class="score-row">
    {{ statCard("You (P1)", "p1-score") }} {{ statCard("AI", "p2-score", "0", "", "p2-label") }} {{ statCard("Wins",
    "best-display") }}
  </div>

  <div class="mode-row">
    <button class="mode-btn active" id="mode-ai" onclick="setMode('ai')">vs AI</button>
    <button class="mode-btn" id="mode-pvp" onclick="setMode('pvp')">vs Player</button>
  </div>

  <div class="canvas-wrapper">
    <canvas id="pong"></canvas>

    <div id="overlay">
      <span class="demo-label" id="demo-label">Live Demo</span>
      <span style="font-size: 3rem">🏓</span>
      <h2>Pong</h2>
      <p>First to 7 points wins!</p>
      <button class="play-btn" onclick="startGame()">Play Game</button>
    </div>

    <div id="gameover-overlay" style="display: none">
      <span id="go-icon">💀</span>
      <h2 id="go-title">Game Over</h2>
      <div class="summary-row">
        {{ summaryStatCard("You", "go-p1") }} {{ summaryStatCard("Opponent", "go-p2") }} {{ summaryStatCard("Wins",
        "go-wins") }}
      </div>
      <p id="go-mode" style="color: #64748b; font-size: 0.8rem; margin: 0"></p>
      <button class="play-btn" onclick="startGame()">New Game</button>
    </div>
  </div>

  <p class="controls-hint">W / S — Player 1 &nbsp;·&nbsp; ↑ / ↓ — Player 2</p>
</div>

<div class="info-section">
  {% call infoDetails("How to Play") %}
  <h4>Goal</h4>
  <p>Score 7 points before your opponent by getting the ball past their paddle.</p>
  <h4>Controls</h4>
  <ul>
    <li><strong>Player 1 (left):</strong> W (up) / S (down)</li>
    <li><strong>Player 2 / AI (right):</strong> ↑ (up) / ↓ (down)</li>
    <li><strong>Mobile — P1:</strong> drag finger on the left half of the court</li>
    <li><strong>Mobile — P2 (PvP):</strong> second finger on the right half</li>
  </ul>
  <h4>Modes</h4>
  <ul>
    <li><strong>vs AI</strong> — play against the computer; wins count toward your best score</li>
    <li><strong>vs Player</strong> — two players share the same keyboard or screen</li>
  </ul>
  <h4>Ball Speed</h4>
  <p>The ball speeds up slightly with each paddle hit, making rallies progressively more intense.</p>
  {% endcall %} {% call infoDetails("FAQ") %}
  <h4>Is my best score saved?</h4>
  <p>Yes — total wins vs AI are saved in your browser's local storage and persist between sessions.</p>
  <h4>How does the AI difficulty work?</h4>
  <p>
    The AI has a slight reaction delay and imperfect tracking, so it's beatable with sharp angle shots to the corners.
  </p>
  <h4>Can I play on mobile?</h4>
  <p>
    Yes! Drag your finger on the left half of the court to control your paddle. In PvP mode, a second player can use the
    right half simultaneously.
  </p>
  <h4>What affects the angle of the ball?</h4>
  <p>
    Where the ball contacts the paddle matters — hitting the edge sends it at a steep angle, hitting the centre returns
    it flatter.
  </p>
  {% endcall %}
</div>

<script>
  function launchConfetti() {
    const canvas = document.createElement("canvas");
    canvas.style.cssText = "position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:9999";
    document.body.appendChild(canvas);
    const ctx = canvas.getContext("2d");
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    const particles = Array.from({ length: 80 }, () => ({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height - canvas.height,
      r: Math.random() * 6 + 3,
      d: Math.random() * 80,
      color: `hsl(${Math.random() * 360},90%,60%)`,
      tilt: Math.random() * 10 - 10,
      tiltAngle: 0,
      tiltSpeed: Math.random() * 0.1 + 0.05,
    }));
    let frame = 0;
    const maxFrames = 180;
    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      particles.forEach((p) => {
        ctx.beginPath();
        ctx.fillStyle = p.color;
        ctx.ellipse(p.x, p.y, p.r, p.r * 0.4, p.tilt, 0, Math.PI * 2);
        ctx.fill();
        p.y += Math.cos(p.d) + 2 + p.r / 10;
        p.x += Math.sin(frame / 20) * 1.5;
        p.tiltAngle += p.tiltSpeed;
        p.tilt = Math.sin(p.tiltAngle) * 12;
        if (p.y > canvas.height) {
          p.y = -10;
          p.x = Math.random() * canvas.width;
        }
      });
      frame++;
      if (frame < maxFrames) requestAnimationFrame(draw);
      else canvas.remove();
    }
    draw();
  }

  const canvas = document.getElementById("pong");
  const ctx = canvas.getContext("2d");
  const STORAGE_KEY = "mini-pong-best";

  const W = Math.min(600, window.innerWidth - 32);
  const H = Math.round(W * 0.6);
  canvas.width = W;
  canvas.height = H;
  const S = W / 600;

  const PAD_W = Math.max(6, Math.round(10 * S));
  const PAD_H = Math.round(80 * S);
  const BALL_R = Math.max(4, Math.round(7 * S));
  const PAD_GAP = Math.round(20 * S);
  const P1_X = PAD_GAP;
  const P2_X = W - PAD_GAP - PAD_W;
  const PAD_SPEED = Math.round(7 * S);
  const BALL_INIT_SPD = 4.5 * S;
  const BALL_MAX_SPD = 11 * S;
  const BALL_SPEEDUP = 0.25 * S;
  const WIN_SCORE = 7;

  let p1y, p2y, ball, running, animId, demoAnimId;
  let p1score = 0,
    p2score = 0;
  let wins = parseInt(localStorage.getItem(STORAGE_KEY) || "0", 10);
  let gameMode = "ai";
  let paused = false;
  let pauseMsg = "";
  let pauseTimer = null;
  const keys = {};

  document.getElementById("best-display").textContent = wins;

  function setMode(mode) {
    gameMode = mode;
    document.getElementById("mode-ai").classList.toggle("active", mode === "ai");
    document.getElementById("mode-pvp").classList.toggle("active", mode === "pvp");
    document.getElementById("p2-label").textContent = mode === "pvp" ? "P2" : "AI";
  }

  function newBallVelocity(towardRight) {
    const angle = ((Math.random() * 40 - 20) * Math.PI) / 180;
    return {
      vx: BALL_INIT_SPD * (towardRight ? 1 : -1) * Math.cos(angle),
      vy: BALL_INIT_SPD * Math.sin(angle),
    };
  }

  function resetBall(towardRight) {
    const v = newBallVelocity(towardRight);
    ball = { x: W / 2, y: H / 2, vx: v.vx, vy: v.vy };
  }

  function startGame() {
    cancelAnimationFrame(demoAnimId);
    demoAnimId = null;
    p1y = H / 2 - PAD_H / 2;
    p2y = H / 2 - PAD_H / 2;
    p1score = 0;
    p2score = 0;
    resetBall(Math.random() > 0.5);
    running = true;

    document.getElementById("p1-score").textContent = "0";
    document.getElementById("p2-score").textContent = "0";
    document.getElementById("p2-label").textContent = gameMode === "pvp" ? "P2" : "AI";
    document.getElementById("demo-label").style.display = "none";
    document.getElementById("overlay").style.display = "none";
    document.getElementById("gameover-overlay").style.display = "none";

    clearTimeout(pauseTimer);
    paused = false;
    pauseMsg = "";

    cancelAnimationFrame(animId);
    animId = requestAnimationFrame(gameLoop);
  }

  function drawScoreMsg() {
    const bx = W * 0.18,
      bw = W * 0.64,
      by = H * 0.36,
      bh = H * 0.28;
    ctx.save();
    ctx.fillStyle = "rgba(15,23,42,0.82)";
    ctx.beginPath();
    ctx.roundRect(bx, by, bw, bh, 10);
    ctx.fill();
    ctx.fillStyle = "#fbbf24";
    ctx.font = `bold ${Math.round(20 * S)}px system-ui, sans-serif`;
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText(pauseMsg, W / 2, H / 2);
    ctx.restore();
  }

  function gameLoop() {
    if (!running) return;
    if (!paused) {
      handleInput();
      updateBall();
    }
    drawScene(p1y, p2y, ball);
    if (paused) drawScoreMsg();
    if (running) animId = requestAnimationFrame(gameLoop);
  }

  function handleInput() {
    if (keys["w"] || keys["W"]) p1y = Math.max(0, p1y - PAD_SPEED);
    if (keys["s"] || keys["S"]) p1y = Math.min(H - PAD_H, p1y + PAD_SPEED);

    if (gameMode === "pvp") {
      if (keys["ArrowUp"]) p2y = Math.max(0, p2y - PAD_SPEED);
      if (keys["ArrowDown"]) p2y = Math.min(H - PAD_H, p2y + PAD_SPEED);
    } else {
      const factor = ball.vx > 0 ? 0.09 : 0.04;
      p2y += (ball.y - PAD_H / 2 - p2y) * factor;
      p2y = Math.max(0, Math.min(H - PAD_H, p2y));
    }
  }

  function updateBall() {
    ball.x += ball.vx;
    ball.y += ball.vy;

    if (ball.y - BALL_R < 0) {
      ball.y = BALL_R;
      ball.vy = Math.abs(ball.vy);
    }
    if (ball.y + BALL_R > H) {
      ball.y = H - BALL_R;
      ball.vy = -Math.abs(ball.vy);
    }

    // P1 paddle hit
    if (
      ball.vx < 0 &&
      ball.x - BALL_R <= P1_X + PAD_W &&
      ball.x >= P1_X &&
      ball.y + BALL_R > p1y &&
      ball.y - BALL_R < p1y + PAD_H
    ) {
      ball.x = P1_X + PAD_W + BALL_R;
      const rel = (ball.y - (p1y + PAD_H / 2)) / (PAD_H / 2);
      const spd = Math.min(Math.abs(ball.vx) + BALL_SPEEDUP, BALL_MAX_SPD);
      ball.vx = spd;
      ball.vy = rel * 5.5 * S;
    }

    // P2 paddle hit
    if (
      ball.vx > 0 &&
      ball.x + BALL_R >= P2_X &&
      ball.x <= P2_X + PAD_W &&
      ball.y + BALL_R > p2y &&
      ball.y - BALL_R < p2y + PAD_H
    ) {
      ball.x = P2_X - BALL_R;
      const rel = (ball.y - (p2y + PAD_H / 2)) / (PAD_H / 2);
      const spd = Math.min(Math.abs(ball.vx) + BALL_SPEEDUP, BALL_MAX_SPD);
      ball.vx = -spd;
      ball.vy = rel * 5.5 * S;
    }

    // P2 scores (ball exits left)
    if (ball.x + BALL_R < 0) {
      p2score++;
      document.getElementById("p2-score").textContent = p2score;
      if (p2score >= WIN_SCORE) {
        showEnd(false);
        return;
      }
      clearTimeout(pauseTimer);
      paused = true;
      pauseMsg = gameMode === "pvp" ? "P2 scores! 🎉" : "AI gets one…";
      pauseTimer = setTimeout(() => {
        paused = false;
        pauseMsg = "";
        resetBall(true);
      }, 1400);
      return;
    }

    // P1 scores (ball exits right)
    if (ball.x - BALL_R > W) {
      p1score++;
      document.getElementById("p1-score").textContent = p1score;
      if (p1score >= WIN_SCORE) {
        showEnd(true);
        return;
      }
      clearTimeout(pauseTimer);
      paused = true;
      pauseMsg = gameMode === "pvp" ? "P1 scores! 🎉" : "Nice shot! 🎉";
      pauseTimer = setTimeout(() => {
        paused = false;
        pauseMsg = "";
        resetBall(false);
      }, 1400);
      return;
    }
  }

  function drawScene(dp1y, dp2y, db) {
    ctx.fillStyle = "#0f172a";
    ctx.fillRect(0, 0, W, H);

    // Centre line
    ctx.strokeStyle = "#1e293b";
    ctx.lineWidth = Math.max(1, Math.round(2 * S));
    ctx.setLineDash([Math.round(10 * S), Math.round(10 * S)]);
    ctx.beginPath();
    ctx.moveTo(W / 2, 0);
    ctx.lineTo(W / 2, H);
    ctx.stroke();
    ctx.setLineDash([]);

    // Paddles
    ctx.fillStyle = "#60a5fa";
    ctx.beginPath();
    ctx.roundRect(P1_X, dp1y, PAD_W, PAD_H, 4);
    ctx.fill();

    ctx.fillStyle = "#f87171";
    ctx.beginPath();
    ctx.roundRect(P2_X, dp2y, PAD_W, PAD_H, 4);
    ctx.fill();

    // Ball
    ctx.fillStyle = "#f8fafc";
    ctx.beginPath();
    ctx.arc(db.x, db.y, BALL_R, 0, Math.PI * 2);
    ctx.fill();
  }

  function showEnd(p1Won) {
    running = false;
    cancelAnimationFrame(animId);
    drawScene(p1y, p2y, ball);

    if (p1Won && gameMode === "ai") {
      wins++;
      localStorage.setItem(STORAGE_KEY, wins);
      document.getElementById("best-display").textContent = wins;
      launchConfetti();
    }

    document.getElementById("go-icon").textContent = p1Won ? "🏆" : "💀";
    document.getElementById("go-title").textContent = p1Won ? "You Win!" : "Game Over";
    document.getElementById("go-p1").textContent = p1score;
    document.getElementById("go-p2").textContent = p2score;
    document.getElementById("go-wins").textContent = wins;
    document.getElementById("go-mode").textContent = gameMode === "ai" ? "vs AI" : "vs Player";

    document.getElementById("overlay").style.display = "none";
    document.getElementById("gameover-overlay").style.display = "flex";
  }

  // Demo: AI vs AI
  function startDemo() {
    let dp1y = H / 2 - PAD_H / 2;
    let dp2y = H / 2 - PAD_H / 2;
    const v = newBallVelocity(Math.random() > 0.5);
    let db = { x: W / 2, y: H / 2, vx: v.vx, vy: v.vy };

    function demoLoop() {
      const f1 = db.vx < 0 ? 0.09 : 0.04;
      const f2 = db.vx > 0 ? 0.09 : 0.04;
      dp1y += (db.y - PAD_H / 2 - dp1y) * f1;
      dp2y += (db.y - PAD_H / 2 - dp2y) * f2;
      dp1y = Math.max(0, Math.min(H - PAD_H, dp1y));
      dp2y = Math.max(0, Math.min(H - PAD_H, dp2y));

      db.x += db.vx;
      db.y += db.vy;

      if (db.y - BALL_R < 0) {
        db.y = BALL_R;
        db.vy = Math.abs(db.vy);
      }
      if (db.y + BALL_R > H) {
        db.y = H - BALL_R;
        db.vy = -Math.abs(db.vy);
      }

      if (
        db.vx < 0 &&
        db.x - BALL_R <= P1_X + PAD_W &&
        db.x >= P1_X &&
        db.y + BALL_R > dp1y &&
        db.y - BALL_R < dp1y + PAD_H
      ) {
        db.x = P1_X + PAD_W + BALL_R;
        const rel = (db.y - (dp1y + PAD_H / 2)) / (PAD_H / 2);
        const spd = Math.min(Math.abs(db.vx) + BALL_SPEEDUP * 0.5, BALL_MAX_SPD * 0.7);
        db.vx = spd;
        db.vy = rel * 4 * S;
      }

      if (
        db.vx > 0 &&
        db.x + BALL_R >= P2_X &&
        db.x <= P2_X + PAD_W &&
        db.y + BALL_R > dp2y &&
        db.y - BALL_R < dp2y + PAD_H
      ) {
        db.x = P2_X - BALL_R;
        const rel = (db.y - (dp2y + PAD_H / 2)) / (PAD_H / 2);
        const spd = Math.min(Math.abs(db.vx) + BALL_SPEEDUP * 0.5, BALL_MAX_SPD * 0.7);
        db.vx = -spd;
        db.vy = rel * 4 * S;
      }

      if (db.x + BALL_R < 0 || db.x - BALL_R > W) {
        const dir = db.x < 0 ? 1 : -1;
        const nv = newBallVelocity(dir > 0);
        db = { x: W / 2, y: H / 2, vx: nv.vx, vy: nv.vy };
        dp1y = H / 2 - PAD_H / 2;
        dp2y = H / 2 - PAD_H / 2;
      }

      drawScene(dp1y, dp2y, db);
      demoAnimId = requestAnimationFrame(demoLoop);
    }

    drawScene(dp1y, dp2y, db);
    demoAnimId = requestAnimationFrame(demoLoop);
  }

  // Touch controls
  const activeTouches = {};

  canvas.addEventListener(
    "touchstart",
    (e) => {
      e.preventDefault();
      if (!running) return;
      const rect = canvas.getBoundingClientRect();
      for (const t of e.changedTouches) {
        const cx = t.clientX - rect.left;
        const cy = (t.clientY - rect.top) * (H / rect.height);
        activeTouches[t.identifier] = cx < rect.width / 2 ? "p1" : "p2";
        if (activeTouches[t.identifier] === "p1") {
          p1y = Math.max(0, Math.min(H - PAD_H, cy - PAD_H / 2));
        } else if (gameMode === "pvp") {
          p2y = Math.max(0, Math.min(H - PAD_H, cy - PAD_H / 2));
        }
      }
    },
    { passive: false }
  );

  canvas.addEventListener(
    "touchmove",
    (e) => {
      e.preventDefault();
      if (!running) return;
      const rect = canvas.getBoundingClientRect();
      for (const t of e.changedTouches) {
        const cy = (t.clientY - rect.top) * (H / rect.height);
        if (activeTouches[t.identifier] === "p1") {
          p1y = Math.max(0, Math.min(H - PAD_H, cy - PAD_H / 2));
        } else if (activeTouches[t.identifier] === "p2" && gameMode === "pvp") {
          p2y = Math.max(0, Math.min(H - PAD_H, cy - PAD_H / 2));
        }
      }
    },
    { passive: false }
  );

  canvas.addEventListener("touchend", (e) => {
    for (const t of e.changedTouches) delete activeTouches[t.identifier];
  });

  // Keyboard
  document.addEventListener("keydown", (e) => {
    if (["ArrowUp", "ArrowDown", " "].includes(e.key)) e.preventDefault();
    keys[e.key] = true;
  });
  document.addEventListener("keyup", (e) => {
    delete keys[e.key];
  });

  // Start with demo on load
  startDemo();
</script>
