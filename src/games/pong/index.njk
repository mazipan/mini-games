---
layout: layouts/game.njk
title: Pong
description: Two paddles, one ball — first to 7 points wins. Play vs AI or a friend!
category: arcade
icon: "🏓"
---

{% from "macros/game-components.njk" import statCard, summaryStatCard, infoDetails %}

<style>
  #game-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: calc(100vh - 60px);
    gap: 1rem;
    padding: 1rem;
  }
  .score-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.5rem 1rem;
  }
  .stat-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .stat-value {
    font-size: 1.2rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  .mode-row {
    display: flex;
    gap: 0.5rem;
  }
  .mode-btn {
    padding: 0.3rem 0.9rem;
    background: #1e293b;
    color: #94a3b8;
    border: 1px solid #334155;
    border-radius: 6px;
    font-size: 0.8rem;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .mode-btn.active,
  .mode-btn:hover {
    background: #334155;
    color: white;
    border-color: #3b82f6;
  }
  .canvas-wrapper {
    position: relative;
    touch-action: none;
    line-height: 0;
  }
  canvas {
    border: 2px solid #1e3a5f;
    border-radius: 4px;
    display: block;
  }
  #overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.83);
    border-radius: 4px;
    gap: 0.75rem;
    line-height: normal;
  }
  #overlay span:first-child {
    font-size: 3rem;
  }
  #overlay h2 {
    font-size: 1.6rem;
    font-weight: bold;
    color: white;
    margin: 0;
  }
  #overlay p {
    color: #94a3b8;
    font-size: 0.85rem;
    text-align: center;
    margin: 0;
  }
  .demo-label {
    font-size: 0.7rem;
    color: #3b82f6;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  #gameover-overlay {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.96);
    border-radius: 4px;
    gap: 0.75rem;
    line-height: normal;
  }
  #gameover-overlay span:first-child {
    font-size: 2.5rem;
  }
  #gameover-overlay h2 {
    font-size: 1.6rem;
    font-weight: bold;
    color: white;
    margin: 0;
  }
  .summary-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .summary-stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.5rem 0.9rem;
    min-width: 72px;
  }
  .summary-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .summary-value {
    font-size: 1.2rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  .play-btn {
    padding: 0.5rem 1.5rem;
    background: #2563eb;
    color: white;
    font-size: 1rem;
    font-weight: 600;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .play-btn:hover {
    background: #1d4ed8;
  }
  .controls-hint {
    font-size: 0.75rem;
    color: #64748b;
    text-align: center;
  }
  .info-section {
    width: 100%;
    max-width: 500px;
    padding: 0 1rem 2rem;
    margin: 0 auto;
  }
  .info-details {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    margin-bottom: 0.75rem;
    overflow: hidden;
  }
  .info-details summary {
    padding: 0.75rem 1rem;
    font-weight: 600;
    color: #e2e8f0;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
  }
  .info-details summary::-webkit-details-marker {
    display: none;
  }
  .info-details summary::after {
    content: "+";
    font-size: 1.1rem;
    color: #64748b;
  }
  .info-details[open] summary::after {
    content: "−";
  }
  .info-body {
    padding: 0.75rem 1rem 1rem;
    color: #94a3b8;
    font-size: 0.875rem;
    line-height: 1.6;
    border-top: 1px solid #334155;
  }
  .info-body h4 {
    color: #e2e8f0;
    font-weight: 600;
    margin: 0.75rem 0 0.25rem;
    font-size: 0.875rem;
  }
  .info-body h4:first-child {
    margin-top: 0;
  }
  .info-body ul {
    padding-left: 1.25rem;
    margin: 0.25rem 0;
  }
  .info-body li {
    margin-bottom: 0.25rem;
  }
  .info-body p {
    margin: 0.25rem 0;
  }
</style>

<div id="game-wrapper">
  <div class="score-row">
    {{ statCard("You", "p1-score", "0", "", "p1-label") }} {{ statCard("AI", "p2-score", "0", "", "p2-label") }} {{
    statCard("Wins", "best-display") }}
  </div>

  <div class="mode-row" id="orientation-row">
    <button class="mode-btn active" id="orient-h" onclick="setOrientation('horizontal')">↔ Horizontal</button>
    <button class="mode-btn" id="orient-v" onclick="setOrientation('vertical')">↕ Vertical</button>
  </div>
  <div class="mode-row" id="mode-row">
    <button class="mode-btn active" id="mode-ai" onclick="setMode('ai')">vs AI</button>
    <button class="mode-btn" id="mode-pvp" onclick="setMode('pvp')">vs Player</button>
  </div>
  <div class="mode-row" id="side-row">
    <button class="mode-btn active" id="side-left" onclick="setPlayerSide('left')">◀ Left</button>
    <button class="mode-btn" id="side-right" onclick="setPlayerSide('right')">Right ▶</button>
  </div>

  <div class="canvas-wrapper">
    <canvas id="pong"></canvas>

    <div id="overlay">
      <span class="demo-label" id="demo-label">Live Demo</span>
      <span style="font-size: 3rem">🏓</span>
      <h2>Pong</h2>
      <p>First to 7 points wins!</p>
      <button class="play-btn" onclick="startGame()">Play Game</button>
    </div>

    <div id="gameover-overlay" style="display: none">
      <span id="go-icon">💀</span>
      <h2 id="go-title">Game Over</h2>
      <div class="summary-row">
        {{ summaryStatCard("You", "go-p1") }} {{ summaryStatCard("Opponent", "go-p2") }} {{ summaryStatCard("Wins",
        "go-wins") }}
      </div>
      <p id="go-mode" style="color: #64748b; font-size: 0.8rem; margin: 0"></p>
      <button class="play-btn" onclick="startGame()">New Game</button>
    </div>
  </div>

  <p class="controls-hint" id="controls-hint">W / S or ↑ / ↓ — you (left) · AI on right</p>
</div>

<div class="info-section">
  {% call infoDetails("How to Play") %}
  <h4>Goal</h4>
  <p>Score 7 points before your opponent by getting the ball past their paddle.</p>
  <h4>Controls</h4>
  <ul>
    <li><strong>Your paddle:</strong> W / S or ↑ / ↓</li>
    <li><strong>Mobile:</strong> drag on your chosen side of the court</li>
    <li><strong>PvP — P1 (left):</strong> W / S &nbsp;·&nbsp; P2 (right): ↑ / ↓</li>
  </ul>
  <h4>Modes &amp; Side</h4>
  <ul>
    <li><strong>vs AI</strong> — play the computer; choose ◀ Left or Right ▶ before starting</li>
    <li><strong>vs Player</strong> — two players share the same keyboard or screen</li>
    <li>Mode and side can be changed between games but not mid-rally</li>
  </ul>
  <h4>Ball Speed</h4>
  <p>The ball speeds up slightly with each paddle hit, making rallies progressively more intense.</p>
  {% endcall %} {% call infoDetails("FAQ") %}
  <h4>Is my best score saved?</h4>
  <p>Yes — total wins vs AI are saved in your browser's local storage and persist between sessions.</p>
  <h4>How does the AI difficulty work?</h4>
  <p>
    The AI has a slight reaction delay and imperfect tracking, so it's beatable with sharp angle shots to the corners.
  </p>
  <h4>Can I play on mobile?</h4>
  <p>
    Yes! Drag your finger on the left half of the court to control your paddle. In PvP mode, a second player can use the
    right half simultaneously.
  </p>
  <h4>What affects the angle of the ball?</h4>
  <p>
    Where the ball contacts the paddle matters — hitting the edge sends it at a steep angle, hitting the centre returns
    it flatter.
  </p>
  {% endcall %}
</div>

<script>
  function launchConfetti() {
    const canvas = document.createElement("canvas");
    canvas.style.cssText = "position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:9999";
    document.body.appendChild(canvas);
    const ctx = canvas.getContext("2d");
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    const particles = Array.from({ length: 80 }, () => ({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height - canvas.height,
      r: Math.random() * 6 + 3,
      d: Math.random() * 80,
      color: `hsl(${Math.random() * 360},90%,60%)`,
      tilt: Math.random() * 10 - 10,
      tiltAngle: 0,
      tiltSpeed: Math.random() * 0.1 + 0.05,
    }));
    let frame = 0;
    const maxFrames = 180;
    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      particles.forEach((p) => {
        ctx.beginPath();
        ctx.fillStyle = p.color;
        ctx.ellipse(p.x, p.y, p.r, p.r * 0.4, p.tilt, 0, Math.PI * 2);
        ctx.fill();
        p.y += Math.cos(p.d) + 2 + p.r / 10;
        p.x += Math.sin(frame / 20) * 1.5;
        p.tiltAngle += p.tiltSpeed;
        p.tilt = Math.sin(p.tiltAngle) * 12;
        if (p.y > canvas.height) {
          p.y = -10;
          p.x = Math.random() * canvas.width;
        }
      });
      frame++;
      if (frame < maxFrames) requestAnimationFrame(draw);
      else canvas.remove();
    }
    draw();
  }

  const canvas = document.getElementById("pong");
  const ctx = canvas.getContext("2d");
  const STORAGE_KEY = "mini-pong-best";

  const W = Math.min(600, window.innerWidth - 32);
  const H = Math.round(W * 0.6);
  canvas.width = W;
  canvas.height = H;
  const S = W / 600;

  const PAD_W = Math.max(6, Math.round(10 * S));
  const PAD_H = Math.round(80 * S);
  const BALL_R = Math.max(4, Math.round(7 * S));
  const PAD_GAP = Math.round(20 * S);
  const P1_X = PAD_GAP;
  const P2_X = W - PAD_GAP - PAD_W;
  const PAD_SPEED = Math.round(7 * S);
  const BALL_INIT_SPD = 4.5 * S;
  const BALL_MAX_SPD = 11 * S;
  const BALL_SPEEDUP = 0.25 * S;
  const WIN_SCORE = 7;
  // vertical-mode paddle constants
  const VPAD_W = PAD_H; // wide horizontal bar
  const VPAD_H = PAD_W; // thin
  const VP1_Y = PAD_GAP; // top paddle fixed y
  const VP2_Y = H - PAD_GAP - VPAD_H; // bottom paddle fixed y

  let p1y, p2y, p1x, p2x, ball, running, animId, demoAnimId;
  let orientation = "horizontal";
  let p1score = 0,
    p2score = 0;
  let wins = parseInt(localStorage.getItem(STORAGE_KEY) || "0", 10);
  let gameMode = "ai";
  let playerSide = "left";
  let paused = false;
  let pauseMsg = "";
  let pauseTimer = null;
  const keys = {};

  document.getElementById("best-display").textContent = wins;

  function updateLabels() {
    if (gameMode === "pvp") {
      document.getElementById("p1-label").textContent = "P1";
      document.getElementById("p2-label").textContent = "P2";
    } else if (playerSide === "left") {
      const you = orientation === "vertical" ? "You ▲" : "You ◀";
      document.getElementById("p1-label").textContent = you;
      document.getElementById("p2-label").textContent = "AI";
    } else {
      document.getElementById("p1-label").textContent = "AI";
      const you = orientation === "vertical" ? "You ▼" : "You ▶";
      document.getElementById("p2-label").textContent = you;
    }
  }

  function updateControlsHint() {
    const el = document.getElementById("controls-hint");
    if (orientation === "vertical") {
      if (gameMode === "pvp") {
        el.textContent = "A / D — P1 (top) · ← / → — P2 (bottom)";
      } else if (playerSide === "left") {
        el.textContent = "A / D or ← / → — you (top) · AI on bottom";
      } else {
        el.textContent = "A / D or ← / → — you (bottom) · AI on top";
      }
    } else {
      if (gameMode === "pvp") {
        el.textContent = "W / S — P1 (left) · ↑ / ↓ — P2 (right)";
      } else if (playerSide === "left") {
        el.textContent = "W / S or ↑ / ↓ — you (left) · AI on right";
      } else {
        el.textContent = "W / S or ↑ / ↓ — you (right) · AI on left";
      }
    }
  }

  function setMode(mode) {
    gameMode = mode;
    document.getElementById("mode-ai").classList.toggle("active", mode === "ai");
    document.getElementById("mode-pvp").classList.toggle("active", mode === "pvp");
    document.getElementById("side-row").style.display = mode === "ai" ? "flex" : "none";
    updateLabels();
    updateControlsHint();
  }

  function setPlayerSide(side) {
    playerSide = side;
    document.getElementById("side-left").classList.toggle("active", side === "left");
    document.getElementById("side-right").classList.toggle("active", side === "right");
    updateLabels();
    updateControlsHint();
  }

  function setOrientation(o) {
    orientation = o;
    document.getElementById("orient-h").classList.toggle("active", o === "horizontal");
    document.getElementById("orient-v").classList.toggle("active", o === "vertical");
    const isH = o === "horizontal";
    document.getElementById("side-left").textContent = isH ? "◀ Left" : "▲ Top";
    document.getElementById("side-right").textContent = isH ? "Right ▶" : "Bottom ▼";
    updateLabels();
    updateControlsHint();
    if (demoAnimId) {
      cancelAnimationFrame(demoAnimId);
      demoAnimId = null;
      startDemo();
    }
  }

  function newBallVelocity(towardRight) {
    const angle = ((Math.random() * 40 - 20) * Math.PI) / 180;
    return {
      vx: BALL_INIT_SPD * (towardRight ? 1 : -1) * Math.cos(angle),
      vy: BALL_INIT_SPD * Math.sin(angle),
    };
  }

  function resetBall(towardPositive) {
    if (orientation === "vertical") {
      const angle = ((Math.random() * 40 - 20) * Math.PI) / 180;
      ball = {
        x: W / 2,
        y: H / 2,
        vx: BALL_INIT_SPD * Math.sin(angle),
        vy: BALL_INIT_SPD * (towardPositive ? 1 : -1) * Math.cos(angle),
      };
    } else {
      const v = newBallVelocity(towardPositive);
      ball = { x: W / 2, y: H / 2, vx: v.vx, vy: v.vy };
    }
  }

  function startGame() {
    cancelAnimationFrame(demoAnimId);
    demoAnimId = null;
    if (orientation === "vertical") {
      p1x = W / 2 - VPAD_W / 2;
      p2x = W / 2 - VPAD_W / 2;
    } else {
      p1y = H / 2 - PAD_H / 2;
      p2y = H / 2 - PAD_H / 2;
    }
    p1score = 0;
    p2score = 0;
    resetBall(Math.random() > 0.5);
    running = true;

    document.getElementById("p1-score").textContent = "0";
    document.getElementById("p2-score").textContent = "0";
    document.getElementById("orientation-row").style.display = "none";
    document.getElementById("mode-row").style.display = "none";
    document.getElementById("side-row").style.display = "none";
    document.getElementById("demo-label").style.display = "none";
    document.getElementById("overlay").style.display = "none";
    document.getElementById("gameover-overlay").style.display = "none";

    clearTimeout(pauseTimer);
    paused = false;
    pauseMsg = "";

    cancelAnimationFrame(animId);
    animId = requestAnimationFrame(gameLoop);
  }

  function drawScoreMsg() {
    const bx = W * 0.18,
      bw = W * 0.64,
      by = H * 0.36,
      bh = H * 0.28;
    ctx.save();
    ctx.fillStyle = "rgba(15,23,42,0.82)";
    ctx.beginPath();
    ctx.roundRect(bx, by, bw, bh, 10);
    ctx.fill();
    ctx.fillStyle = "#fbbf24";
    ctx.font = `bold ${Math.round(20 * S)}px system-ui, sans-serif`;
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText(pauseMsg, W / 2, H / 2);
    ctx.restore();
  }

  function gameLoop() {
    if (!running) return;
    if (!paused) {
      handleInput();
      updateBall();
    }
    const posA = orientation === "vertical" ? p1x : p1y;
    const posB = orientation === "vertical" ? p2x : p2y;
    drawScene(posA, posB, ball);
    if (paused) drawScoreMsg();
    if (running) animId = requestAnimationFrame(gameLoop);
  }

  function handleInput() {
    if (orientation === "vertical") {
      const lt = keys["a"] || keys["A"] || keys["ArrowLeft"];
      const rt = keys["d"] || keys["D"] || keys["ArrowRight"];
      if (gameMode === "pvp") {
        if (keys["a"] || keys["A"]) p1x = Math.max(0, p1x - PAD_SPEED);
        if (keys["d"] || keys["D"]) p1x = Math.min(W - VPAD_W, p1x + PAD_SPEED);
        if (keys["ArrowLeft"]) p2x = Math.max(0, p2x - PAD_SPEED);
        if (keys["ArrowRight"]) p2x = Math.min(W - VPAD_W, p2x + PAD_SPEED);
      } else if (playerSide === "left") {
        if (lt) p1x = Math.max(0, p1x - PAD_SPEED);
        if (rt) p1x = Math.min(W - VPAD_W, p1x + PAD_SPEED);
        const factor = ball.vy > 0 ? 0.09 : 0.04;
        p2x += (ball.x - VPAD_W / 2 - p2x) * factor;
        p2x = Math.max(0, Math.min(W - VPAD_W, p2x));
      } else {
        if (lt) p2x = Math.max(0, p2x - PAD_SPEED);
        if (rt) p2x = Math.min(W - VPAD_W, p2x + PAD_SPEED);
        const factor = ball.vy < 0 ? 0.09 : 0.04;
        p1x += (ball.x - VPAD_W / 2 - p1x) * factor;
        p1x = Math.max(0, Math.min(W - VPAD_W, p1x));
      }
    } else {
      const up = keys["w"] || keys["W"] || keys["ArrowUp"];
      const dn = keys["s"] || keys["S"] || keys["ArrowDown"];
      if (gameMode === "pvp") {
        if (keys["w"] || keys["W"]) p1y = Math.max(0, p1y - PAD_SPEED);
        if (keys["s"] || keys["S"]) p1y = Math.min(H - PAD_H, p1y + PAD_SPEED);
        if (keys["ArrowUp"]) p2y = Math.max(0, p2y - PAD_SPEED);
        if (keys["ArrowDown"]) p2y = Math.min(H - PAD_H, p2y + PAD_SPEED);
      } else if (playerSide === "left") {
        if (up) p1y = Math.max(0, p1y - PAD_SPEED);
        if (dn) p1y = Math.min(H - PAD_H, p1y + PAD_SPEED);
        const factor = ball.vx > 0 ? 0.09 : 0.04;
        p2y += (ball.y - PAD_H / 2 - p2y) * factor;
        p2y = Math.max(0, Math.min(H - PAD_H, p2y));
      } else {
        if (up) p2y = Math.max(0, p2y - PAD_SPEED);
        if (dn) p2y = Math.min(H - PAD_H, p2y + PAD_SPEED);
        const factor = ball.vx < 0 ? 0.09 : 0.04;
        p1y += (ball.y - PAD_H / 2 - p1y) * factor;
        p1y = Math.max(0, Math.min(H - PAD_H, p1y));
      }
    }
  }

  function scorePoint(p2got, pvpMsg, playerGotMsg) {
    if (p2got) {
      p2score++;
      document.getElementById("p2-score").textContent = p2score;
      if (p2score >= WIN_SCORE) {
        showEnd(false);
        return;
      }
    } else {
      p1score++;
      document.getElementById("p1-score").textContent = p1score;
      if (p1score >= WIN_SCORE) {
        showEnd(true);
        return;
      }
    }
    clearTimeout(pauseTimer);
    paused = true;
    pauseMsg = gameMode === "pvp" ? pvpMsg : playerGotMsg;
    pauseTimer = setTimeout(() => {
      paused = false;
      pauseMsg = "";
      resetBall(p2got);
    }, 1400);
  }

  function updateBall() {
    ball.x += ball.vx;
    ball.y += ball.vy;

    if (orientation === "vertical") {
      if (ball.x - BALL_R < 0) {
        ball.x = BALL_R;
        ball.vx = Math.abs(ball.vx);
      }
      if (ball.x + BALL_R > W) {
        ball.x = W - BALL_R;
        ball.vx = -Math.abs(ball.vx);
      }

      // P1 (top) paddle hit
      if (
        ball.vy < 0 &&
        ball.y - BALL_R <= VP1_Y + VPAD_H &&
        ball.y >= VP1_Y &&
        ball.x + BALL_R > p1x &&
        ball.x - BALL_R < p1x + VPAD_W
      ) {
        ball.y = VP1_Y + VPAD_H + BALL_R;
        const rel = (ball.x - (p1x + VPAD_W / 2)) / (VPAD_W / 2);
        const spd = Math.min(Math.abs(ball.vy) + BALL_SPEEDUP, BALL_MAX_SPD);
        ball.vy = spd;
        ball.vx = rel * 5.5 * S;
      }

      // P2 (bottom) paddle hit
      if (
        ball.vy > 0 &&
        ball.y + BALL_R >= VP2_Y &&
        ball.y <= VP2_Y + VPAD_H &&
        ball.x + BALL_R > p2x &&
        ball.x - BALL_R < p2x + VPAD_W
      ) {
        ball.y = VP2_Y - BALL_R;
        const rel = (ball.x - (p2x + VPAD_W / 2)) / (VPAD_W / 2);
        const spd = Math.min(Math.abs(ball.vy) + BALL_SPEEDUP, BALL_MAX_SPD);
        ball.vy = -spd;
        ball.vx = rel * 5.5 * S;
      }

      if (ball.y + BALL_R < 0)
        return scorePoint(true, "P2 scores! 🎉", playerSide === "right" ? "Nice shot! 🎉" : "AI gets one…");
      if (ball.y - BALL_R > H)
        return scorePoint(false, "P1 scores! 🎉", playerSide === "left" ? "Nice shot! 🎉" : "AI gets one…");
    } else {
      if (ball.y - BALL_R < 0) {
        ball.y = BALL_R;
        ball.vy = Math.abs(ball.vy);
      }
      if (ball.y + BALL_R > H) {
        ball.y = H - BALL_R;
        ball.vy = -Math.abs(ball.vy);
      }

      // P1 paddle hit
      if (
        ball.vx < 0 &&
        ball.x - BALL_R <= P1_X + PAD_W &&
        ball.x >= P1_X &&
        ball.y + BALL_R > p1y &&
        ball.y - BALL_R < p1y + PAD_H
      ) {
        ball.x = P1_X + PAD_W + BALL_R;
        const rel = (ball.y - (p1y + PAD_H / 2)) / (PAD_H / 2);
        const spd = Math.min(Math.abs(ball.vx) + BALL_SPEEDUP, BALL_MAX_SPD);
        ball.vx = spd;
        ball.vy = rel * 5.5 * S;
      }

      // P2 paddle hit
      if (
        ball.vx > 0 &&
        ball.x + BALL_R >= P2_X &&
        ball.x <= P2_X + PAD_W &&
        ball.y + BALL_R > p2y &&
        ball.y - BALL_R < p2y + PAD_H
      ) {
        ball.x = P2_X - BALL_R;
        const rel = (ball.y - (p2y + PAD_H / 2)) / (PAD_H / 2);
        const spd = Math.min(Math.abs(ball.vx) + BALL_SPEEDUP, BALL_MAX_SPD);
        ball.vx = -spd;
        ball.vy = rel * 5.5 * S;
      }

      if (ball.x + BALL_R < 0)
        return scorePoint(true, "P2 scores! 🎉", playerSide === "right" ? "Nice shot! 🎉" : "AI gets one…");
      if (ball.x - BALL_R > W)
        return scorePoint(false, "P1 scores! 🎉", playerSide === "left" ? "Nice shot! 🎉" : "AI gets one…");
    }
  }

  function drawScene(posA, posB, db) {
    ctx.fillStyle = "#0f172a";
    ctx.fillRect(0, 0, W, H);

    ctx.strokeStyle = "#1e293b";
    ctx.lineWidth = Math.max(1, Math.round(2 * S));
    ctx.setLineDash([Math.round(10 * S), Math.round(10 * S)]);
    ctx.beginPath();
    if (orientation === "vertical") {
      ctx.moveTo(0, H / 2);
      ctx.lineTo(W, H / 2);
    } else {
      ctx.moveTo(W / 2, 0);
      ctx.lineTo(W / 2, H);
    }
    ctx.stroke();
    ctx.setLineDash([]);

    if (orientation === "vertical") {
      ctx.fillStyle = "#60a5fa";
      ctx.beginPath();
      ctx.roundRect(posA, VP1_Y, VPAD_W, VPAD_H, 4);
      ctx.fill();
      ctx.fillStyle = "#f87171";
      ctx.beginPath();
      ctx.roundRect(posB, VP2_Y, VPAD_W, VPAD_H, 4);
      ctx.fill();
    } else {
      ctx.fillStyle = "#60a5fa";
      ctx.beginPath();
      ctx.roundRect(P1_X, posA, PAD_W, PAD_H, 4);
      ctx.fill();
      ctx.fillStyle = "#f87171";
      ctx.beginPath();
      ctx.roundRect(P2_X, posB, PAD_W, PAD_H, 4);
      ctx.fill();
    }

    ctx.fillStyle = "#f8fafc";
    ctx.beginPath();
    ctx.arc(db.x, db.y, BALL_R, 0, Math.PI * 2);
    ctx.fill();
  }

  function showEnd(p1Won) {
    running = false;
    cancelAnimationFrame(animId);
    drawScene(orientation === "vertical" ? p1x : p1y, orientation === "vertical" ? p2x : p2y, ball);

    const playerWon = gameMode === "pvp" ? p1Won : playerSide === "left" ? p1Won : !p1Won;

    if (playerWon && gameMode === "ai") {
      wins++;
      localStorage.setItem(STORAGE_KEY, wins);
      document.getElementById("best-display").textContent = wins;
      launchConfetti();
    }

    let icon, title;
    if (gameMode === "pvp") {
      icon = "🏆";
      title = p1Won ? "P1 Wins!" : "P2 Wins!";
    } else {
      icon = playerWon ? "🏆" : "💀";
      title = playerWon ? "You Win!" : "AI Wins!";
    }
    document.getElementById("go-icon").textContent = icon;
    document.getElementById("go-title").textContent = title;

    const showP1 = gameMode === "ai" && playerSide === "right" ? p2score : p1score;
    const showP2 = gameMode === "ai" && playerSide === "right" ? p1score : p2score;
    document.getElementById("go-p1").textContent = showP1;
    document.getElementById("go-p2").textContent = showP2;
    document.getElementById("go-wins").textContent = wins;
    document.getElementById("go-mode").textContent = gameMode === "ai" ? "vs AI" : "vs Player";

    document.getElementById("orientation-row").style.display = "flex";
    document.getElementById("mode-row").style.display = "flex";
    document.getElementById("side-row").style.display = gameMode === "ai" ? "flex" : "none";
    document.getElementById("overlay").style.display = "none";
    document.getElementById("gameover-overlay").style.display = "flex";
  }

  // Demo: AI vs AI
  function startDemo() {
    if (orientation === "vertical") {
      let dpA = W / 2 - VPAD_W / 2;
      let dpB = W / 2 - VPAD_W / 2;
      const a = ((Math.random() * 40 - 20) * Math.PI) / 180;
      let db = {
        x: W / 2,
        y: H / 2,
        vx: BALL_INIT_SPD * Math.sin(a),
        vy: BALL_INIT_SPD * (Math.random() > 0.5 ? 1 : -1) * Math.cos(a),
      };

      function demoLoopV() {
        const f1 = db.vy < 0 ? 0.09 : 0.04;
        const f2 = db.vy > 0 ? 0.09 : 0.04;
        dpA += (db.x - VPAD_W / 2 - dpA) * f1;
        dpB += (db.x - VPAD_W / 2 - dpB) * f2;
        dpA = Math.max(0, Math.min(W - VPAD_W, dpA));
        dpB = Math.max(0, Math.min(W - VPAD_W, dpB));

        db.x += db.vx;
        db.y += db.vy;

        if (db.x - BALL_R < 0) {
          db.x = BALL_R;
          db.vx = Math.abs(db.vx);
        }
        if (db.x + BALL_R > W) {
          db.x = W - BALL_R;
          db.vx = -Math.abs(db.vx);
        }

        if (
          db.vy < 0 &&
          db.y - BALL_R <= VP1_Y + VPAD_H &&
          db.y >= VP1_Y &&
          db.x + BALL_R > dpA &&
          db.x - BALL_R < dpA + VPAD_W
        ) {
          db.y = VP1_Y + VPAD_H + BALL_R;
          const rel = (db.x - (dpA + VPAD_W / 2)) / (VPAD_W / 2);
          const spd = Math.min(Math.abs(db.vy) + BALL_SPEEDUP * 0.5, BALL_MAX_SPD * 0.7);
          db.vy = spd;
          db.vx = rel * 4 * S;
        }

        if (
          db.vy > 0 &&
          db.y + BALL_R >= VP2_Y &&
          db.y <= VP2_Y + VPAD_H &&
          db.x + BALL_R > dpB &&
          db.x - BALL_R < dpB + VPAD_W
        ) {
          db.y = VP2_Y - BALL_R;
          const rel = (db.x - (dpB + VPAD_W / 2)) / (VPAD_W / 2);
          const spd = Math.min(Math.abs(db.vy) + BALL_SPEEDUP * 0.5, BALL_MAX_SPD * 0.7);
          db.vy = -spd;
          db.vx = rel * 4 * S;
        }

        if (db.y + BALL_R < 0 || db.y - BALL_R > H) {
          const a2 = ((Math.random() * 40 - 20) * Math.PI) / 180;
          db = {
            x: W / 2,
            y: H / 2,
            vx: BALL_INIT_SPD * Math.sin(a2),
            vy: BALL_INIT_SPD * (db.y < 0 ? 1 : -1) * Math.cos(a2),
          };
          dpA = W / 2 - VPAD_W / 2;
          dpB = W / 2 - VPAD_W / 2;
        }

        drawScene(dpA, dpB, db);
        demoAnimId = requestAnimationFrame(demoLoopV);
      }

      drawScene(dpA, dpB, db);
      demoAnimId = requestAnimationFrame(demoLoopV);
    } else {
      let dp1y = H / 2 - PAD_H / 2;
      let dp2y = H / 2 - PAD_H / 2;
      const v = newBallVelocity(Math.random() > 0.5);
      let db = { x: W / 2, y: H / 2, vx: v.vx, vy: v.vy };

      function demoLoop() {
        const f1 = db.vx < 0 ? 0.09 : 0.04;
        const f2 = db.vx > 0 ? 0.09 : 0.04;
        dp1y += (db.y - PAD_H / 2 - dp1y) * f1;
        dp2y += (db.y - PAD_H / 2 - dp2y) * f2;
        dp1y = Math.max(0, Math.min(H - PAD_H, dp1y));
        dp2y = Math.max(0, Math.min(H - PAD_H, dp2y));

        db.x += db.vx;
        db.y += db.vy;

        if (db.y - BALL_R < 0) {
          db.y = BALL_R;
          db.vy = Math.abs(db.vy);
        }
        if (db.y + BALL_R > H) {
          db.y = H - BALL_R;
          db.vy = -Math.abs(db.vy);
        }

        if (
          db.vx < 0 &&
          db.x - BALL_R <= P1_X + PAD_W &&
          db.x >= P1_X &&
          db.y + BALL_R > dp1y &&
          db.y - BALL_R < dp1y + PAD_H
        ) {
          db.x = P1_X + PAD_W + BALL_R;
          const rel = (db.y - (dp1y + PAD_H / 2)) / (PAD_H / 2);
          const spd = Math.min(Math.abs(db.vx) + BALL_SPEEDUP * 0.5, BALL_MAX_SPD * 0.7);
          db.vx = spd;
          db.vy = rel * 4 * S;
        }

        if (
          db.vx > 0 &&
          db.x + BALL_R >= P2_X &&
          db.x <= P2_X + PAD_W &&
          db.y + BALL_R > dp2y &&
          db.y - BALL_R < dp2y + PAD_H
        ) {
          db.x = P2_X - BALL_R;
          const rel = (db.y - (dp2y + PAD_H / 2)) / (PAD_H / 2);
          const spd = Math.min(Math.abs(db.vx) + BALL_SPEEDUP * 0.5, BALL_MAX_SPD * 0.7);
          db.vx = -spd;
          db.vy = rel * 4 * S;
        }

        if (db.x + BALL_R < 0 || db.x - BALL_R > W) {
          const dir = db.x < 0 ? 1 : -1;
          const nv = newBallVelocity(dir > 0);
          db = { x: W / 2, y: H / 2, vx: nv.vx, vy: nv.vy };
          dp1y = H / 2 - PAD_H / 2;
          dp2y = H / 2 - PAD_H / 2;
        }

        drawScene(dp1y, dp2y, db);
        demoAnimId = requestAnimationFrame(demoLoop);
      }

      drawScene(dp1y, dp2y, db);
      demoAnimId = requestAnimationFrame(demoLoop);
    }
  }

  // Touch controls
  const activeTouches = {};

  canvas.addEventListener(
    "touchstart",
    (e) => {
      e.preventDefault();
      if (!running) return;
      const rect = canvas.getBoundingClientRect();
      for (const t of e.changedTouches) {
        const cx = t.clientX - rect.left;
        const cy = t.clientY - rect.top;
        const tx = cx * (W / rect.width);
        const ty = cy * (H / rect.height);
        let target = null;
        if (orientation === "vertical") {
          const isTop = cy < rect.height / 2;
          if (gameMode === "pvp") target = isTop ? "p1" : "p2";
          else if (playerSide === "left" && isTop) target = "p1";
          else if (playerSide === "right" && !isTop) target = "p2";
          activeTouches[t.identifier] = target;
          if (target === "p1") p1x = Math.max(0, Math.min(W - VPAD_W, tx - VPAD_W / 2));
          else if (target === "p2") p2x = Math.max(0, Math.min(W - VPAD_W, tx - VPAD_W / 2));
        } else {
          const isLeft = cx < rect.width / 2;
          if (gameMode === "pvp") target = isLeft ? "p1" : "p2";
          else if (playerSide === "left" && isLeft) target = "p1";
          else if (playerSide === "right" && !isLeft) target = "p2";
          activeTouches[t.identifier] = target;
          if (target === "p1") p1y = Math.max(0, Math.min(H - PAD_H, ty - PAD_H / 2));
          else if (target === "p2") p2y = Math.max(0, Math.min(H - PAD_H, ty - PAD_H / 2));
        }
      }
    },
    { passive: false }
  );

  canvas.addEventListener(
    "touchmove",
    (e) => {
      e.preventDefault();
      if (!running) return;
      const rect = canvas.getBoundingClientRect();
      for (const t of e.changedTouches) {
        const tx = (t.clientX - rect.left) * (W / rect.width);
        const ty = (t.clientY - rect.top) * (H / rect.height);
        if (orientation === "vertical") {
          if (activeTouches[t.identifier] === "p1") p1x = Math.max(0, Math.min(W - VPAD_W, tx - VPAD_W / 2));
          else if (activeTouches[t.identifier] === "p2") p2x = Math.max(0, Math.min(W - VPAD_W, tx - VPAD_W / 2));
        } else {
          if (activeTouches[t.identifier] === "p1") p1y = Math.max(0, Math.min(H - PAD_H, ty - PAD_H / 2));
          else if (activeTouches[t.identifier] === "p2") p2y = Math.max(0, Math.min(H - PAD_H, ty - PAD_H / 2));
        }
      }
    },
    { passive: false }
  );

  canvas.addEventListener("touchend", (e) => {
    for (const t of e.changedTouches) delete activeTouches[t.identifier];
  });

  // Keyboard
  document.addEventListener("keydown", (e) => {
    if (["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", " "].includes(e.key)) e.preventDefault();
    keys[e.key] = true;
  });
  document.addEventListener("keyup", (e) => {
    delete keys[e.key];
  });

  // Start with demo on load
  setOrientation("horizontal");
  updateLabels();
  updateControlsHint();
  startDemo();
</script>
