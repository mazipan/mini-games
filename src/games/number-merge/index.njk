---
layout: layouts/game.njk
title: Number Merge
description: Drop tiles into columns — equal neighbors merge into their sum, chaining combos!
category: puzzle
icon: "🔢"
---

{% from "macros/game-components.njk" import statCard, summaryStatCard, infoDetails %}

<style>
  :root {
    --tile: min(52px, calc((100vw - 3rem) / 7.5));
  }
  #game-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: calc(100vh - 60px);
    gap: 1rem;
    padding: 1rem;
  }
  .score-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    min-width: 70px;
  }
  .stat-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .stat-value {
    font-size: 1.2rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  #next-preview {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  #next-tile {
    width: var(--tile);
    height: var(--tile);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-family: monospace;
    font-size: calc(var(--tile) * 0.32);
    border: 2px solid #334155;
  }
  #board-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    user-select: none;
  }
  /* Active falling tile in the grid */
  .grid-cell.falling {
    color: inherit;
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.35);
  }
  /* D-pad controls */
  #dpad {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
  }
  .dpad-btn {
    width: 54px;
    height: 54px;
    font-size: 1.4rem;
    background: #1e293b;
    border: 2px solid #334155;
    border-radius: 8px;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
  .dpad-btn:active {
    background: #334155;
  }
  #grid {
    display: grid;
    grid-template-columns: repeat(7, var(--tile));
    grid-template-rows: repeat(8, var(--tile));
    gap: 3px;
    background: #0f172a;
    border-radius: 8px;
    padding: 6px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
    cursor: pointer;
  }
  .grid-cell {
    width: var(--tile);
    height: var(--tile);
    border-radius: 6px;
    background: #1e293b;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-family: monospace;
    font-size: calc(var(--tile) * 0.3);
    transition:
      background 0.12s,
      color 0.12s;
    color: transparent;
  }
  .grid-cell.filled {
    color: inherit;
  }
  .grid-cell.ghost {
    opacity: 0.28;
    color: inherit;
  }
  /* Col hover highlight */
  .grid-cell.col-hover {
    background: #263348;
  }
  /* Tile value colors */
  .grid-cell[data-v="2"] {
    background: #1e3a2f;
    color: #4ade80;
  }
  .grid-cell[data-v="4"] {
    background: #1e3a4f;
    color: #60a5fa;
  }
  .grid-cell[data-v="8"] {
    background: #312e81;
    color: #a78bfa;
  }
  .grid-cell[data-v="16"] {
    background: #4c1d95;
    color: #c4b5fd;
  }
  .grid-cell[data-v="32"] {
    background: #7c2d12;
    color: #fdba74;
  }
  .grid-cell[data-v="64"] {
    background: #92400e;
    color: #fcd34d;
  }
  .grid-cell[data-v="128"] {
    background: #78350f;
    color: #fef08a;
  }
  .grid-cell[data-v="256"] {
    background: #854d0e;
    color: #fef9c3;
  }
  .grid-cell[data-v="512"] {
    background: #713f12;
    color: #fff;
  }
  .grid-cell[data-v="1024"] {
    background: linear-gradient(135deg, #7c3aed, #db2777);
    color: #fff;
  }
  .grid-cell[data-v="2048"] {
    background: linear-gradient(135deg, #7c3aed, #db2777);
    color: #fff;
  }
  .grid-cell[data-v="4096"] {
    background: linear-gradient(135deg, #7c3aed, #db2777);
    color: #fff;
  }
  .grid-cell[data-v="8192"] {
    background: linear-gradient(135deg, #7c3aed, #db2777);
    color: #fff;
  }
  .grid-cell.pop {
    animation: cellpop 0.2s ease-out;
  }
  @keyframes cellpop {
    0% {
      transform: scale(1);
    }
    45% {
      transform: scale(1.22);
    }
    100% {
      transform: scale(1);
    }
  }
  /* Squeeze-in just before two tiles merge */
  .grid-cell.pre-merge {
    animation: pre-merge 0.12s ease-in-out forwards;
  }
  @keyframes pre-merge {
    0% {
      transform: scale(1);
    }
    60% {
      transform: scale(0.82);
    }
    100% {
      transform: scale(0.88);
    }
  }
  .controls-hint {
    font-size: 0.72rem;
    color: #475569;
    text-align: center;
  }
  .new-btn {
    padding: 0.4rem 1rem;
    background: #334155;
    color: #e2e8f0;
    border: none;
    border-radius: 6px;
    font-size: 0.85rem;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .new-btn:hover {
    background: #475569;
  }
  /* Overlays */
  .full-overlay {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    z-index: 200;
    padding: 1rem;
    text-align: center;
  }
  #start-overlay {
    background: rgba(15, 23, 42, 0.97);
  }
  #gameover-overlay {
    background: rgba(15, 23, 42, 0.95);
  }
  .full-overlay h2 {
    font-size: 1.8rem;
    font-weight: 700;
    color: #e2e8f0;
    margin: 0;
  }
  .full-overlay p {
    color: #94a3b8;
    font-size: 0.9rem;
    margin: 0;
  }
  .play-btn {
    padding: 0.5rem 1.5rem;
    background: #7c3aed;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .play-btn:hover {
    background: #6d28d9;
  }
  .summary-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .summary-stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.5rem 1.2rem;
    min-width: 70px;
  }
  .summary-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .summary-value {
    font-size: 1.4rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  #go-context {
    color: #94a3b8;
    font-size: 0.9rem;
    margin: 0;
  }
  /* Info section */
  .info-section {
    width: 100%;
    max-width: 440px;
    padding: 0 1rem 2rem;
    margin: 0 auto;
  }
  .info-details {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    margin-bottom: 0.75rem;
    overflow: hidden;
  }
  .info-details summary {
    padding: 0.75rem 1rem;
    font-weight: 600;
    color: #e2e8f0;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
  }
  .info-details summary::-webkit-details-marker {
    display: none;
  }
  .info-details summary::after {
    content: "+";
    font-size: 1.1rem;
    color: #64748b;
  }
  .info-details[open] summary::after {
    content: "−";
  }
  .info-body {
    padding: 0.75rem 1rem 1rem;
    color: #94a3b8;
    font-size: 0.875rem;
    line-height: 1.6;
    border-top: 1px solid #334155;
  }
  .info-body h4 {
    color: #e2e8f0;
    font-weight: 600;
    margin: 0.75rem 0 0.25rem;
    font-size: 0.875rem;
  }
  .info-body h4:first-child {
    margin-top: 0;
  }
  .info-body ul {
    padding-left: 1.25rem;
    margin: 0.25rem 0;
  }
  .info-body li {
    margin-bottom: 0.25rem;
  }
  .info-body p {
    margin: 0.25rem 0;
  }
  #level-toast {
    position: fixed;
    top: 4.5rem;
    left: 50%;
    transform: translateX(-50%) translateY(-12px);
    background: #7c3aed;
    color: #fff;
    padding: 0.3rem 1rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    pointer-events: none;
    z-index: 500;
    opacity: 0;
    transition:
      opacity 0.2s,
      transform 0.2s;
    white-space: nowrap;
  }
  #level-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
</style>

<div id="game-wrapper">
  <div class="score-row">
    {{ statCard("Score", "score", "0") }} {{ statCard("Best", "best-display", "0") }} {{ statCard("Level",
    "level-display", "1") }}
  </div>

  <div id="level-toast"></div>

  <div id="next-preview">
    <span>Next</span>
    <div id="next-tile">2</div>
  </div>

  <div id="board-area">
    <div id="grid"></div>
  </div>

  <div id="dpad">
    <button class="dpad-btn" onclick="moveLeft()">⬅️</button>
    <button class="dpad-btn" onclick="dropNow()">⬇️</button>
    <button class="dpad-btn" onclick="moveRight()">➡️</button>
  </div>

  <p class="controls-hint">⬅️ ➡️ to move · ⬇️ to drop · click a column to drop there</p>
  <button class="new-btn" onclick="startGame()">New Game</button>
</div>

<div id="start-overlay" class="full-overlay">
  <span style="font-size: 3rem">🔢</span>
  <h2>Number Merge</h2>
  <p>Aim with ← → and drop tiles — equal neighbors merge!</p>
  <button class="play-btn" onclick="startGame()">Play Game</button>
</div>

<div id="gameover-overlay" class="full-overlay" style="display: none">
  <span id="go-icon" style="font-size: 3rem">💀</span>
  <h2 id="go-title">Game Over</h2>
  <div class="summary-row">
    <div class="summary-stat">
      <div class="summary-label">Score</div>
      <div class="summary-value" id="go-score">0</div>
    </div>
    <div class="summary-stat">
      <div class="summary-label">Best</div>
      <div class="summary-value" id="go-best">0</div>
    </div>
    <div class="summary-stat">
      <div class="summary-label">Level</div>
      <div class="summary-value" id="go-level">1</div>
    </div>
  </div>
  <p id="go-context">A column is full!</p>
  <button class="play-btn" onclick="startGame()">New Game</button>
</div>

<div class="info-section">
  {% call infoDetails("How to Play") %}
  <h4>Goal</h4>
  <p>
    Aim numbered tiles and drop them into columns. When two equal tiles sit at the top of adjacent columns, they
    <strong>merge</strong> into their sum. Score as many points as you can before any column fills up!
  </p>
  <h4>Controls</h4>
  <ul>
    <li><strong>← → arrow keys</strong> — move the falling tile left or right</li>
    <li><strong>↓ / Space / Enter</strong> — drop the tile into the selected column</li>
    <li><strong>Click a grid column</strong> — aim and drop into that column</li>
  </ul>
  <h4>Scoring</h4>
  <p>
    Each merge earns you the value of the newly merged tile. Combos — where one drop triggers several merges in a row —
    multiply your score quickly.
  </p>
  <h4>Levels</h4>
  <p>
    Every 10 merges you advance a level. Higher levels introduce larger-value tiles into the mix, making combos more
    achievable but the board harder to manage.
  </p>
  {% endcall %} {% call infoDetails("FAQ") %}
  <h4>How do merges work?</h4>
  <p>
    After a tile lands in a column, the game checks if the tile on top of the <em>left</em> neighbor column has the same
    value. If so, they merge. The check then repeats — potentially chaining multiple merges from a single drop.
  </p>
  <h4>What is a combo?</h4>
  <p>
    A combo is a chain of merges triggered by a single tile drop. Each merge re-checks both neighbors, so a single drop
    can trigger several merges back-to-back, scoring all of them.
  </p>
  <h4>Is my best score saved?</h4>
  <p>Yes — your all-time best score is automatically saved in your browser's local storage.</p>
  <h4>When does the game end?</h4>
  <p>The game ends immediately when any column reaches 8 tiles (the maximum column height).</p>
  {% endcall %}
</div>

<script>
  // ─── Confetti ────────────────────────────────────────────────────────────
  function launchConfetti() {
    const canvas = document.createElement("canvas");
    canvas.style.cssText = "position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999";
    document.body.appendChild(canvas);
    const ctx = canvas.getContext("2d");
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    const colors = ["#ef4444", "#fbbf24", "#10b981", "#3b82f6", "#a78bfa", "#f97316", "#ec4899"];
    const pieces = Array.from({ length: 80 }, () => ({
      x: Math.random() * canvas.width,
      y: -10 - Math.random() * 40,
      r: Math.random() * 6 + 3,
      color: colors[Math.floor(Math.random() * colors.length)],
      vx: (Math.random() - 0.5) * 5,
      vy: Math.random() * 4 + 2,
      angle: Math.random() * Math.PI * 2,
      va: (Math.random() - 0.5) * 0.15,
    }));
    const start = performance.now();
    function draw(now) {
      if (now - start > 3000) {
        canvas.remove();
        return;
      }
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      pieces.forEach((p) => {
        p.x += p.vx;
        p.y += p.vy;
        p.angle += p.va;
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.angle);
        ctx.fillStyle = p.color;
        ctx.fillRect(-p.r, -p.r / 2, p.r * 2, p.r);
        ctx.restore();
      });
      requestAnimationFrame(draw);
    }
    requestAnimationFrame(draw);
  }

  // ─── Constants ────────────────────────────────────────────────────────────
  const ROWS = 8;
  const COLS = 7;
  const STORAGE_KEY = "mini-number-merge-best";
  const FALL_SPEED_MS = 800; // ms per auto-fall step

  // ─── State ────────────────────────────────────────────────────────────────
  let cols; // cols[c] = array of tile values, index 0 = bottom
  let score;
  let best = parseInt(localStorage.getItem(STORAGE_KEY) || "0", 10);
  let level;
  let mergeCount;
  let nextVal;
  let currentVal; // the tile currently falling through the grid
  let selectedCol;
  let fallingRow; // current row (0 = top of grid)
  let fallTimer; // setInterval handle
  let dropping = false; // brief lock-delay flag
  let gameActive;

  document.getElementById("best-display").textContent = best;

  // ─── Tile value generation ────────────────────────────────────────────────
  // Each pool entry is [value, weight]. Higher levels unlock bigger tiles but
  // small values are always in the mix (just less probable).
  const TILE_POOLS = [
    [[2, 10]], // L1 — only 2s while learning
    [
      [2, 8],
      [4, 2],
    ], // L2 — mostly 2, occasional 4
    [
      [2, 6],
      [4, 3],
      [8, 1],
    ], // L3
    [
      [2, 5],
      [4, 3],
      [8, 2],
      [16, 1],
    ], // L4
    [
      [2, 5],
      [4, 3],
      [8, 2],
      [16, 2],
      [32, 1],
    ], // L5
    [
      [2, 4],
      [4, 3],
      [8, 2],
      [16, 2],
      [32, 1],
      [64, 1],
    ], // L6
    [
      [2, 4],
      [4, 3],
      [8, 2],
      [16, 2],
      [32, 2],
      [64, 1],
      [128, 1],
    ], // L7+
  ];

  function nextTileValue() {
    const pool = TILE_POOLS[Math.min(level - 1, TILE_POOLS.length - 1)];
    const total = pool.reduce((s, [, w]) => s + w, 0);
    let pick = Math.random() * total;
    for (const [val, w] of pool) {
      pick -= w;
      if (pick <= 0) return val;
    }
    return pool[pool.length - 1][0];
  }

  // ─── Tile style helper ────────────────────────────────────────────────────
  const TILE_STYLES = {
    2: { bg: "#1e3a2f", color: "#4ade80" },
    4: { bg: "#1e3a4f", color: "#60a5fa" },
    8: { bg: "#312e81", color: "#a78bfa" },
    16: { bg: "#4c1d95", color: "#c4b5fd" },
    32: { bg: "#7c2d12", color: "#fdba74" },
    64: { bg: "#92400e", color: "#fcd34d" },
    128: { bg: "#78350f", color: "#fef08a" },
    256: { bg: "#854d0e", color: "#fef9c3" },
    512: { bg: "#713f12", color: "#fff" },
  };
  function applyTileStyle(el, val) {
    const s = TILE_STYLES[val] || { bg: "linear-gradient(135deg,#7c3aed,#db2777)", color: "#fff" };
    el.style.background = s.bg;
    el.style.color = s.color;
    el.textContent = val;
  }

  // ─── Landing row helper ───────────────────────────────────────────────────
  function landRow(c) {
    return ROWS - 1 - cols[c].length; // row 0 = top, ROWS-1 = bottom
  }

  // ─── Merge helpers ────────────────────────────────────────────────────────
  function recordMerge(val) {
    score += val;
    mergeCount++;
  }

  let levelToastTimer = null;
  function showLevelToast(lvl) {
    const el = document.getElementById("level-toast");
    el.textContent = `Level ${lvl}!`;
    el.classList.add("show");
    clearTimeout(levelToastTimer);
    levelToastTimer = setTimeout(() => el.classList.remove("show"), 1600);
  }

  function getCellEl(c, visualRow) {
    const grid = document.getElementById("grid");
    return grid.children[visualRow * COLS + c] || null;
  }

  function flashClass(el, cls, ms) {
    if (!el) return;
    el.classList.remove(cls);
    void el.offsetWidth; // restart animation if already running
    el.classList.add(cls);
    setTimeout(() => el.classList.remove(cls), ms);
  }

  function wait(ms) {
    return new Promise((r) => setTimeout(r, ms));
  }

  // ─── Animated merge cascade ───────────────────────────────────────────────
  // Each merge step: squeeze source cells (120 ms) → execute → pop result (180 ms).
  // dropping=true throughout so no other input can fire.
  async function doMergesAnimated() {
    let anyMerge = true;
    while (anyMerge) {
      anyMerge = false;
      if (!gameActive) break;

      // Vertical: find first adjacent equal pair in a column (top-down)
      let found = false;
      vertLoop: for (let c = 0; c < COLS; c++) {
        for (let i = cols[c].length - 1; i >= 1; i--) {
          if (cols[c][i] === cols[c][i - 1]) {
            const rowHigh = ROWS - 1 - i;
            const rowLow = ROWS - 1 - (i - 1);
            flashClass(getCellEl(c, rowHigh), "pre-merge", 180);
            flashClass(getCellEl(c, rowLow), "pre-merge", 180);
            await wait(120);
            const val = cols[c][i - 1] * 2;
            cols[c].splice(i - 1, 2, val);
            recordMerge(val);
            renderGrid();
            flashClass(getCellEl(c, rowLow), "pop", 250);
            await wait(180);
            anyMerge = true;
            found = true;
            break vertLoop;
          }
        }
      }
      if (found) continue;

      // Horizontal: equal tiles at same stack index in adjacent columns
      horizLoop: for (let c = 0; c < COLS - 1; c++) {
        const minH = Math.min(cols[c].length, cols[c + 1].length);
        for (let i = minH - 1; i >= 0; i--) {
          if (cols[c][i] === cols[c + 1][i]) {
            const vRow = ROWS - 1 - i;
            flashClass(getCellEl(c, vRow), "pre-merge", 180);
            flashClass(getCellEl(c + 1, vRow), "pre-merge", 180);
            await wait(120);
            const val = cols[c][i] * 2;
            cols[c].splice(i, 1);
            cols[c + 1][i] = val;
            recordMerge(val);
            renderGrid();
            flashClass(getCellEl(c + 1, ROWS - 1 - i), "pop", 250);
            await wait(180);
            anyMerge = true;
            found = true;
            break horizLoop;
          }
        }
      }
    }
  }

  // ─── Auto-fall step ───────────────────────────────────────────────────────
  function stepFall() {
    if (!gameActive || dropping) return;
    const lr = landRow(selectedCol);
    if (fallingRow < lr) {
      fallingRow++;
      renderGrid();
    } else {
      // Reached the stack — lock with brief visual delay
      clearInterval(fallTimer);
      dropping = true;
      setTimeout(() => lockTile(), 80);
    }
  }

  function startFall() {
    fallingRow = 0;
    clearInterval(fallTimer);
    fallTimer = setInterval(stepFall, FALL_SPEED_MS);
    renderGrid();
  }

  // ─── Lock tile into column ────────────────────────────────────────────────
  async function lockTile() {
    if (!gameActive) return;
    cols[selectedCol].push(currentVal);
    renderGrid(); // show tile landed before merges start

    await doMergesAnimated();
    if (!gameActive) return; // game may have ended during animation

    document.getElementById("score").textContent = score;

    if (score > best) {
      best = score;
      localStorage.setItem(STORAGE_KEY, best);
      document.getElementById("best-display").textContent = best;
      launchConfetti();
    }

    const newLevel = Math.min(10, 1 + Math.floor(mergeCount / 10));
    if (newLevel !== level) {
      level = newLevel;
      document.getElementById("level-display").textContent = level;
      showLevelToast(level);
    }

    if (cols.some((col) => col.length >= ROWS)) {
      dropping = false;
      endGame();
      return;
    }

    currentVal = nextVal;
    nextVal = nextTileValue();
    updateNextPreview();
    dropping = false;
    startFall();
  }

  // ─── Hard drop ────────────────────────────────────────────────────────────
  function dropNow() {
    if (!gameActive || dropping) return;
    clearInterval(fallTimer);
    const lr = landRow(selectedCol);
    if (lr < 0) return;
    fallingRow = lr;
    renderGrid();
    dropping = true;
    setTimeout(() => lockTile(), 80);
  }

  // ─── Move tile left / right ───────────────────────────────────────────────
  function moveLeft() {
    if (!gameActive || dropping) return;
    const newCol = selectedCol - 1;
    if (newCol < 0) return;
    if (fallingRow > landRow(newCol)) return; // blocked by taller stack
    selectedCol = newCol;
    renderGrid();
  }

  function moveRight() {
    if (!gameActive || dropping) return;
    const newCol = selectedCol + 1;
    if (newCol >= COLS) return;
    if (fallingRow > landRow(newCol)) return;
    selectedCol = newCol;
    renderGrid();
  }

  // ─── Game over ────────────────────────────────────────────────────────────
  function endGame() {
    gameActive = false;
    clearInterval(fallTimer);
    document.getElementById("go-score").textContent = score;
    document.getElementById("go-best").textContent = best;
    document.getElementById("go-level").textContent = level;
    document.getElementById("go-icon").textContent = "💀";
    document.getElementById("go-title").textContent = "Game Over";
    document.getElementById("go-context").textContent = "A column is full!";
    renderGrid();
    setTimeout(() => {
      document.getElementById("gameover-overlay").style.display = "flex";
    }, 400);
  }

  // ─── Start / reset ────────────────────────────────────────────────────────
  function startGame() {
    clearInterval(fallTimer);
    cols = Array.from({ length: COLS }, () => []);
    score = 0;
    level = 1;
    mergeCount = 0;
    selectedCol = 3;
    dropping = false;
    gameActive = true;

    currentVal = nextTileValue();
    nextVal = nextTileValue();
    updateNextPreview();

    document.getElementById("score").textContent = 0;
    document.getElementById("best-display").textContent = best;
    document.getElementById("level-display").textContent = 1;
    document.getElementById("start-overlay").style.display = "none";
    document.getElementById("gameover-overlay").style.display = "none";

    startFall();
  }

  // ─── Next tile preview ────────────────────────────────────────────────────
  function updateNextPreview() {
    applyTileStyle(document.getElementById("next-tile"), nextVal);
  }

  // ─── Render grid ──────────────────────────────────────────────────────────
  function renderGrid() {
    const grid = document.getElementById("grid");
    if (grid.children.length !== ROWS * COLS) {
      grid.innerHTML = "";
      for (let row = 0; row < ROWS; row++) {
        for (let c = 0; c < COLS; c++) {
          const cell = document.createElement("div");
          cell.className = "grid-cell";
          cell.dataset.row = row;
          cell.dataset.col = c;
          grid.appendChild(cell);
        }
      }
    }

    const lr = gameActive ? landRow(selectedCol) : -1;

    let idx = 0;
    for (let row = 0; row < ROWS; row++) {
      for (let c = 0; c < COLS; c++) {
        const cell = grid.children[idx++];
        const dataIdx = ROWS - 1 - row; // cols[c][0] is bottom; row 0 is top
        const val = cols[c][dataIdx];

        cell.className = "grid-cell";
        cell.removeAttribute("data-v");
        cell.textContent = "";
        cell.style.background = "";
        cell.style.color = "";
        cell.onclick = null;

        if (val !== undefined) {
          cell.dataset.v = val;
          cell.textContent = val;
          cell.classList.add("filled");
        } else if (gameActive && c === selectedCol && row === fallingRow) {
          // The tile currently falling
          cell.dataset.v = currentVal;
          cell.textContent = currentVal;
          cell.classList.add("falling");
        } else if (gameActive && c === selectedCol && lr > fallingRow && row === lr) {
          // Ghost shows where it will land
          cell.dataset.v = currentVal;
          cell.textContent = currentVal;
          cell.classList.add("ghost");
        } else if (gameActive && c === selectedCol && row > fallingRow && row < lr) {
          // Path between falling tile and landing spot
          cell.classList.add("col-hover");
        }

        // Click any cell to hard-drop there
        if (gameActive) {
          const col = c;
          cell.onclick = () => {
            if (cols[col].length >= ROWS) return;
            selectedCol = col;
            dropNow();
          };
        }
      }
    }
  }

  // ─── Keyboard controls ────────────────────────────────────────────────────
  document.addEventListener("keydown", (e) => {
    if (!gameActive) return;
    if (e.key === "ArrowLeft") {
      e.preventDefault();
      moveLeft();
    } else if (e.key === "ArrowRight") {
      e.preventDefault();
      moveRight();
    } else if (e.key === "ArrowDown" || e.key === " " || e.key === "Enter") {
      e.preventDefault();
      dropNow();
    }
  });

  // ─── Init ─────────────────────────────────────────────────────────────────
  cols = Array.from({ length: COLS }, () => []);
  currentVal = 2;
  nextVal = 2;
  fallingRow = 0;
  updateNextPreview();
  renderGrid();
  document.getElementById("start-overlay").style.display = "flex";
</script>
