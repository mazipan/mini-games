---
layout: layouts/game.njk
title: Space Invaders
description: Defend Earth from waves of alien invaders — shoot them all before they reach you!
category: arcade
icon: "👾"
---

{% from "macros/game-components.njk" import statCard, summaryStatCard, infoDetails %}

<style>
  #game-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: calc(100vh - 60px);
    gap: 1rem;
    padding: 1rem;
  }
  canvas {
    border: 2px solid #1e3a5f;
    border-radius: 4px;
    max-width: 100%;
    display: block;
  }
  .canvas-wrapper {
    position: relative;
  }
  #overlay,
  #gameover-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    gap: 0.75rem;
  }
  #overlay {
    background: rgba(15, 23, 42, 0.85);
  }
  #gameover-overlay {
    background: rgba(15, 23, 42, 0.95);
  }
  #overlay h2,
  #gameover-overlay h2 {
    font-size: 1.6rem;
    font-weight: bold;
    color: white;
  }
  .demo-label {
    font-size: 0.7rem;
    color: #22c55e;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .score-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.6rem 1.2rem;
  }
  .stat-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .stat-value {
    font-size: 1.4rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  .play-btn {
    padding: 0.5rem 1.5rem;
    background: #7c3aed;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
  }
  .play-btn:hover {
    background: #6d28d9;
  }
  .controls-hint {
    font-size: 0.75rem;
    color: #64748b;
    text-align: center;
  }
  .summary-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .summary-stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.5rem 0.9rem;
    min-width: 72px;
  }
  .summary-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .summary-value {
    font-size: 1.2rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  #dpad {
    display: none;
    gap: 1rem;
  }
  @media (max-width: 640px) {
    #dpad {
      display: flex;
    }
  }
  .dpad-btn {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    color: white;
    font-size: 1.4rem;
    cursor: pointer;
    padding: 0.5rem 1.2rem;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .dpad-btn:active {
    background: #334155;
  }
  .info-section {
    width: 100%;
    max-width: 420px;
    padding: 0 1rem 2rem;
    margin: 0 auto;
  }
  .info-details {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    margin-bottom: 0.75rem;
    overflow: hidden;
  }
  .info-details summary {
    padding: 0.75rem 1rem;
    font-weight: 600;
    color: #e2e8f0;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
  }
  .info-details summary::-webkit-details-marker {
    display: none;
  }
  .info-details summary::after {
    content: "+";
    font-size: 1.1rem;
    color: #64748b;
  }
  .info-details[open] summary::after {
    content: "−";
  }
  .info-body {
    padding: 0.75rem 1rem 1rem;
    color: #94a3b8;
    font-size: 0.875rem;
    line-height: 1.6;
    border-top: 1px solid #334155;
  }
  .info-body h4 {
    color: #e2e8f0;
    font-weight: 600;
    margin: 0.75rem 0 0.25rem;
    font-size: 0.875rem;
  }
  .info-body h4:first-child {
    margin-top: 0;
  }
  .info-body ul {
    padding-left: 1.25rem;
    margin: 0.25rem 0;
  }
  .info-body li {
    margin-bottom: 0.25rem;
  }
  .info-body p {
    margin: 0.25rem 0;
  }
</style>

<div id="game-wrapper">
  <div class="score-row">
    {{ statCard("Score", "score") }} {{ statCard("Wave", "wave-display", "1") }} {{ statCard("Lives", "lives-display",
    "❤️❤️❤️") }} {{ statCard("Best", "best-display") }}
  </div>
  <div class="canvas-wrapper">
    <canvas id="si-canvas"></canvas>
    <div id="overlay">
      <span class="demo-label" id="demo-label">Live Demo</span>
      <span style="font-size: 3rem">👾</span>
      <h2>Space Invaders</h2>
      <p class="controls-hint" style="color: #94a3b8">Arrow keys + Space to shoot</p>
      <button class="play-btn" onclick="startGame()">Play Game</button>
    </div>
    <div id="gameover-overlay" style="display: none">
      <span id="go-icon">💀</span>
      <h2 id="go-title">Game Over</h2>
      <div class="summary-row">
        {{ summaryStatCard("Score", "go-score") }} {{ summaryStatCard("Best", "go-best") }} {{ summaryStatCard("Wave",
        "go-wave", "1") }}
      </div>
      <button class="play-btn" onclick="startGame()">New Game</button>
    </div>
  </div>
  <div id="dpad">
    <button class="dpad-btn" id="btn-left">◀</button>
    <button class="dpad-btn" id="btn-fire">🔫</button>
    <button class="dpad-btn" id="btn-right">▶</button>
  </div>
  <p class="controls-hint">Arrow keys to move · Space to shoot</p>
</div>

<div class="info-section">
  {% call infoDetails("How to Play") %}
  <h4>Goal</h4>
  <p>
    Destroy all alien invaders before they reach the bottom of the screen. Clear every wave to advance — each new wave
    moves faster!
  </p>
  <h4>Controls — Desktop</h4>
  <ul>
    <li><strong>← → Arrow Keys</strong> — move your cannon left/right</li>
    <li><strong>Space</strong> — fire a bullet</li>
  </ul>
  <h4>Controls — Mobile</h4>
  <ul>
    <li><strong>◀ ▶ buttons</strong> — hold to move continuously</li>
    <li><strong>🔫 button</strong> — tap to fire</li>
  </ul>
  <h4>Waves &amp; Scoring</h4>
  <ul>
    <li><strong>Bottom rows (🤖)</strong> — 10 points each</li>
    <li><strong>Middle rows (👽)</strong> — 20 points each</li>
    <li><strong>Top row (👾)</strong> — 30 points each</li>
    <li>Each wave cleared = aliens respawn faster</li>
    <li>You have <strong>3 lives</strong> — getting hit by an alien bullet costs one</li>
  </ul>
  {% endcall %} {% call infoDetails("FAQ") %}
  <h4>What is the Live Demo?</h4>
  <p>Before you start, an AI cannon plays automatically in the background so you can see the game in action.</p>
  <h4>Is my best score saved?</h4>
  <p>Yes — your best score is saved automatically in your browser's local storage and persists between sessions.</p>
  <h4>Can I play on mobile?</h4>
  <p>Yes! The D-pad appears automatically on small screens. Hold ◀ or ▶ to move and tap 🔫 to shoot.</p>
  <h4>Why do aliens speed up?</h4>
  <p>
    As you destroy more aliens the remaining ones move faster — a classic Space Invaders mechanic. Clearing a wave also
    increases the base speed for the next wave.
  </p>
  {% endcall %}
</div>

<script>
  // ── Confetti ─────────────────────────────────────────────────────────────
  function launchConfetti() {
    const canvas = document.createElement("canvas");
    canvas.style.cssText = "position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999";
    document.body.appendChild(canvas);
    const ctx = canvas.getContext("2d");
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    const colors = ["#7c3aed", "#db2777", "#f59e0b", "#10b981", "#3b82f6", "#ef4444", "#fbbf24"];
    const pieces = Array.from({ length: 80 }, () => ({
      x: Math.random() * canvas.width,
      y: -10 - Math.random() * 40,
      r: Math.random() * 6 + 3,
      color: colors[Math.floor(Math.random() * colors.length)],
      vx: (Math.random() - 0.5) * 5,
      vy: Math.random() * 4 + 2,
      angle: Math.random() * Math.PI * 2,
      va: (Math.random() - 0.5) * 0.15,
    }));
    const start = performance.now();
    function draw(now) {
      if (now - start > 3000) {
        canvas.remove();
        return;
      }
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      pieces.forEach((p) => {
        p.x += p.vx;
        p.y += p.vy;
        p.angle += p.va;
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.angle);
        ctx.fillStyle = p.color;
        ctx.fillRect(-p.r, -p.r / 2, p.r * 2, p.r);
        ctx.restore();
      });
      requestAnimationFrame(draw);
    }
    requestAnimationFrame(draw);
  }

  // ── Canvas setup ─────────────────────────────────────────────────────────
  const DESIGN = 480;
  const SIZE = Math.min(DESIGN, window.innerWidth - 32);
  const S = SIZE / DESIGN;
  const canvas = document.getElementById("si-canvas");
  const ctx = canvas.getContext("2d");
  canvas.width = SIZE;
  canvas.height = Math.round(SIZE * (560 / 480));

  // ── Constants ─────────────────────────────────────────────────────────────
  const STORAGE_KEY = "mini-space-invaders-best";
  const ALIEN_COLS = 11;
  const ALIEN_ROWS = 5;
  const alienW = 32 * S,
    alienH = 24 * S;
  const alienPadX = 12 * S,
    alienPadY = 12 * S;
  const alienOffsetX = 20 * S,
    alienOffsetY = 40 * S;
  const playerW = 30 * S,
    playerH = 18 * S;
  const BULLET_W = 3 * S,
    BULLET_H = 10 * S;
  const ALIEN_COLORS = ["#7c3aed", "#3b82f6", "#3b82f6", "#10b981", "#10b981"];
  const ALIEN_POINTS = [30, 20, 20, 10, 10];

  // ── State ─────────────────────────────────────────────────────────────────
  let best = parseInt(localStorage.getItem(STORAGE_KEY) || "0", 10);
  document.getElementById("best-display").textContent = best;

  let score, wave, lives, running, isDemo, animId, alienShootTimer, frameCount;
  let player, playerBullets, alienBullets, aliens;
  let alienDirX, alienSpeedX;
  let keys = {};

  // D-pad held state
  let dpadLeft = false,
    dpadRight = false,
    dpadFire = false,
    dpadFireUsed = false;

  // ── Alien grid helpers ────────────────────────────────────────────────────
  function makeAliens() {
    const grid = [];
    for (let row = 0; row < ALIEN_ROWS; row++) {
      for (let col = 0; col < ALIEN_COLS; col++) {
        grid.push({
          row,
          col,
          x: alienOffsetX + col * (alienW + alienPadX),
          y: alienOffsetY + row * (alienH + alienPadY),
          alive: true,
        });
      }
    }
    return grid;
  }

  function liveAliens() {
    return aliens.filter((a) => a.alive);
  }

  function alienSpeed(w) {
    return (0.5 + w * 0.3) * S;
  }

  // ── Init game state ───────────────────────────────────────────────────────
  function initState(startWave) {
    wave = startWave || 1;
    score = 0;
    lives = 3;
    playerBullets = [];
    alienBullets = [];
    aliens = makeAliens();
    alienDirX = 1;
    alienSpeedX = alienSpeed(wave);
    alienShootTimer = 0;
    frameCount = 0;
    player = { x: canvas.width / 2, y: canvas.height - 30 * S };
    updateHUD();
  }

  function resetWave() {
    playerBullets = [];
    alienBullets = [];
    aliens = makeAliens();
    alienDirX = 1;
    alienSpeedX = alienSpeed(wave);
    alienShootTimer = 0;
    player.x = canvas.width / 2;
  }

  function updateHUD() {
    document.getElementById("score").textContent = score;
    document.getElementById("wave-display").textContent = wave;
    document.getElementById("lives-display").textContent = "❤️".repeat(Math.max(0, lives));
    document.getElementById("best-display").textContent = best;
  }

  // ── Draw ──────────────────────────────────────────────────────────────────
  function draw() {
    ctx.fillStyle = "#0f172a";
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Ground line
    ctx.strokeStyle = "#22c55e";
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(0, canvas.height - 10 * S);
    ctx.lineTo(canvas.width, canvas.height - 10 * S);
    ctx.stroke();

    // Player cannon
    ctx.fillStyle = "#22c55e";
    ctx.fillRect(player.x - playerW / 2, player.y - playerH, playerW, playerH);
    // Turret
    ctx.fillRect(player.x - 4 * S, player.y - playerH - 8 * S, 8 * S, 8 * S);

    // Aliens
    for (const a of aliens) {
      if (!a.alive) continue;
      ctx.fillStyle = ALIEN_COLORS[a.row];
      ctx.fillRect(a.x, a.y, alienW, alienH);
      // Simple eye details
      ctx.fillStyle = "rgba(0,0,0,0.4)";
      ctx.fillRect(a.x + alienW * 0.2, a.y + alienH * 0.25, alienW * 0.2, alienH * 0.3);
      ctx.fillRect(a.x + alienW * 0.6, a.y + alienH * 0.25, alienW * 0.2, alienH * 0.3);
    }

    // Player bullets (green)
    ctx.fillStyle = "#86efac";
    for (const b of playerBullets) {
      ctx.fillRect(b.x - BULLET_W / 2, b.y, BULLET_W, BULLET_H);
    }

    // Alien bullets (red)
    ctx.fillStyle = "#f87171";
    for (const b of alienBullets) {
      ctx.fillRect(b.x - BULLET_W / 2, b.y, BULLET_W, BULLET_H);
    }

    // Wave label top-left
    ctx.fillStyle = "#475569";
    ctx.font = `${Math.round(11 * S)}px monospace`;
    ctx.fillText(`WAVE ${wave}`, 8 * S, 16 * S);
  }

  // ── Update ────────────────────────────────────────────────────────────────
  function update(demo) {
    frameCount++;

    // Player movement
    const spd = 3 * S;
    if ((keys["ArrowLeft"] || dpadLeft) && player.x - playerW / 2 > 0) {
      player.x -= spd;
    }
    if ((keys["ArrowRight"] || dpadRight) && player.x + playerW / 2 < canvas.width) {
      player.x += spd;
    }

    // Player fire
    const canFire = playerBullets.length < 2;
    if (canFire && (keys[" "] || (dpadFire && !dpadFireUsed))) {
      playerBullets.push({ x: player.x, y: player.y - playerH - 8 * S });
      if (dpadFire) dpadFireUsed = true;
    }

    // Demo AI: track nearest alien column, fire periodically
    if (demo) {
      const alive = liveAliens();
      if (alive.length > 0) {
        // Find alien closest to bottom center
        const target = alive.reduce((best, a) => (a.y > best.y ? a : best), alive[0]);
        const cx = target.x + alienW / 2;
        if (Math.abs(player.x - cx) > 4 * S) {
          player.x += player.x < cx ? spd : -spd;
        }
        player.x = Math.max(playerW / 2, Math.min(canvas.width - playerW / 2, player.x));
        if (frameCount % 30 === 0 && playerBullets.length < 2) {
          playerBullets.push({ x: player.x, y: player.y - playerH - 8 * S });
        }
      }
    }

    // Move player bullets
    const bulletSpd = 5 * S;
    playerBullets = playerBullets.filter((b) => {
      b.y -= bulletSpd;
      return b.y + BULLET_H > 0;
    });

    // Move alien bullets
    const abSpd = 2 * S;
    alienBullets = alienBullets.filter((b) => {
      b.y += abSpd;
      return b.y < canvas.height;
    });

    // Move aliens
    const alive = liveAliens();
    if (alive.length === 0) return; // wave cleared, handled elsewhere

    // Speed scales with fewer aliens remaining
    const speedMult = 1 + (1 - alive.length / (ALIEN_COLS * ALIEN_ROWS)) * 1.5;
    const step = alienSpeedX * alienDirX * speedMult;
    for (const a of aliens) {
      if (a.alive) a.x += step;
    }

    // Wall bounce
    let minX = Infinity,
      maxX = -Infinity;
    for (const a of alive) {
      if (a.x < minX) minX = a.x;
      if (a.x + alienW > maxX) maxX = a.x + alienW;
    }
    if (maxX >= canvas.width || minX <= 0) {
      alienDirX *= -1;
      for (const a of aliens) {
        if (a.alive) {
          // Move back within bounds
          if (maxX >= canvas.width) a.x -= maxX - canvas.width;
          else a.x += -minX;
          a.y += alienH * 0.5;
        }
      }
    }

    // Alien shooting
    alienShootTimer++;
    const shootInterval = Math.max(60, 120 - wave * 10);
    if (alienShootTimer >= shootInterval) {
      alienShootTimer = 0;
      // Pick a random alive alien
      if (alive.length > 0) {
        const shooter = alive[Math.floor(Math.random() * alive.length)];
        alienBullets.push({ x: shooter.x + alienW / 2, y: shooter.y + alienH });
      }
    }

    if (demo) return; // skip collision in demo

    // Collision: player bullet vs alien
    outer: for (let bi = playerBullets.length - 1; bi >= 0; bi--) {
      const b = playerBullets[bi];
      for (const a of aliens) {
        if (!a.alive) continue;
        if (b.x >= a.x && b.x <= a.x + alienW && b.y >= a.y && b.y <= a.y + alienH) {
          a.alive = false;
          playerBullets.splice(bi, 1);
          const pts = ALIEN_POINTS[a.row];
          score += pts;
          if (score > best) {
            best = score;
            localStorage.setItem(STORAGE_KEY, best);
            document.getElementById("best-display").textContent = best;
            launchConfetti();
          }
          document.getElementById("score").textContent = score;
          continue outer;
        }
      }
    }

    // Collision: alien bullet vs player
    for (let bi = alienBullets.length - 1; bi >= 0; bi--) {
      const b = alienBullets[bi];
      if (
        b.x >= player.x - playerW / 2 &&
        b.x <= player.x + playerW / 2 &&
        b.y >= player.y - playerH &&
        b.y <= player.y
      ) {
        alienBullets.splice(bi, 1);
        loseLife();
        return;
      }
    }

    // Aliens reach player level → game over
    for (const a of alive) {
      if (a.y + alienH >= player.y - playerH) {
        gameOver();
        return;
      }
    }

    // All aliens dead → wave cleared
    if (liveAliens().length === 0) {
      waveClear();
    }
  }

  function loseLife() {
    lives--;
    updateHUD();
    if (lives <= 0) {
      gameOver();
    } else {
      // Reset positions but keep formation and score
      player.x = canvas.width / 2;
      playerBullets = [];
      alienBullets = [];
    }
  }

  function waveClear() {
    wave++;
    launchConfetti();
    resetWave();
    alienSpeedX = alienSpeed(wave);
    updateHUD();
  }

  function gameOver() {
    running = false;
    cancelAnimationFrame(animId);

    document.getElementById("go-score").textContent = score;
    document.getElementById("go-best").textContent = best;
    document.getElementById("go-wave").textContent = wave;
    document.getElementById("overlay").style.display = "none";
    document.getElementById("gameover-overlay").style.display = "flex";
  }

  // ── Game loop ─────────────────────────────────────────────────────────────
  function gameLoop() {
    update(false);
    draw();
    if (running) animId = requestAnimationFrame(gameLoop);
  }

  function demoLoop() {
    update(true);
    draw();
    if (!running) animId = requestAnimationFrame(demoLoop);
  }

  // ── Start / restart ───────────────────────────────────────────────────────
  function startDemo() {
    running = false;
    isDemo = true;
    cancelAnimationFrame(animId);
    initState(1);
    animId = requestAnimationFrame(demoLoop);
  }

  function startGame() {
    cancelAnimationFrame(animId);
    running = true;
    isDemo = false;
    document.getElementById("demo-label").style.display = "none";
    document.getElementById("overlay").style.display = "none";
    document.getElementById("gameover-overlay").style.display = "none";
    initState(1);
    animId = requestAnimationFrame(gameLoop);
  }

  // ── Keyboard input ────────────────────────────────────────────────────────
  document.addEventListener("keydown", (e) => {
    if (["ArrowLeft", "ArrowRight", " "].includes(e.key)) {
      e.preventDefault();
    }
    keys[e.key] = true;
  });
  document.addEventListener("keyup", (e) => {
    keys[e.key] = false;
  });

  // ── D-pad input ───────────────────────────────────────────────────────────
  const btnLeft = document.getElementById("btn-left");
  const btnRight = document.getElementById("btn-right");
  const btnFire = document.getElementById("btn-fire");

  function wire(btn, downFn, upFn) {
    btn.addEventListener(
      "touchstart",
      (e) => {
        e.preventDefault();
        downFn();
      },
      { passive: false }
    );
    btn.addEventListener(
      "touchend",
      (e) => {
        e.preventDefault();
        upFn();
      },
      { passive: false }
    );
    btn.addEventListener(
      "touchcancel",
      (e) => {
        e.preventDefault();
        upFn();
      },
      { passive: false }
    );
    btn.addEventListener("mousedown", downFn);
    btn.addEventListener("mouseup", upFn);
    btn.addEventListener("mouseleave", upFn);
  }

  wire(
    btnLeft,
    () => {
      dpadLeft = true;
    },
    () => {
      dpadLeft = false;
    }
  );
  wire(
    btnRight,
    () => {
      dpadRight = true;
    },
    () => {
      dpadRight = false;
    }
  );
  wire(
    btnFire,
    () => {
      dpadFire = true;
      dpadFireUsed = false;
    },
    () => {
      dpadFire = false;
      dpadFireUsed = false;
    }
  );

  // ── Boot ──────────────────────────────────────────────────────────────────
  startDemo();
</script>
