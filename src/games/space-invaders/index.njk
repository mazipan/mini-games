---
layout: layouts/game.njk
title: Space Invaders
description: Defend Earth from waves of alien invaders — shoot them all before they reach you!
category: arcade
icon: "👾"
---

{% from "macros/game-components.njk" import statCard, summaryStatCard, infoDetails %}

<style>
  #game-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: calc(100vh - 60px);
    gap: 1rem;
    padding: 1rem;
  }
  canvas {
    border: 2px solid #1e3a5f;
    border-radius: 4px;
    max-width: 100%;
    display: block;
  }
  .canvas-wrapper {
    position: relative;
  }
  #overlay,
  #gameover-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    gap: 0.75rem;
  }
  #overlay {
    background: rgba(15, 23, 42, 0.85);
  }
  #gameover-overlay {
    background: rgba(15, 23, 42, 0.95);
  }
  #overlay h2,
  #gameover-overlay h2 {
    font-size: 1.6rem;
    font-weight: bold;
    color: white;
  }
  .demo-label {
    font-size: 0.7rem;
    color: #22c55e;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .score-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.6rem 1.2rem;
  }
  .stat-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .stat-value {
    font-size: 1.4rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  .play-btn {
    padding: 0.5rem 1.5rem;
    background: #7c3aed;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .play-btn:hover {
    background: #6d28d9;
  }
  .controls-hint {
    font-size: 0.75rem;
    color: #64748b;
    text-align: center;
  }
  .summary-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .summary-stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.5rem 0.9rem;
    min-width: 72px;
  }
  .summary-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .summary-value {
    font-size: 1.2rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  #dpad {
    display: none;
    gap: 1rem;
  }
  @media (max-width: 640px) {
    #dpad {
      display: flex;
    }
  }
  .dpad-btn {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    color: white;
    font-size: 1.4rem;
    cursor: pointer;
    padding: 0.5rem 1.2rem;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .dpad-btn:active {
    background: #334155;
  }
  .info-section {
    width: 100%;
    max-width: 420px;
    padding: 0 1rem 2rem;
    margin: 0 auto;
  }
  .info-details {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    margin-bottom: 0.75rem;
    overflow: hidden;
  }
  .info-details summary {
    padding: 0.75rem 1rem;
    font-weight: 600;
    color: #e2e8f0;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
  }
  .info-details summary::-webkit-details-marker {
    display: none;
  }
  .info-details summary::after {
    content: "+";
    font-size: 1.1rem;
    color: #64748b;
  }
  .info-details[open] summary::after {
    content: "−";
  }
  .info-body {
    padding: 0.75rem 1rem 1rem;
    color: #94a3b8;
    font-size: 0.875rem;
    line-height: 1.6;
    border-top: 1px solid #334155;
  }
  .info-body h4 {
    color: #e2e8f0;
    font-weight: 600;
    margin: 0.75rem 0 0.25rem;
    font-size: 0.875rem;
  }
  .info-body h4:first-child {
    margin-top: 0;
  }
  .info-body ul {
    padding-left: 1.25rem;
    margin: 0.25rem 0;
  }
  .info-body li {
    margin-bottom: 0.25rem;
  }
  .info-body p {
    margin: 0.25rem 0;
  }
</style>

<div id="game-wrapper">
  <div class="score-row">
    {{ statCard("Score", "score") }} {{ statCard("Wave", "wave-display", "1") }} {{ statCard("Lives", "lives-display",
    "❤️❤️❤️") }} {{ statCard("Best", "best-display") }}
  </div>
  <div class="canvas-wrapper">
    <canvas id="si-canvas"></canvas>
    <div id="overlay">
      <span class="demo-label" id="demo-label">Live Demo</span>
      <span style="font-size: 3rem">👾</span>
      <h2>Space Invaders</h2>
      <p class="controls-hint" style="color: #94a3b8">Arrow keys to move · cannon auto-fires!</p>
      <button class="play-btn" onclick="startGame()">Play Game</button>
    </div>
    <div id="gameover-overlay" style="display: none">
      <span id="go-icon">💀</span>
      <h2 id="go-title">Game Over</h2>
      <div class="summary-row">
        {{ summaryStatCard("Score", "go-score") }} {{ summaryStatCard("Best", "go-best") }} {{ summaryStatCard("Wave",
        "go-wave", "1") }}
      </div>
      <button class="play-btn" onclick="startGame()">New Game</button>
    </div>
  </div>
  <div id="dpad">
    <button class="dpad-btn" id="btn-left">◀</button>
    <button class="dpad-btn" id="btn-right">▶</button>
  </div>
  <p class="controls-hint">Arrow keys to move · cannon auto-fires!</p>
</div>

<div class="info-section">
  {% call infoDetails("How to Play") %}
  <h4>Goal</h4>
  <p>
    Destroy all alien invaders before they reach the bottom. Clear each wave to advance — formations grow larger and
    faster as you progress!
  </p>
  <h4>Controls</h4>
  <ul>
    <li><strong>← → Arrow Keys</strong> (desktop) or <strong>◀ ▶ buttons</strong> (mobile) — move left/right</li>
    <li>Your cannon fires <strong>automatically</strong> — just focus on dodging and aiming!</li>
  </ul>
  <h4>Wave Progression</h4>
  <ul>
    <li><strong>Waves 1–2:</strong> 1–3 aliens, no shooting — learn the basics</li>
    <li><strong>Waves 3–4:</strong> up to 7 aliens, aliens start shooting back</li>
    <li><strong>Waves 5–6:</strong> 2-row formations, new alien type appears</li>
    <li><strong>Waves 7–8:</strong> 3-row formations, another new type</li>
    <li><strong>Waves 9–10:</strong> 4–5 rows — the full invasion!</li>
  </ul>
  <h4>Secret alien 👀</h4>
  <p>
    Each wave hides one impostor — a different emoji that slowly pulses. Shoot it for +75 bonus points and a ⚡ rapid
    fire power-up drop! The impostor emoji changes every wave.
  </p>
  <h4>Mystery UFO ⚡</h4>
  <p>
    A 🛸 UFO flies across the <strong>top</strong> every ~12 seconds. Shoot it to drop a ⚡ token — collect for 8
    seconds of rapid fire (+100 pts).
  </p>
  <h4>Gift 🎁</h4>
  <p>
    A 🎁 gift floats across the <strong>middle</strong> of the screen every ~9 seconds. Shoot it to drop a 🎁 token —
    collect for 8 seconds of double-row shot: two bullets fire side-by-side each burst (+80 pts). Stack it with rapid
    fire for maximum carnage!
  </p>
  <h4>Scoring</h4>
  <ul>
    <li>Higher-row aliens are worth more points (🦠 10 → 👾 30)</li>
    <li>Remaining aliens speed up as their numbers dwindle</li>
    <li>You have <strong>3 lives</strong> — getting hit costs one</li>
  </ul>
  {% endcall %} {% call infoDetails("FAQ") %}
  <h4>What is the Live Demo?</h4>
  <p>Before you start, an AI cannon plays automatically in the background so you can see the game in action.</p>
  <h4>Is my best score saved?</h4>
  <p>Yes — your best score is saved automatically in your browser's local storage and persists between sessions.</p>
  <h4>Can I play on mobile?</h4>
  <p>Yes! The D-pad appears automatically on small screens. Hold ◀ or ▶ to move — the cannon fires itself.</p>
  <h4>Why do aliens speed up as I kill them?</h4>
  <p>
    As fewer aliens remain they move faster — a classic Space Invaders mechanic. Clearing a wave also raises the base
    speed for the next wave.
  </p>
  <h4>When do aliens start shooting?</h4>
  <p>
    Aliens don't shoot in waves 1 and 2 — perfect for learning. From wave 3 onward they'll fire back, with increasing
    frequency each wave.
  </p>
  <h4>What is the 🛸 mystery UFO?</h4>
  <p>
    A secret UFO that flies across the top of the screen roughly every 12 seconds. Shoot it and a ⚡ power-up drops —
    move into it to activate 8 seconds of rapid fire!
  </p>
  {% endcall %}
</div>

<script>
  // ── Confetti ─────────────────────────────────────────────────────────────
  function launchConfetti() {
    const canvas = document.createElement("canvas");
    canvas.style.cssText = "position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999";
    document.body.appendChild(canvas);
    const ctx = canvas.getContext("2d");
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    const colors = ["#7c3aed", "#db2777", "#f59e0b", "#10b981", "#3b82f6", "#ef4444", "#fbbf24"];
    const pieces = Array.from({ length: 80 }, () => ({
      x: Math.random() * canvas.width,
      y: -10 - Math.random() * 40,
      r: Math.random() * 6 + 3,
      color: colors[Math.floor(Math.random() * colors.length)],
      vx: (Math.random() - 0.5) * 5,
      vy: Math.random() * 4 + 2,
      angle: Math.random() * Math.PI * 2,
      va: (Math.random() - 0.5) * 0.15,
    }));
    const start = performance.now();
    function draw(now) {
      if (now - start > 3000) {
        canvas.remove();
        return;
      }
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      pieces.forEach((p) => {
        p.x += p.vx;
        p.y += p.vy;
        p.angle += p.va;
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.angle);
        ctx.fillStyle = p.color;
        ctx.fillRect(-p.r, -p.r / 2, p.r * 2, p.r);
        ctx.restore();
      });
      requestAnimationFrame(draw);
    }
    requestAnimationFrame(draw);
  }

  // ── Canvas setup ─────────────────────────────────────────────────────────
  const DESIGN = 480;
  const SIZE = Math.min(DESIGN, window.innerWidth - 32);
  const S = SIZE / DESIGN;
  const gameCanvas = document.getElementById("si-canvas");
  const ctx = gameCanvas.getContext("2d");
  gameCanvas.width = SIZE;
  gameCanvas.height = Math.round(SIZE * (560 / 480));

  // ── Sizing constants ──────────────────────────────────────────────────────
  const alienW = 32 * S,
    alienH = 24 * S;
  const alienPadX = 10 * S,
    alienPadY = 10 * S;
  const alienOffsetY = 36 * S;
  const playerW = 30 * S,
    playerH = 18 * S;
  const BULLET_W = 3 * S,
    BULLET_H = 10 * S;

  // ── Wave progression config ───────────────────────────────────────────────
  // Each entry: rows × cols of aliens, base movement speed (pre-S), shoot interval in frames (0 = no shooting)
  const WAVE_CONFIGS = [
    { rows: 1, cols: 1, speed: 0.35, shoot: 0 }, // wave 1 : 1 alien, no shooting
    { rows: 1, cols: 3, speed: 0.4, shoot: 0 }, // wave 2 : 3 aliens, no shooting
    { rows: 1, cols: 5, speed: 0.48, shoot: 150 }, // wave 3 : 5 aliens, aliens fire
    { rows: 1, cols: 7, speed: 0.55, shoot: 130 }, // wave 4 : 7 aliens
    { rows: 2, cols: 6, speed: 0.62, shoot: 115 }, // wave 5 : 12 aliens, 2nd type
    { rows: 2, cols: 8, speed: 0.7, shoot: 100 }, // wave 6 : 16 aliens
    { rows: 3, cols: 8, speed: 0.8, shoot: 90 }, // wave 7 : 24 aliens, 3rd type
    { rows: 3, cols: 10, speed: 0.9, shoot: 78 }, // wave 8 : 30 aliens
    { rows: 4, cols: 10, speed: 1.0, shoot: 65 }, // wave 9 : 40 aliens, 4th type
    { rows: 5, cols: 11, speed: 1.15, shoot: 55 }, // wave 10+: full grid, 5th type
  ];

  // 5 alien types, ordered top-row → bottom-row (hardest → easiest)
  // Each type gets a distinct emoji so new variants are visually obvious when unlocked
  const ALIEN_TYPE_EMOJIS = ["👾", "👽", "🧟", "👻", "🦠"];
  const ALIEN_TYPE_POINTS = [30, 25, 20, 15, 10];
  const MAX_ROWS = 5;

  function getWaveCfg(w) {
    const idx = Math.min(w - 1, WAVE_CONFIGS.length - 1);
    const base = WAVE_CONFIGS[idx];
    const extra = w > WAVE_CONFIGS.length ? (w - WAVE_CONFIGS.length) * 0.12 : 0;
    const shootExtra = w > WAVE_CONFIGS.length ? (w - WAVE_CONFIGS.length) * 5 : 0;
    return {
      rows: base.rows,
      cols: base.cols,
      speed: (base.speed + extra) * S,
      shoot: base.shoot > 0 ? Math.max(30, base.shoot - shootExtra) : 0,
    };
  }

  // ── Storage ───────────────────────────────────────────────────────────────
  const STORAGE_KEY = "mini-space-invaders-best";
  let best = parseInt(localStorage.getItem(STORAGE_KEY) || "0", 10);
  document.getElementById("best-display").textContent = best;

  // ── State ─────────────────────────────────────────────────────────────────
  let score, wave, lives, running, animId, alienShootTimer, frameCount;
  let player, playerBullets, alienBullets, aliens;
  let alienDirX, alienSpeedX, waveCfg;
  let waveAnnounce = 0; // frames remaining to show wave announcement
  let keys = {};
  let dpadLeft = false,
    dpadRight = false;

  // ── Auto-fire & power-ups ─────────────────────────────────────────────────
  const FIRE_RATE_NORMAL = 12; // frames between shots (normal)
  const FIRE_RATE_RAPID = 4; // frames between shots (rapid-fire buff)
  const RAPID_DURATION = 8000; // ms the rapid-fire buff lasts
  let rapidFireUntil = 0; // performance.now() deadline; 0 = inactive

  // Mystery UFO — flies across the top, drops ⚡ rapid-fire token when shot
  const UFO_INTERVAL = 720; // frames (~12 s at 60 fps)
  const UFO_SPEED = 1.8 * S;
  let ufo = null; // { x, y, dir }
  let ufoTimer = 0;

  // Gift — flies across the mid-screen, drops 🎁 double-shot token when shot
  const GIFT_INTERVAL = 540; // frames (~9 s at 60 fps)
  const GIFT_SPEED = 1.5 * S;
  let gift = null; // { x, y, dir }
  let giftTimer = 0;
  const DOUBLE_DURATION = 8000; // ms
  const DOUBLE_SPREAD = 10 * S; // side-by-side bullet offset
  let doubleFireUntil = 0;

  // Falling power-up tokens — type: 'rapid' | 'double'
  let powerUps = []; // { x, y, type }
  let powerUpMsg = 0;

  // Secret aliens — one per wave, different emoji each wave, pulses to hint at its presence
  const SECRET_EMOJIS = ["💀", "🤡", "👹", "😈", "🎃", "🦹", "🤑", "💥"];
  const SECRET_BONUS = 75;

  function getFireRate() {
    return performance.now() < rapidFireUntil ? FIRE_RATE_RAPID : FIRE_RATE_NORMAL;
  }

  // ── Alien grid ────────────────────────────────────────────────────────────
  function makeAliens(cfg) {
    const grid = [];
    const formationW = cfg.cols * alienW + (cfg.cols - 1) * alienPadX;
    const startX = (gameCanvas.width - formationW) / 2;
    const total = cfg.rows * cfg.cols;
    // Pick one random slot as the secret alien (changes every wave)
    const secretSlot = Math.floor(Math.random() * total);
    const secretEmoji = SECRET_EMOJIS[(wave - 1) % SECRET_EMOJIS.length];
    let idx = 0;
    for (let row = 0; row < cfg.rows; row++) {
      const typeIdx = MAX_ROWS - cfg.rows + row;
      for (let col = 0; col < cfg.cols; col++) {
        const isSecret = idx === secretSlot;
        grid.push({
          row,
          col,
          x: startX + col * (alienW + alienPadX),
          y: alienOffsetY + row * (alienH + alienPadY),
          alive: true,
          emoji: isSecret ? secretEmoji : ALIEN_TYPE_EMOJIS[typeIdx],
          points: ALIEN_TYPE_POINTS[typeIdx],
          isSecret,
        });
        idx++;
      }
    }
    return grid;
  }

  function liveAliens() {
    return aliens.filter((a) => a.alive);
  }

  // ── HUD ───────────────────────────────────────────────────────────────────
  function updateHUD() {
    document.getElementById("score").textContent = score;
    document.getElementById("wave-display").textContent = wave;
    document.getElementById("lives-display").textContent = "❤️".repeat(Math.max(0, lives));
    document.getElementById("best-display").textContent = best;
  }

  // ── Init ──────────────────────────────────────────────────────────────────
  function initState() {
    score = 0;
    wave = 1;
    lives = 3;
    playerBullets = [];
    alienBullets = [];
    waveCfg = getWaveCfg(wave);
    aliens = makeAliens(waveCfg);
    alienDirX = 1;
    alienSpeedX = waveCfg.speed;
    alienShootTimer = 0;
    frameCount = 0;
    waveAnnounce = 90;
    ufo = null;
    ufoTimer = 0;
    gift = null;
    giftTimer = 0;
    powerUps = [];
    rapidFireUntil = 0;
    doubleFireUntil = 0;
    powerUpMsg = 0;
    player = { x: gameCanvas.width / 2, y: gameCanvas.height - 30 * S };
    updateHUD();
  }

  function startNextWave() {
    wave++;
    playerBullets = [];
    alienBullets = [];
    waveCfg = getWaveCfg(wave);
    aliens = makeAliens(waveCfg);
    alienDirX = 1;
    alienSpeedX = waveCfg.speed;
    alienShootTimer = 0;
    waveAnnounce = 100;
    ufo = null;
    ufoTimer = 0;
    gift = null;
    giftTimer = 0;
    powerUps = [];
    player.x = gameCanvas.width / 2;
    updateHUD();
  }

  // ── Draw ──────────────────────────────────────────────────────────────────
  function draw() {
    ctx.fillStyle = "#0f172a";
    ctx.fillRect(0, 0, gameCanvas.width, gameCanvas.height);

    // Ground line
    ctx.strokeStyle = "#22c55e";
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(0, gameCanvas.height - 10 * S);
    ctx.lineTo(gameCanvas.width, gameCanvas.height - 10 * S);
    ctx.stroke();

    // Player cannon
    ctx.fillStyle = "#22c55e";
    ctx.fillRect(player.x - playerW / 2, player.y - playerH, playerW, playerH);
    ctx.fillRect(player.x - 4 * S, player.y - playerH - 8 * S, 8 * S, 8 * S);

    // Aliens — rendered as emoji; secret alien pulses in size
    const emojiSize = Math.round(Math.min(alienW, alienH) * 0.88);
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    for (const a of aliens) {
      if (!a.alive) continue;
      if (a.isSecret) {
        const pulse = 1 + Math.sin(frameCount * 0.1) * 0.18;
        ctx.save();
        ctx.translate(a.x + alienW / 2, a.y + alienH / 2);
        ctx.scale(pulse, pulse);
        ctx.font = `${emojiSize}px serif`;
        ctx.fillText(a.emoji, 0, 0);
        ctx.restore();
      } else {
        ctx.font = `${emojiSize}px serif`;
        ctx.fillText(a.emoji, a.x + alienW / 2, a.y + alienH / 2);
      }
    }
    ctx.textAlign = "left";
    ctx.textBaseline = "alphabetic";

    // Player bullets — colour shows active buffs
    const _now = performance.now();
    const _rapid = _now < rapidFireUntil,
      _dbl = _now < doubleFireUntil;
    ctx.fillStyle = _rapid && _dbl ? "#f0abfc" : _rapid ? "#fde047" : _dbl ? "#67e8f9" : "#86efac";
    for (const b of playerBullets) ctx.fillRect(b.x - BULLET_W / 2, b.y, BULLET_W, BULLET_H);

    // Alien bullets
    ctx.fillStyle = "#f87171";
    for (const b of alienBullets) ctx.fillRect(b.x - BULLET_W / 2, b.y, BULLET_W, BULLET_H);

    // Mystery UFO + Gift — share emoji rendering setup
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.font = `${Math.round(alienH * 0.9)}px serif`;
    if (ufo) ctx.fillText("🛸", ufo.x, ufo.y);
    if (gift) ctx.fillText("🎁", gift.x, gift.y);

    // Falling power-up tokens
    if (powerUps.length > 0) {
      ctx.font = `${Math.round(alienH * 0.85)}px serif`;
      for (const p of powerUps) ctx.fillText(p.type === "double" ? "🎁" : "⚡", p.x, p.y);
    }
    ctx.textAlign = "left";
    ctx.textBaseline = "alphabetic";

    // Buff timer bars — rapid fire (yellow) and double shot (pink), stacked
    const _buffNow = performance.now();
    const _barW = gameCanvas.width * 0.4;
    const _barH = 5 * S;
    const _barX = (gameCanvas.width - _barW) / 2;
    ctx.font = `${Math.round(9 * S)}px monospace`;
    ctx.textAlign = "center";
    let _barSlot = 0;
    function drawBuffBar(remaining, total, color, label) {
      const barY = gameCanvas.height - 22 * S - _barSlot * 18 * S;
      ctx.fillStyle = "#1e293b";
      ctx.fillRect(_barX, barY, _barW, _barH);
      ctx.fillStyle = color;
      ctx.fillRect(_barX, barY, (remaining / total) * _barW, _barH);
      ctx.fillStyle = color;
      ctx.fillText(label, gameCanvas.width / 2, barY - 4 * S);
      _barSlot++;
    }
    if (_buffNow < rapidFireUntil) drawBuffBar(rapidFireUntil - _buffNow, RAPID_DURATION, "#fde047", "⚡ RAPID FIRE");
    if (_buffNow < doubleFireUntil)
      drawBuffBar(doubleFireUntil - _buffNow, DOUBLE_DURATION, "#f472b6", "🎁 DOUBLE SHOT");
    ctx.textAlign = "left";

    // Wave announcement banner
    if (waveAnnounce > 0) {
      const alpha = Math.min(1, waveAnnounce / 20);
      ctx.globalAlpha = alpha;
      ctx.fillStyle = "#1e293b";
      const bh = 36 * S;
      ctx.fillRect(0, gameCanvas.height / 2 - bh / 2, gameCanvas.width, bh);
      ctx.fillStyle = "#f8fafc";
      ctx.font = `bold ${Math.round(15 * S)}px monospace`;
      ctx.textAlign = "center";
      ctx.fillText(`— WAVE ${wave} —`, gameCanvas.width / 2, gameCanvas.height / 2 + 5 * S);
      ctx.textAlign = "left";
      ctx.globalAlpha = 1;
    }
  }

  // ── Update ────────────────────────────────────────────────────────────────
  function update(demo) {
    frameCount++;
    if (waveAnnounce > 0) waveAnnounce--;

    const spd = 3 * S;

    // Player movement
    if ((keys["ArrowLeft"] || dpadLeft) && player.x - playerW / 2 > 0) player.x -= spd;
    if ((keys["ArrowRight"] || dpadRight) && player.x + playerW / 2 < gameCanvas.width) player.x += spd;

    // Auto-fire (rate depends on rapid buff; count depends on double buff)
    const fireRate = getFireRate();
    const isDouble = performance.now() < doubleFireUntil;
    const maxBullets = performance.now() < rapidFireUntil ? 6 : 4;
    const bulletY = player.y - playerH - 8 * S;
    if (frameCount % fireRate === 0) {
      if (isDouble) {
        if (playerBullets.length < maxBullets - 1) {
          playerBullets.push({ x: player.x - DOUBLE_SPREAD, y: bulletY });
          playerBullets.push({ x: player.x + DOUBLE_SPREAD, y: bulletY });
        }
      } else if (playerBullets.length < maxBullets) {
        playerBullets.push({ x: player.x, y: bulletY });
      }
    }

    // Demo AI: track the lowest alive alien
    if (demo) {
      const alive = liveAliens();
      if (alive.length > 0) {
        const target = alive.reduce((b, a) => (a.y > b.y ? a : b), alive[0]);
        const cx = target.x + alienW / 2;
        if (Math.abs(player.x - cx) > 4 * S) player.x += player.x < cx ? spd : -spd;
        player.x = Math.max(playerW / 2, Math.min(gameCanvas.width - playerW / 2, player.x));
      }
    }

    // Mystery UFO (top of screen → ⚡ rapid fire)
    if (!demo) {
      ufoTimer++;
      if (!ufo && ufoTimer >= UFO_INTERVAL) {
        ufoTimer = 0;
        const goRight = frameCount % 2 === 0;
        ufo = { x: goRight ? -alienW : gameCanvas.width + alienW, y: 14 * S, dir: goRight ? 1 : -1 };
      }
      if (ufo) {
        ufo.x += UFO_SPEED * ufo.dir;
        if (ufo.x < -alienW * 2 || ufo.x > gameCanvas.width + alienW * 2) ufo = null;
      }
    }

    // Gift (mid-screen → 🎁 double shot)
    if (!demo) {
      giftTimer++;
      if (!gift && giftTimer >= GIFT_INTERVAL) {
        giftTimer = 0;
        const goRight = Math.random() < 0.5;
        const midY = gameCanvas.height * 0.42;
        gift = { x: goRight ? -alienW : gameCanvas.width + alienW, y: midY, dir: goRight ? 1 : -1 };
      }
      if (gift) {
        gift.x += GIFT_SPEED * gift.dir;
        if (gift.x < -alienW * 2 || gift.x > gameCanvas.width + alienW * 2) gift = null;
      }
    }

    // Falling power-up tokens
    if (!demo) {
      powerUps = powerUps.filter((p) => {
        p.y += 1.5 * S;
        if (Math.abs(p.x - player.x) < playerW && p.y >= player.y - playerH && p.y <= player.y) {
          if (p.type === "double") doubleFireUntil = performance.now() + DOUBLE_DURATION;
          else rapidFireUntil = performance.now() + RAPID_DURATION;
          powerUpMsg = 120;
          return false;
        }
        return p.y < gameCanvas.height;
      });
    }

    // Move player bullets
    playerBullets = playerBullets.filter((b) => {
      b.y -= 5 * S;
      return b.y + BULLET_H > 0;
    });

    // Move alien bullets
    alienBullets = alienBullets.filter((b) => {
      b.y += 2 * S;
      return b.y < gameCanvas.height;
    });

    // Move alien formation
    const alive = liveAliens();
    if (alive.length === 0) return;

    const totalForWave = waveCfg.rows * waveCfg.cols;
    const speedMult = 1 + (1 - alive.length / totalForWave) * 1.5;
    const step = alienSpeedX * alienDirX * speedMult;
    for (const a of aliens) if (a.alive) a.x += step;

    // Wall bounce: shift formation back and descend
    let minX = Infinity,
      maxX = -Infinity;
    for (const a of alive) {
      if (a.x < minX) minX = a.x;
      if (a.x + alienW > maxX) maxX = a.x + alienW;
    }
    if (maxX >= gameCanvas.width || minX <= 0) {
      alienDirX *= -1;
      const overshoot = maxX >= gameCanvas.width ? maxX - gameCanvas.width : -minX;
      for (const a of aliens) {
        if (!a.alive) continue;
        a.x += alienDirX * overshoot;
        a.y += alienH * 0.5;
      }
    }

    // Alien shooting (skip if shoot interval is 0 or in demo)
    if (waveCfg.shoot > 0 && !demo) {
      alienShootTimer++;
      if (alienShootTimer >= waveCfg.shoot) {
        alienShootTimer = 0;
        const shooter = alive[Math.floor(Math.random() * alive.length)];
        alienBullets.push({ x: shooter.x + alienW / 2, y: shooter.y + alienH });
      }
    }

    if (demo) return;

    // Collision: player bullet ↔ Gift
    if (gift) {
      for (let bi = playerBullets.length - 1; bi >= 0; bi--) {
        const b = playerBullets[bi];
        if (Math.abs(b.x - gift.x) < alienW / 2 && Math.abs(b.y - gift.y) < alienH / 2) {
          powerUps.push({ x: gift.x, y: gift.y, type: "double" });
          score += 80;
          updateHUD();
          if (score > best) {
            best = score;
            localStorage.setItem(STORAGE_KEY, best);
            launchConfetti();
            updateHUD();
          }
          gift = null;
          playerBullets.splice(bi, 1);
          break;
        }
      }
    }

    // Collision: player bullet ↔ UFO
    if (ufo) {
      for (let bi = playerBullets.length - 1; bi >= 0; bi--) {
        const b = playerBullets[bi];
        if (Math.abs(b.x - ufo.x) < alienW / 2 && Math.abs(b.y - ufo.y) < alienH / 2) {
          powerUps.push({ x: ufo.x, y: ufo.y, type: "rapid" });
          score += 100;
          updateHUD();
          if (score > best) {
            best = score;
            localStorage.setItem(STORAGE_KEY, best);
            launchConfetti();
            updateHUD();
          }
          ufo = null;
          playerBullets.splice(bi, 1);
          break;
        }
      }
    }

    // Collision: player bullet ↔ alien
    outer: for (let bi = playerBullets.length - 1; bi >= 0; bi--) {
      const b = playerBullets[bi];
      for (const a of aliens) {
        if (!a.alive) continue;
        if (b.x >= a.x && b.x <= a.x + alienW && b.y >= a.y && b.y <= a.y + alienH) {
          a.alive = false;
          playerBullets.splice(bi, 1);
          score += a.isSecret ? a.points + SECRET_BONUS : a.points;
          if (a.isSecret) powerUps.push({ x: a.x + alienW / 2, y: a.y + alienH / 2 });
          if (score > best) {
            best = score;
            localStorage.setItem(STORAGE_KEY, best);
            launchConfetti();
          }
          updateHUD();
          continue outer;
        }
      }
    }

    // Collision: alien bullet ↔ player
    for (let bi = alienBullets.length - 1; bi >= 0; bi--) {
      const b = alienBullets[bi];
      if (
        b.x >= player.x - playerW / 2 &&
        b.x <= player.x + playerW / 2 &&
        b.y >= player.y - playerH &&
        b.y <= player.y
      ) {
        alienBullets.splice(bi, 1);
        loseLife();
        return;
      }
    }

    // Any alien reaches the ground line → game over
    for (const a of alive) {
      if (a.y + alienH >= gameCanvas.height - 10 * S) {
        gameOver();
        return;
      }
    }

    // All dead → wave cleared
    if (liveAliens().length === 0) {
      launchConfetti();
      startNextWave();
    }
  }

  function loseLife() {
    lives--;
    updateHUD();
    if (lives <= 0) {
      gameOver();
    } else {
      player.x = gameCanvas.width / 2;
      playerBullets = [];
      alienBullets = [];
    }
  }

  function gameOver() {
    running = false;
    cancelAnimationFrame(animId);
    document.getElementById("go-score").textContent = score;
    document.getElementById("go-best").textContent = best;
    document.getElementById("go-wave").textContent = wave;
    document.getElementById("overlay").style.display = "none";
    document.getElementById("gameover-overlay").style.display = "flex";
  }

  // ── Game loop ─────────────────────────────────────────────────────────────
  function gameLoop() {
    update(false);
    draw();
    if (running) animId = requestAnimationFrame(gameLoop);
  }

  function demoLoop() {
    update(true);
    draw();
    if (!running) animId = requestAnimationFrame(demoLoop);
  }

  // ── Start / restart ───────────────────────────────────────────────────────
  function startDemo() {
    running = false;
    cancelAnimationFrame(animId);
    // Demo uses wave 4 config (1 row × 7) so it looks interesting
    score = 0;
    wave = 4;
    lives = 3;
    playerBullets = [];
    alienBullets = [];
    waveCfg = getWaveCfg(wave);
    aliens = makeAliens(waveCfg);
    alienDirX = 1;
    alienSpeedX = waveCfg.speed;
    alienShootTimer = 0;
    frameCount = 0;
    waveAnnounce = 0;
    player = { x: gameCanvas.width / 2, y: gameCanvas.height - 30 * S };
    animId = requestAnimationFrame(demoLoop);
  }

  function startGame() {
    cancelAnimationFrame(animId);
    running = true;
    document.getElementById("demo-label").style.display = "none";
    document.getElementById("overlay").style.display = "none";
    document.getElementById("gameover-overlay").style.display = "none";
    initState();
    animId = requestAnimationFrame(gameLoop);
  }

  // ── Input ─────────────────────────────────────────────────────────────────
  document.addEventListener("keydown", (e) => {
    if (["ArrowLeft", "ArrowRight"].includes(e.key)) e.preventDefault();
    keys[e.key] = true;
  });
  document.addEventListener("keyup", (e) => {
    keys[e.key] = false;
  });

  function wire(btn, downFn, upFn) {
    btn.addEventListener(
      "touchstart",
      (e) => {
        e.preventDefault();
        downFn();
      },
      { passive: false }
    );
    btn.addEventListener(
      "touchend",
      (e) => {
        e.preventDefault();
        upFn();
      },
      { passive: false }
    );
    btn.addEventListener(
      "touchcancel",
      (e) => {
        e.preventDefault();
        upFn();
      },
      { passive: false }
    );
    btn.addEventListener("mousedown", downFn);
    btn.addEventListener("mouseup", upFn);
    btn.addEventListener("mouseleave", upFn);
  }

  wire(
    document.getElementById("btn-left"),
    () => {
      dpadLeft = true;
    },
    () => {
      dpadLeft = false;
    }
  );
  wire(
    document.getElementById("btn-right"),
    () => {
      dpadRight = true;
    },
    () => {
      dpadRight = false;
    }
  );

  // ── Boot ──────────────────────────────────────────────────────────────────
  startDemo();
</script>
