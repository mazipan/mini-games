  const canvas = document.getElementById("canvas");
  const ctx = canvas.getContext("2d");

  const DESIGN = 320;
  const SIZE = Math.min(DESIGN, window.innerWidth - 32);
  canvas.width = SIZE;
  canvas.height = Math.round(SIZE * 1.6);
  const S = SIZE / DESIGN;

  const COLS = 4;
  const TILE_W = canvas.width / COLS;
  const TILE_H = Math.round(120 * S);

  const BEST_KEYS = {
    easy: "mini-piano-tiles-best-easy",
    medium: "mini-piano-tiles-best-medium",
    hard: "mini-piano-tiles-best-hard",
  };

  const TILE_COLORS = ["#60a5fa", "#4ade80", "#fbbf24", "#f87171"];
