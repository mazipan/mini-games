  // ─── Audio ───────────────────────────────────────────────────────────────────
  let audioCtx = null;
  function getAudioCtx() {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    return audioCtx;
  }

  function playNote(freq) {
    if (!freq) return;
    const ac = getAudioCtx();
    const osc = ac.createOscillator();
    const osc2 = ac.createOscillator();
    const gain = ac.createGain();
    const gain2 = ac.createGain();
    osc.type = "triangle";
    osc.frequency.value = freq;
    osc2.type = "sine";
    osc2.frequency.value = freq * 2;
    gain2.gain.value = 0.15;
    osc.connect(gain);
    osc2.connect(gain2);
    gain2.connect(gain);
    gain.connect(ac.destination);
    const t = ac.currentTime;
    gain.gain.setValueAtTime(0.001, t);
    gain.gain.linearRampToValueAtTime(0.4, t + 0.015);
    gain.gain.exponentialRampToValueAtTime(0.001, t + 0.9);
    osc.start(t);
    osc2.start(t);
    osc.stop(t + 0.9);
    osc2.stop(t + 0.9);
  }

  function bpmToSpeed(bpm) {
    return (bpm / 65) * 2 * S;
  }

  // ─── State ───────────────────────────────────────────────────────────────────
  let score, level, tapsCount, speed, tiles, running, animId, lives;
  let currentSong, noteIndex, currentDifficulty;

  function bestKey() {
    return BEST_KEYS[currentDifficulty] || BEST_KEYS.easy;
  }

  function loadBest() {
    return parseInt(localStorage.getItem(bestKey()) || "0", 10);
  }

  function livesDisplay(n) {
    return "❤️".repeat(Math.max(0, n)) + "🖤".repeat(Math.max(0, 3 - n));
  }

  // ─── Overlay navigation ──────────────────────────────────────────────────────
  function showDiffStep() {
    document.getElementById("step-diff").style.display = "";
    document.getElementById("step-songs").style.display = "none";
    document.getElementById("step-play").style.display = "none";
  }

  function showSongStep(diff) {
    currentDifficulty = diff;
    ["easy", "medium", "hard"].forEach((d) => {
      document.getElementById("btn-" + d).classList.toggle("active", d === diff);
    });
    document.getElementById("step-diff-label").textContent = diff.charAt(0).toUpperCase() + diff.slice(1);

    const list = document.getElementById("song-list");
    list.innerHTML = "";

    // Random option
    const rnd = document.createElement("button");
    rnd.className = "song-option random-btn";
    rnd.textContent = "🎲 Random";
    rnd.onclick = () => selectSong(null);
    list.appendChild(rnd);

    SONGS[diff].forEach((song) => {
      const btn = document.createElement("button");
      btn.className = "song-option";
      btn.innerHTML = `<span>${song.name}</span><span class="song-opt-artist">${song.artist} · ${song.year}</span>`;
      btn.onclick = () => selectSong(song);
      list.appendChild(btn);
    });

    document.getElementById("step-diff").style.display = "none";
    document.getElementById("step-songs").style.display = "";
    document.getElementById("step-play").style.display = "none";
  }

  function selectSong(song) {
    const pool = SONGS[currentDifficulty];
    currentSong = song || pool[Math.floor(Math.random() * pool.length)];
    noteIndex = 0;

    document.getElementById("card-song").textContent = currentSong.name;
    document.getElementById("card-artist").textContent = `${currentSong.artist} · ${currentSong.year}`;
    document.getElementById("card-fact").textContent = currentSong.fact;
    document.getElementById("song-name").textContent = currentSong.name;

    const best = loadBest();
    document.getElementById("best-display").textContent = best;

    document.getElementById("step-diff").style.display = "none";
    document.getElementById("step-songs").style.display = "none";
    document.getElementById("step-play").style.display = "";
  }

  function showOverlay() {
    cancelAnimationFrame(animId);
    running = false;
    document.getElementById("gameover-overlay").style.display = "none";
    document.getElementById("overlay").style.display = "flex";
    showDiffStep();
  }

  // ─── Spawning ─────────────────────────────────────────────────────────────────
  function spawnTile() {
    const note = currentSong.notes[noteIndex % currentSong.notes.length];
    noteIndex++;
    tiles.push({ col: note[0], freq: note[1], y: -TILE_H, tapped: false });
  }

  // ─── Game loop ───────────────────────────────────────────────────────────────
  function update() {
    tiles.forEach((t) => {
      t.y += speed;
    });

    for (const t of tiles) {
      if (!t.tapped && t.y > canvas.height) {
        t.tapped = true;
        lives--;
        document.getElementById("lives-display").textContent = livesDisplay(lives);
        if (lives <= 0) {
          endGame();
          return;
        }
      }
    }

    tiles = tiles.filter((t) => t.y < canvas.height + TILE_H);

    const last = tiles[tiles.length - 1];
    if (!last || last.y > 0) spawnTile();
  }

  function draw() {
    ctx.fillStyle = "#0f172a";
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    ctx.strokeStyle = "#1e293b";
    ctx.lineWidth = 1;
    for (let i = 1; i < COLS; i++) {
      ctx.beginPath();
      ctx.moveTo(i * TILE_W, 0);
      ctx.lineTo(i * TILE_W, canvas.height);
      ctx.stroke();
    }

    const hitY = canvas.height * 0.85;
    ctx.strokeStyle = "#7c3aed";
    ctx.lineWidth = 2 * S;
    ctx.beginPath();
    ctx.moveTo(0, hitY);
    ctx.lineTo(canvas.width, hitY);
    ctx.stroke();

    tiles.forEach((t) => {
      ctx.fillStyle = t.tapped ? TILE_TAPPED[t.col] : TILE_COLORS[t.col];
      ctx.fillRect(t.col * TILE_W + 1, t.y, TILE_W - 2, TILE_H - 2);
    });
  }

  function loop() {
    update();
    draw();
    if (running) animId = requestAnimationFrame(loop);
  }

  // ─── Input ───────────────────────────────────────────────────────────────────
  canvas.addEventListener("click", (e) => {
    if (!running) return;
    const rect = canvas.getBoundingClientRect();
    const x = (e.clientX - rect.left) * (canvas.width / rect.width);
    const y = (e.clientY - rect.top) * (canvas.height / rect.height);
    const col = Math.floor(x / TILE_W);

    const hit = tiles.filter((t) => t.col === col && !t.tapped).find((t) => y >= t.y && y <= t.y + TILE_H);

    if (hit) {
      hit.tapped = true;
      playNote(hit.freq);
      score += 10;
      tapsCount++;
      if (tapsCount % 10 === 0) {
        level++;
        speed = bpmToSpeed(currentSong.bpm) + (level - 1) * 0.4 * S;
      }
      document.getElementById("score-display").textContent = score;
      document.getElementById("level-display").textContent = level;
    }
    // wrong tap: no penalty (just ignore)
  });

  canvas.addEventListener(
    "touchstart",
    (e) => {
      e.preventDefault();
      const touch = e.touches[0];
      canvas.dispatchEvent(new MouseEvent("click", { clientX: touch.clientX, clientY: touch.clientY }));
    },
    { passive: false }
  );

  // ─── Game control ─────────────────────────────────────────────────────────────
  function startGame() {
    score = 0;
    level = 1;
    tapsCount = 0;
    lives = 3;
    tiles = [];
    running = true;
    speed = bpmToSpeed(currentSong.bpm);
    noteIndex = 0;

    document.getElementById("overlay").style.display = "none";
    document.getElementById("gameover-overlay").style.display = "none";
    document.getElementById("score-display").textContent = "0";
    document.getElementById("level-display").textContent = "1";
    document.getElementById("lives-display").textContent = livesDisplay(3);

    spawnTile();
    cancelAnimationFrame(animId);
    animId = requestAnimationFrame(loop);
  }

  function endGame() {
    running = false;
    cancelAnimationFrame(animId);

    const best = loadBest();
    if (score > best) {
      localStorage.setItem(bestKey(), score);
      document.getElementById("best-display").textContent = score;
      launchConfetti();
    }

    document.getElementById("go-score").textContent = score;
    document.getElementById("go-best").textContent = Math.max(score, best);
    document.getElementById("go-level").textContent = level;
    document.getElementById("gameover-overlay").style.display = "flex";
  }

  // ─── Confetti ─────────────────────────────────────────────────────────────────
  function launchConfetti() {
    const confCanvas = document.createElement("canvas");
    confCanvas.style.cssText = "position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999";
    document.body.appendChild(confCanvas);
    const confCtx = confCanvas.getContext("2d");
    confCanvas.width = window.innerWidth;
    confCanvas.height = window.innerHeight;
    const colors = ["#7c3aed", "#db2777", "#f59e0b", "#10b981", "#3b82f6", "#ef4444", "#fbbf24"];
    const pieces = Array.from({ length: 80 }, () => ({
      x: Math.random() * confCanvas.width,
      y: -10 - Math.random() * 40,
      r: Math.random() * 6 + 3,
      color: colors[Math.floor(Math.random() * colors.length)],
      vx: (Math.random() - 0.5) * 5,
      vy: Math.random() * 4 + 2,
      angle: Math.random() * Math.PI * 2,
      va: (Math.random() - 0.5) * 0.15,
    }));
    const start = performance.now();
    function drawConf(now) {
      if (now - start > 1500) {
        confCanvas.remove();
        return;
      }
      confCtx.clearRect(0, 0, confCanvas.width, confCanvas.height);
      pieces.forEach((p) => {
        p.x += p.vx;
        p.y += p.vy;
        p.angle += p.va;
        confCtx.save();
        confCtx.translate(p.x, p.y);
        confCtx.rotate(p.angle);
        confCtx.fillStyle = p.color;
        confCtx.fillRect(-p.r, -p.r / 2, p.r * 2, p.r);
        confCtx.restore();
      });
      requestAnimationFrame(drawConf);
    }
    requestAnimationFrame(drawConf);
  }

  // ─── Init ─────────────────────────────────────────────────────────────────────
  document.getElementById("score-display").textContent = "0";
  document.getElementById("level-display").textContent = "1";
  document.getElementById("best-display").textContent = loadBest();
  document.getElementById("lives-display").textContent = livesDisplay(3);
  currentDifficulty = "easy";
  showDiffStep();
</script>
