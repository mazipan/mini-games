---
layout: layouts/game.njk
title: Piano Tiles
description: Tap the falling black tiles before they pass — don't miss one or tap the white!
category: arcade
icon: "🎹"
---

{% from "macros/game-components.njk" import statCard, summaryStatCard, infoDetails %}

<style>
  #game-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: calc(100vh - 60px);
    gap: 1rem;
    padding: 1rem;
  }
  .score-row {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.5rem 1rem;
  }
  .stat-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .stat-value {
    font-size: 1.2rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  .canvas-wrapper {
    position: relative;
    touch-action: none;
    line-height: 0;
  }
  canvas {
    border: 2px solid #1e3a5f;
    border-radius: 4px;
    display: block;
    cursor: pointer;
  }
  #overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.9);
    border-radius: 4px;
    gap: 0.65rem;
    line-height: normal;
    padding: 1rem;
    overflow-y: auto;
  }
  #overlay h2 {
    font-size: 1.6rem;
    font-weight: bold;
    color: white;
    margin: 0;
  }
  #overlay p {
    color: #94a3b8;
    font-size: 0.82rem;
    margin: 0;
    text-align: center;
  }
  .play-btn {
    padding: 0.5rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    background: #7c3aed;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .play-btn:hover {
    background: #6d28d9;
  }
  /* Difficulty buttons (inside overlay) */
  .diff-row {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .diff-btn {
    padding: 0.35rem 0.9rem;
    font-size: 0.8rem;
    font-weight: 600;
    background: #1e293b;
    color: #94a3b8;
    border: 1px solid #334155;
    border-radius: 6px;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .diff-btn:hover {
    background: #334155;
    color: #e2e8f0;
  }
  .diff-btn.active {
    background: #7c3aed;
    color: white;
    border-color: #7c3aed;
  }
  /* Song list in overlay */
  #song-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    width: 100%;
    max-height: 220px;
    overflow-y: auto;
  }
  .song-option {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 0.4rem 0.75rem;
    cursor: pointer;
    text-align: left;
    color: #e2e8f0;
    font-size: 0.8rem;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: background 0.15s;
  }
  .song-option:hover {
    background: #2d3f55;
  }
  .song-option .song-opt-artist {
    font-size: 0.68rem;
    color: #94a3b8;
    display: block;
    margin-top: 0.1rem;
  }
  .song-option.random-btn {
    background: #1e293b;
    border-color: #7c3aed;
    color: #a78bfa;
    text-align: center;
  }
  /* Song intro card */
  #song-card {
    background: rgba(124, 58, 237, 0.15);
    border: 1px solid rgba(124, 58, 237, 0.4);
    border-radius: 8px;
    padding: 0.6rem 1rem;
    width: 100%;
    text-align: center;
  }
  #card-song {
    font-size: 0.95rem;
    font-weight: bold;
    color: #e2e8f0;
    margin-bottom: 0.2rem;
  }
  #card-artist {
    font-size: 0.72rem;
    color: #a78bfa;
    margin-bottom: 0.4rem;
  }
  #card-fact {
    font-size: 0.7rem;
    color: #94a3b8;
    line-height: 1.4;
    font-style: italic;
  }
  /* Game over overlay */
  #gameover-overlay {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.95);
    border-radius: 4px;
    gap: 0.75rem;
    line-height: normal;
    padding: 1rem;
  }
  #gameover-overlay span:first-child {
    font-size: 2.5rem;
  }
  #gameover-overlay h2 {
    font-size: 1.4rem;
    font-weight: bold;
    color: white;
    margin: 0;
  }
  .summary-row {
    display: flex;
    gap: 0.75rem;
  }
  .summary-stat {
    text-align: center;
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.4rem 0.9rem;
  }
  .summary-label {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .summary-value {
    font-size: 1.2rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  /* Now playing bar */
  #now-playing {
    font-size: 0.8rem;
    color: #94a3b8;
    text-align: center;
  }
  #now-playing strong {
    color: #e2e8f0;
  }
  /* Info section */
  .info-section {
    width: 100%;
    max-width: 520px;
  }
  .info-details {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    margin-bottom: 0.5rem;
    overflow: hidden;
  }
  .info-details summary {
    padding: 0.75rem 1rem;
    cursor: pointer;
    font-weight: 600;
    color: #e2e8f0;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .info-details summary::before {
    content: "▶";
    font-size: 0.7rem;
    transition: transform 0.2s;
    color: #7c3aed;
  }
  .info-details[open] summary::before {
    transform: rotate(90deg);
  }
  .info-body {
    padding: 0 1rem 1rem;
    color: #94a3b8;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .info-body h4 {
    color: #e2e8f0;
    margin: 0.75rem 0 0.25rem;
    font-size: 0.9rem;
