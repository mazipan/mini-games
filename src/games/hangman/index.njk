      "SHORE",
      "SLOPE",
      "STORM",
      "SWAMP",
      "VALLEY",
      "CANYON",
      "DESERT",
      "FOREST",
      "GEYSER",
      "JUNGLE",
      "MEADOW",
      "TUNDRA",
      "VOLCANO",
      "BLIZZARD",
      "ESTUARY",
      "GLACIER",
      "RAINBOW",
      "TORNADO",
      "TSUNAMI",
      "SAVANNA",
      "PLATEAU",
      "WATERFALL",
      "PENINSULA",
      "AVALANCHE",
      "RAINFOREST",
      "EARTHQUAKE",
      "ATMOSPHERE",
      "THUNDERSTORM",
      "ARCHIPELAGO",
    ],
  };

  const CAT_LABELS = {
    animals: "🐾 Animals",
    countries: "🌍 Countries",
    foods: "🍕 Foods",
    sports: "⚽ Sports",
    nature: "🌿 Nature",
  };

  let difficulty = "easy";
  let selectedCat = "random";
  let word = "";
  let activeCat = "";
  let guessed = new Set();
  let wrongCount = 0;
  let streak = 0;
  let best = parseInt(localStorage.getItem(STORAGE_KEY) || "0", 10);
  let gameActive = false;
  let hints = 3;

  document.getElementById("streak-display").textContent = streak;
  document.getElementById("best-display").textContent = best;

  function setDiff(d) {
    difficulty = d;
    document.querySelectorAll("#diff-row .sel-btn").forEach((b) => b.classList.remove("active"));
    document.getElementById("d-" + d).classList.add("active");
  }

  function setCat(c) {
    selectedCat = c;
    document.querySelectorAll("#cat-row .sel-btn").forEach((b) => b.classList.remove("active"));
    document.getElementById("c-" + c).classList.add("active");
  }

  function pickWord() {
    const cats = Object.keys(WORDS);
    activeCat = selectedCat === "random" ? cats[Math.floor(Math.random() * cats.length)] : selectedCat;
    const pool = WORDS[activeCat].filter((w) => {
      if (difficulty === "easy") return w.length >= 4 && w.length <= 6;
      if (difficulty === "medium") return w.length >= 7 && w.length <= 9;
      return w.length >= 10;
    });
    if (!pool.length) return WORDS[activeCat][Math.floor(Math.random() * WORDS[activeCat].length)];
    return pool[Math.floor(Math.random() * pool.length)];
  }

  function updateHintDisplay() {
    const btn = document.getElementById("hint-btn");
    const count = document.getElementById("hint-count");
    if (!btn) return;
    count.textContent = hints;
    btn.disabled = hints <= 0 || !gameActive;
  }

  function useHint() {
    if (hints <= 0 || !gameActive) return;
    const hidden = word.split("").filter((ch) => ch !== " " && !guessed.has(ch));
    if (!hidden.length) return;
    const ch = hidden[Math.floor(Math.random() * hidden.length)];
    hints--;
    guess(ch);
  }

  function startGame() {
    word = pickWord();
    guessed = new Set();
    wrongCount = 0;
    gameActive = true;

    BODY_PARTS.forEach((id) => (document.getElementById(id).style.display = "none"));
    document.getElementById("wrong-count").textContent = "0 / 6";
    document.getElementById("category-hint").textContent = CAT_LABELS[activeCat];
    document.getElementById("wrong-letters").innerHTML = "";

    renderWord();
    renderKeyboard();
    updateHintDisplay();

    document.getElementById("overlay").style.display = "none";
    document.getElementById("gameover-overlay").style.display = "none";
  }

  function renderWord() {
    const el = document.getElementById("word-display");
    el.innerHTML = word
      .split("")
      .map((ch) => {
        if (ch === " ") return `<div class="letter-tile space"><span class="letter-char"> </span></div>`;
        const shown = guessed.has(ch);
        return `<div class="letter-tile">
          <span class="letter-char">${shown ? ch : " "}</span>
          <div class="letter-bar"></div>
        </div>`;
      })
      .join("");
  }

  function renderKeyboard() {
    const kb = document.getElementById("keyboard");
    kb.innerHTML = KEYBOARD_ROWS.map(
      (row) =>
        `<div class="key-row">${row
          .split("")
          .map((ch) => {
            const isGuessed = guessed.has(ch);
            const isCorrect = isGuessed && word.includes(ch);
            const cls = isCorrect ? "correct" : isGuessed ? "wrong" : "";
            return `<button class="key-btn ${cls}" id="key-${ch}" onclick="guess('${ch}')" ${isGuessed ? "disabled" : ""}>${ch}</button>`;
          })
          .join("")}</div>`
    ).join("");
  }

  function guess(ch) {
    if (!gameActive || guessed.has(ch)) return;
    guessed.add(ch);

    const btn = document.getElementById("key-" + ch);
    if (btn) btn.disabled = true;

    if (word.includes(ch)) {
      if (btn) btn.classList.add("correct");
      renderWord();
      if (
        word
          .split("")
          .filter((c) => c !== " ")
          .every((c) => guessed.has(c))
      ) {
        showEnd(true);
      }
    } else {
      if (btn) btn.classList.add("wrong");
      wrongCount++;
      document.getElementById("wrong-count").textContent = wrongCount + " / 6";

      const wrongEl = document.createElement("span");
      wrongEl.className = "wrong-letter";
      wrongEl.textContent = ch;
      document.getElementById("wrong-letters").appendChild(wrongEl);

      document.getElementById(BODY_PARTS[wrongCount - 1]).style.display = "";
      if (wrongCount >= MAX_WRONG) showEnd(false);
    }
  }

  function showEnd(won) {
    gameActive = false;
    updateHintDisplay();

    if (won) {
      streak++;
      launchConfetti();
      if (streak > best) {
        best = streak;
        localStorage.setItem(STORAGE_KEY, best);
        document.getElementById("best-display").textContent = best;
      }
    } else {
      streak = 0;
    }

    document.getElementById("streak-display").textContent = streak;

    document.getElementById("go-icon").textContent = won ? "🏆" : "💀";
    document.getElementById("go-title").textContent = won ? "You Win!" : "Game Over";
    document.getElementById("go-word-reveal").innerHTML = won
      ? `The word was <strong>${word}</strong> — well done!`
      : `The word was <strong>${word}</strong>`;
    document.getElementById("go-streak").textContent = streak;
    document.getElementById("go-best").textContent = best;

    document.getElementById("gameover-overlay").style.display = "flex";
  }

  // Physical keyboard support
  document.addEventListener("keydown", (e) => {
    if (!gameActive) return;
    const ch = e.key.toUpperCase();
    if (/^[A-Z]$/.test(ch)) guess(ch);
  });
</script>
