<div id="game-wrapper">
  <div class="score-row">
    {{ statCard("Streak", "streak-display") }} {{ statCard("Best", "best-display") }} {{ statCard("Wrong",
    "wrong-count", "0 / 6") }}
  </div>

  <div id="game-area">
    <svg id="hangman-svg" viewBox="0 0 160 200" xmlns="http://www.w3.org/2000/svg">
      <line class="gallows" x1="10" y1="190" x2="150" y2="190" />
      <line class="gallows" x1="50" y1="190" x2="50" y2="10" />
      <line class="gallows" x1="50" y1="10" x2="110" y2="10" />
      <line class="gallows" x1="110" y1="10" x2="110" y2="32" />
      <circle id="hm-head" class="body-part" cx="110" cy="48" r="16" style="display: none" />
      <line id="hm-body" class="body-part" x1="110" y1="64" x2="110" y2="115" style="display: none" />
      <line id="hm-larm" class="body-part" x1="110" y1="78" x2="84" y2="102" style="display: none" />
      <line id="hm-rarm" class="body-part" x1="110" y1="78" x2="136" y2="102" style="display: none" />
      <line id="hm-lleg" class="body-part" x1="110" y1="115" x2="86" y2="150" style="display: none" />
      <line id="hm-rleg" class="body-part" x1="110" y1="115" x2="134" y2="150" style="display: none" />
    </svg>

    <div id="category-hint"></div>
    <div id="word-display"></div>
    <button id="hint-btn" class="hint-btn" onclick="useHint()">💡 Hint (<span id="hint-count">3</span>)</button>

    <div id="wrong-section">
      <div id="wrong-label">Wrong guesses</div>
      <div id="wrong-letters"></div>
    </div>

    <div id="keyboard"></div>
  </div>

  <div id="overlay">
    <span>🪢</span>
    <h2>Hangman</h2>
    <p>Guess the hidden word before the hangman is drawn!</p>
    <div class="sel-label">Difficulty</div>
    <div class="sel-row" id="diff-row">
      <button class="sel-btn active" id="d-easy" onclick="setDiff('easy')">Easy (4–6)</button>
      <button class="sel-btn" id="d-medium" onclick="setDiff('medium')">Medium (7–9)</button>
      <button class="sel-btn" id="d-hard" onclick="setDiff('hard')">Hard (10+)</button>
    </div>
    <div class="sel-label">Category</div>
    <div class="sel-row" id="cat-row">
      <button class="sel-btn active" id="c-random" onclick="setCat('random')">🎲 Random</button>
      <button class="sel-btn" id="c-animals" onclick="setCat('animals')">🐾 Animals</button>
      <button class="sel-btn" id="c-countries" onclick="setCat('countries')">🌍 Countries</button>
      <button class="sel-btn" id="c-foods" onclick="setCat('foods')">🍕 Foods</button>
      <button class="sel-btn" id="c-sports" onclick="setCat('sports')">⚽ Sports</button>
      <button class="sel-btn" id="c-nature" onclick="setCat('nature')">🌿 Nature</button>
    </div>
    <button class="play-btn" onclick="startGame()">Play Game</button>
  </div>

  <div id="gameover-overlay">
    <span id="go-icon">💀</span>
    <h2 id="go-title">Game Over</h2>
    <p id="go-word-reveal"></p>
    <div class="summary-row">{{ summaryStatCard("Streak", "go-streak") }} {{ summaryStatCard("Best", "go-best") }}</div>
    <button class="play-btn" onclick="startGame()">New Word</button>
  </div>
</div>

<div class="info-section">
  {% call infoDetails("How to Play") %}
  <h4>Goal</h4>
  <p>Reveal the hidden word by guessing letters. You have 6 wrong guesses before the hangman is complete.</p>
  <h4>Controls</h4>
  <ul>
    <li><strong>Click / Tap</strong> any letter button on screen</li>
    <li><strong>Keyboard</strong> — just type letters directly</li>
  </ul>
  <h4>Difficulty</h4>
  <ul>
    <li><strong>Easy</strong> — short words (4–6 letters)</li>
    <li><strong>Medium</strong> — mid-length words (7–9 letters)</li>
    <li><strong>Hard</strong> — long words (10+ letters)</li>
  </ul>
  <h4>Scoring</h4>
  <p>Win words to build a streak. Your longest streak is saved as your best score.</p>
  {% endcall %} {% call infoDetails("FAQ") %}
  <h4>Is my best score saved?</h4>
  <p>Yes — your longest winning streak is saved in your browser's local storage.</p>
  <h4>What happens to my streak when I lose?</h4>
  <p>Losing resets the current streak to zero. Click "New Word" to start a fresh run.</p>
  <h4>Can I change the category mid-game?</h4>
  <p>Category and difficulty can be changed from the start screen. Each "New Word" continues with the same settings.</p>
  <h4>Can I type letters on my keyboard?</h4>
  <p>Yes! Just press any letter key while the game is active and it counts as your guess.</p>
  {% endcall %}
</div>

<script>
  function launchConfetti() {
    const canvas = document.createElement("canvas");
    canvas.style.cssText = "position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:9999";
    document.body.appendChild(canvas);
    const ctx = canvas.getContext("2d");
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    const particles = Array.from({ length: 80 }, () => ({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height - canvas.height,
      r: Math.random() * 6 + 3,
      d: Math.random() * 80,
      color: `hsl(${Math.random() * 360},90%,60%)`,
      tilt: Math.random() * 10 - 10,
      tiltAngle: 0,
      tiltSpeed: Math.random() * 0.1 + 0.05,
    }));
    let frame = 0;
    function draw() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      particles.forEach((p) => {
        ctx.beginPath();
        ctx.fillStyle = p.color;
        ctx.ellipse(p.x, p.y, p.r, p.r * 0.4, p.tilt, 0, Math.PI * 2);
        ctx.fill();
        p.y += Math.cos(p.d) + 2 + p.r / 10;
        p.x += Math.sin(frame / 20) * 1.5;
        p.tiltAngle += p.tiltSpeed;
        p.tilt = Math.sin(p.tiltAngle) * 12;
        if (p.y > canvas.height) {
          p.y = -10;
          p.x = Math.random() * canvas.width;
        }
      });
      frame++;
      if (frame < 180) requestAnimationFrame(draw);
      else canvas.remove();
    }
    draw();
  }

