  }
  .letter-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 1.8rem;
  }
  .letter-char {
    font-size: 1.3rem;
    font-weight: bold;
    font-family: monospace;
    color: #e2e8f0;
