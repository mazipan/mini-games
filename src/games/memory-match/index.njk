---
layout: layouts/game.njk
title: Memory Match
description: Flip cards to find matching pairs. Train your memory and beat the clock.
category: board
icon: "🃏"
---

{% from "macros/game-components.njk" import statCard, infoDetails %}

<style>
  #game-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: calc(100vh - 60px);
    gap: 1.25rem;
    padding: 1rem;
  }
  .score-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.5rem 1rem;
  }
  .stat-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .stat-value {
    font-size: 1.2rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  .difficulty-row {
    display: flex;
    gap: 0.5rem;
  }
  .diff-btn {
    padding: 0.3rem 0.9rem;
    background: #1e293b;
    color: #94a3b8;
    border: 1px solid #334155;
    border-radius: 6px;
    font-size: 0.8rem;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .diff-btn.active,
  .diff-btn:hover {
    background: #334155;
    color: white;
    border-color: #7c3aed;
  }
  .set-row {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    justify-content: center;
    max-width: min(400px, calc(100vw - 2rem));
  }
  .set-btn {
    padding: 0.25rem 0.7rem;
    background: #1e293b;
    color: #94a3b8;
    border: 1px solid #334155;
    border-radius: 6px;
    font-size: 0.75rem;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    white-space: nowrap;
  }
  .set-btn.active,
  .set-btn:hover {
    background: #334155;
    color: white;
    border-color: #7c3aed;
  }
  #grid {
    display: grid;
    gap: 8px;
    width: 100%;
    max-width: min(400px, calc(100vw - 2rem));
  }
  .card {
    aspect-ratio: 1;
    background: #1e293b;
    border: 2px solid #334155;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      transform 0.2s ease,
      border-color 0.2s;
    user-select: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .card span {
    font-size: clamp(1.2rem, 4vw, 2rem);
  }
  .card:not(.flipped):not(.matched) {
    background: linear-gradient(135deg, #1e293b, #273449);
  }
  .card:not(.flipped):not(.matched):hover {
    border-color: #7c3aed;
    transform: scale(1.05);
  }
  .card.flipped {
    background: #2d1b69;
    border-color: #7c3aed;
    transform: scale(1.05);
  }
  .card.matched {
    background: #14532d;
    border-color: #22c55e;
    cursor: default;
  }
  .card:not(.flipped):not(.matched) span {
    visibility: hidden;
  }
  #win-msg {
    display: none;
    text-align: center;
  }
  #win-msg h2 {
    font-size: 1.5rem;
    font-weight: bold;
    color: white;
    margin-bottom: 0.5rem;
  }
  .play-btn {
    padding: 0.5rem 1.5rem;
    background: #7c3aed;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .play-btn:hover {
    background: #6d28d9;
  }
  .info-section {
    width: 100%;
    max-width: 420px;
    padding: 0 1rem 2rem;
    margin: 0 auto;
  }
  .info-details {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    margin-bottom: 0.75rem;
    overflow: hidden;
  }
  .info-details summary {
    padding: 0.75rem 1rem;
    font-weight: 600;
    color: #e2e8f0;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
  }
  .info-details summary::-webkit-details-marker {
    display: none;
  }
  .info-details summary::after {
    content: "+";
    font-size: 1.1rem;
    color: #64748b;
  }
  .info-details[open] summary::after {
    content: "−";
  }
  .info-body {
    padding: 0.75rem 1rem 1rem;
    color: #94a3b8;
    font-size: 0.875rem;
    line-height: 1.6;
    border-top: 1px solid #334155;
  }
  .info-body h4 {
    color: #e2e8f0;
    font-weight: 600;
    margin: 0.75rem 0 0.25rem;
    font-size: 0.875rem;
  }
  .info-body h4:first-child {
    margin-top: 0;
  }
  .info-body ul {
    padding-left: 1.25rem;
    margin: 0.25rem 0;
  }
  .info-body li {
    margin-bottom: 0.25rem;
  }
  .info-body p {
    margin: 0.25rem 0;
  }
</style>

<div id="game-wrapper">
  <div class="difficulty-row">
    <button class="diff-btn active" id="d-easy" onclick="setDiff('easy')">Easy 4×4</button>
    <button class="diff-btn" id="d-medium" onclick="setDiff('medium')">Medium 5×4</button>
    <button class="diff-btn" id="d-hard" onclick="setDiff('hard')">Hard 6×4</button>
  </div>
  <div class="set-row">
    <button class="set-btn active" id="s-animals" onclick="setEmojiSet('animals')">🐶 Animals</button>
    <button class="set-btn" id="s-food" onclick="setEmojiSet('food')">🍎 Food</button>
    <button class="set-btn" id="s-sports" onclick="setEmojiSet('sports')">⚽ Sports</button>
    <button class="set-btn" id="s-nature" onclick="setEmojiSet('nature')">🌸 Nature</button>
    <button class="set-btn" id="s-faces" onclick="setEmojiSet('faces')">😀 Faces</button>
    <button class="set-btn" id="s-things" onclick="setEmojiSet('things')">🎮 Things</button>
  </div>
  <div class="score-row">
    {{ statCard("Moves", "moves") }} {{ statCard("Best", "best-moves", "—") }} {{ statCard("Matched", "matched", "0/8")
    }} {{ statCard("Time", "timer", "0s") }}
  </div>
  <div id="grid"></div>
  <div id="win-msg">
    <h2>🎉 You Won!</h2>
    <p id="win-stats" style="color: #94a3b8; margin-bottom: 1rem"></p>
    <button class="play-btn" onclick="newGame()">Play Again</button>
  </div>
  <button class="play-btn" onclick="newGame()">New Game</button>
</div>

<div class="info-section">
  {% call infoDetails("How to Play") %}
  <h4>Goal</h4>
  <p>
    Flip two cards at a time to find matching emoji pairs. Match all pairs to win! Try to do it in the fewest moves
    possible.
  </p>
  <h4>Emoji Sets</h4>
  <ul>
    <li><strong>Animals</strong> — farm &amp; wild animals</li>
    <li><strong>Food</strong> — fruits, snacks &amp; meals</li>
    <li><strong>Sports</strong> — sport &amp; activity icons</li>
    <li><strong>Nature</strong> — flowers, plants &amp; weather</li>
    <li><strong>Faces</strong> — emoji expressions</li>
    <li><strong>Things</strong> — objects, music &amp; games</li>
  </ul>
  <h4>Difficulty</h4>
  <ul>
    <li><strong>Easy</strong> — 4×4 grid, 8 pairs (16 cards)</li>
    <li><strong>Medium</strong> — 5×4 grid, 10 pairs (20 cards)</li>
    <li><strong>Hard</strong> — 6×4 grid, 12 pairs (24 cards)</li>
  </ul>
  <h4>Scoring</h4>
  <ul>
    <li>Each pair of flips = 1 move</li>
    <li>Fewer moves = better score</li>
    <li>Best (lowest) moves per difficulty saved automatically</li>
  </ul>
  {% endcall %} {% call infoDetails("FAQ") %}
  <h4>What happens when two cards don't match?</h4>
  <p>Both cards flip face-down again after a short pause. Try to memorise their positions!</p>
  <h4>Is my best score saved?</h4>
  <p>Yes — the fewest moves you've used per difficulty is saved in your browser.</p>
  <h4>Can I play on mobile?</h4>
  <p>Yes! Just tap the cards to flip them. The grid automatically adjusts to your screen size.</p>
  {% endcall %}
</div>

<script>
  function launchConfetti() {
    const canvas = document.createElement("canvas");
    canvas.style.cssText = "position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999";
    document.body.appendChild(canvas);
    const ctx = canvas.getContext("2d");
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    const colors = ["#7c3aed", "#db2777", "#f59e0b", "#10b981", "#3b82f6", "#ef4444", "#fbbf24"];
    const pieces = Array.from({ length: 80 }, () => ({
      x: Math.random() * canvas.width,
      y: -10 - Math.random() * 40,
      r: Math.random() * 6 + 3,
      color: colors[Math.floor(Math.random() * colors.length)],
      vx: (Math.random() - 0.5) * 5,
      vy: Math.random() * 4 + 2,
      angle: Math.random() * Math.PI * 2,
      va: (Math.random() - 0.5) * 0.15,
    }));
    const start = performance.now();
    function draw(now) {
      if (now - start > 1500) {
        canvas.remove();
        return;
      }
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      pieces.forEach((p) => {
        p.x += p.vx;
        p.y += p.vy;
        p.angle += p.va;
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.angle);
        ctx.fillStyle = p.color;
        ctx.fillRect(-p.r, -p.r / 2, p.r * 2, p.r);
        ctx.restore();
      });
      requestAnimationFrame(draw);
    }
    requestAnimationFrame(draw);
  }

