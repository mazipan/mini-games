        "💡",
        "🧲",
        "🎭",
        "🎬",
        "🃏",
        "🎪",
        "🎰",
      ],
    },
  };

  const DIFFS = {
    easy: { cols: 4, pairs: 8 },
    medium: { cols: 5, pairs: 10 },
    hard: { cols: 6, pairs: 12 },
  };

  let diff = "easy";
  let setKey = "animals";
  let cards,
    flipped = [],
    matchCount,
    moves,
    locked,
    startTime,
    timerInterval;

  function getBestKey(d) {
    return "mini-memory-best-" + d;
  }
  function getBest(d) {
    const v = localStorage.getItem(getBestKey(d));
    return v ? parseInt(v, 10) : null;
  }
  function setBest(d, v) {
    localStorage.setItem(getBestKey(d), v);
  }

  function showBest() {
    const b = getBest(diff);
    document.getElementById("best-moves").textContent = b !== null ? b : "—";
  }

  function setDiff(d) {
    diff = d;
    document.querySelectorAll(".diff-btn").forEach((b) => b.classList.remove("active"));
    document.getElementById("d-" + d).classList.add("active");
    newGame();
  }

  function setEmojiSet(key) {
    setKey = key;
    document.querySelectorAll(".set-btn").forEach((b) => b.classList.remove("active"));
    document.getElementById("s-" + key).classList.add("active");
    newGame();
  }

  function shuffle(arr) {
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  function newGame() {
    const cfg = DIFFS[diff];
    const pool = EMOJI_SETS[setKey].emojis;
    const pairs = shuffle([...pool]).slice(0, cfg.pairs);
    cards = shuffle([...pairs, ...pairs].map((e, i) => ({ id: i, emoji: e, flipped: false, matched: false })));
    flipped = [];
    matchCount = 0;
    moves = 0;
    locked = false;
    document.getElementById("moves").textContent = "0";
    document.getElementById("matched").textContent = `0/${cfg.pairs}`;
    document.getElementById("win-msg").style.display = "none";
    showBest();
    clearInterval(timerInterval);
    startTime = Date.now();
    timerInterval = setInterval(() => {
      document.getElementById("timer").textContent = Math.floor((Date.now() - startTime) / 1000) + "s";
    }, 1000);
    const grid = document.getElementById("grid");
    grid.style.gridTemplateColumns = `repeat(${cfg.cols}, 1fr)`;
    render();
  }

  function flip(i) {
    if (locked || cards[i].flipped || cards[i].matched) return;
    cards[i].flipped = true;
    flipped.push(i);
    render();
    if (flipped.length === 2) {
      locked = true;
      moves++;
      document.getElementById("moves").textContent = moves;
      const [a, b] = flipped;
      const cfg = DIFFS[diff];
      if (cards[a].emoji === cards[b].emoji) {
        cards[a].matched = cards[b].matched = true;
        matchCount++;
        document.getElementById("matched").textContent = matchCount + "/" + cfg.pairs;
        flipped = [];
        locked = false;
        if (matchCount === cfg.pairs) {
          clearInterval(timerInterval);
          const t = Math.floor((Date.now() - startTime) / 1000);
          const prev = getBest(diff);
          if (prev === null || moves < prev) {
            setBest(diff, moves);
            showBest();
          }
          const isNew = prev === null || moves < prev;
          document.getElementById("win-stats").textContent =
            `${moves} moves · ${t}s` + (isNew ? " · 🏆 New best!" : "");
          document.getElementById("win-msg").style.display = "block";
          launchConfetti();
        }
      } else {
        setTimeout(() => {
          cards[a].flipped = cards[b].flipped = false;
          flipped = [];
          locked = false;
          render();
        }, 900);
      }
    }
  }

  function render() {
    const grid = document.getElementById("grid");
    grid.innerHTML = "";
    cards.forEach((c, i) => {
      const div = document.createElement("div");
      div.className = "card" + (c.flipped ? " flipped" : "") + (c.matched ? " matched" : "");
      div.innerHTML = `<span>${c.emoji}</span>`;
      div.onclick = () => flip(i);
      grid.appendChild(div);
    });
  }

  newGame();
</script>
