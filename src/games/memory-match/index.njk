        "🚴",
        "🏋️",
        "🤸",
        "⛸️",
        "🥋",
        "🎽",
        "🛹",
        "🏆",
      ],
    },
    nature: {
      label: "Nature",
      emojis: [
        "🌸",
        "🌼",
        "🌻",
        "🌹",
        "🌷",
        "🌺",
        "🍀",
