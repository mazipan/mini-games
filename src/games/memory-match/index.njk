        "🍦",
        "🍩",
        "🍪",
        "🎂",
        "🍫",
      ],
    },
    sports: {
      label: "Sports",
      emojis: [
        "⚽",
        "🏀",
        "🏈",
        "⚾",
        "🏐",
        "🏉",
        "🎾",
        "🏓",
        "🏸",
        "🥊",
        "🎯",
        "⛳",
