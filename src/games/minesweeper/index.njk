---
layout: layouts/game.njk
title: Minesweeper
description: Reveal all safe squares without triggering a mine. Use logic and luck.
category: puzzle
icon: "💣"
---

{% from "macros/game-components.njk" import statCard, infoDetails %}

<style>
  #game-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: calc(100vh - 60px);
    gap: 1.25rem;
    padding: 1rem;
  }
  .score-row {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
  }
  .stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.5rem 1rem;
  }
  .stat-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .stat-value {
    font-size: 1.2rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  #board {
    display: grid;
    gap: 2px;
  }
  .cell {
    width: var(--cell-size, 32px);
    height: var(--cell-size, 32px);
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: bold;
    cursor: pointer;
    transition: background 0.1s;
    user-select: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .cell:not(.revealed):not(.flagged):hover {
    background: #273449;
    border-color: #7c3aed;
  }
  .cell.revealed {
    background: #0f172a;
    border-color: #1e293b;
    cursor: default;
  }
  .cell.flagged {
    background: #2d1b4e;
    border-color: #7c3aed;
  }
  .cell.mine-hit {
    background: #7f1d1d;
    border-color: #ef4444;
  }
  .cell.safe-reveal {
    background: #14532d;
    border-color: #22c55e;
  }
  .n1 {
    color: #60a5fa;
  }
  .n2 {
    color: #34d399;
  }
  .n3 {
    color: #f87171;
  }
  .n4 {
    color: #818cf8;
  }
  .n5 {
    color: #f97316;
  }
  .n6 {
    color: #22d3ee;
  }
  .n7 {
    color: #e2e8f0;
  }
  .n8 {
    color: #94a3b8;
  }
  #status {
    font-size: 1rem;
    font-weight: 600;
    color: #e2e8f0;
    min-height: 1.5rem;
    text-align: center;
  }
  .play-btn {
    padding: 0.5rem 1.5rem;
    background: #7c3aed;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .play-btn:hover {
    background: #6d28d9;
  }
  .difficulty-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .diff-btn {
    padding: 0.3rem 0.8rem;
    background: #1e293b;
    color: #94a3b8;
    border: 1px solid #334155;
    border-radius: 6px;
    font-size: 0.8rem;
    cursor: pointer;
    touch-action: manipulation;
  }
  .diff-btn.active,
  .diff-btn:hover {
    background: #334155;
    color: white;
    border-color: #7c3aed;
  }
  .flag-hint {
    font-size: 0.7rem;
    color: #475569;
    text-align: center;
  }
  #board-scroll {
    overflow-x: auto;
    max-width: calc(100vw - 2rem);
  }
  .info-section {
    width: 100%;
    max-width: 480px;
    padding: 0 1rem 2rem;
    margin: 0 auto;
  }
  .info-details {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    margin-bottom: 0.75rem;
    overflow: hidden;
  }
  .info-details summary {
    padding: 0.75rem 1rem;
    font-weight: 600;
    color: #e2e8f0;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
  }
  .info-details summary::-webkit-details-marker {
    display: none;
  }
  .info-details summary::after {
    content: "+";
    font-size: 1.1rem;
    color: #64748b;
  }
  .info-details[open] summary::after {
    content: "−";
  }
  .info-body {
    padding: 0.75rem 1rem 1rem;
    color: #94a3b8;
    font-size: 0.875rem;
    line-height: 1.6;
    border-top: 1px solid #334155;
  }
  .info-body h4 {
    color: #e2e8f0;
    font-weight: 600;
    margin: 0.75rem 0 0.25rem;
    font-size: 0.875rem;
  }
  .info-body h4:first-child {
    margin-top: 0;
  }
  .info-body ul {
    padding-left: 1.25rem;
    margin: 0.25rem 0;
  }
  .info-body li {
    margin-bottom: 0.25rem;
  }
  .info-body p {
    margin: 0.25rem 0;
  }
</style>

<div id="game-wrapper">
  <div class="difficulty-row">
    <button class="diff-btn active" id="d-easy" onclick="setDiff('easy')">Easy 9×9</button>
    <button class="diff-btn" id="d-med" onclick="setDiff('medium')">Medium 16×9</button>
    <button class="diff-btn" id="d-hard" onclick="setDiff('hard')">Hard 16×16</button>
  </div>
  <div class="score-row">
    {{ statCard("Mines", "mine-count", "10") }} {{ statCard("Time", "timer", "0s") }} {{ statCard("Best Time",
    "best-time", "—") }}
    <button class="play-btn" onclick="newGame()">New Game</button>
  </div>
  <div id="status">Left-click to reveal · Right-click to flag</div>
  <p class="flag-hint">Mobile: tap to reveal · long-press to flag</p>
  <div id="board-scroll"><div id="board"></div></div>
</div>

<div class="info-section">
  {% call infoDetails("How to Play") %}
  <h4>Goal</h4>
  <p>
    Reveal all squares that don't contain mines. The number in a revealed square tells you how many mines are in the 8
    surrounding squares.
  </p>
  <h4>Controls — Desktop</h4>
  <ul>
    <li><strong>Left-click</strong> — reveal a square</li>
    <li><strong>Right-click</strong> — place/remove a flag 🚩</li>
  </ul>
  <h4>Controls — Mobile</h4>
  <ul>
    <li><strong>Tap</strong> — reveal a square</li>
    <li><strong>Long-press</strong> — place/remove a flag 🚩</li>
  </ul>
  <h4>Tips</h4>
  <ul>
    <li>The first click is always safe — mines are placed after</li>
    <li>Clicking an empty square (0) automatically reveals neighbours</li>
    <li>Use flags to mark squares you're sure are mines</li>
  </ul>
  {% endcall %} {% call infoDetails("FAQ") %}
  <h4>Is the first click always safe?</h4>
  <p>Yes! Mines are placed after your first click, ensuring you can never hit one immediately.</p>
  <h4>Is my best time saved?</h4>
  <p>Yes — best completion time per difficulty is saved in your browser's local storage.</p>
  <h4>What do the numbers mean?</h4>
  <p>
    A number shows how many mines are among the 8 squares surrounding it. Use this to deduce which squares are safe.
  </p>
  {% endcall %}
</div>

<script>
  const DIFFS = {
    easy: { cols: 9, rows: 9, mines: 10 },
    medium: { cols: 16, rows: 9, mines: 25 },
    hard: { cols: 16, rows: 16, mines: 40 },
  };
  let diff = "easy",
    cols,
    rows,
    mineCount,
    grid,
    revealed,
    flagged,
    gameState = "idle",
    timerInterval,
    startTime,
    timerSecs = 0;

  function getBestKey(d) {
    return "mini-minesweeper-best-" + d;
  }
  function getBest(d) {
    const v = localStorage.getItem(getBestKey(d));
    return v ? parseInt(v, 10) : null;
  }
  function setBest(d, v) {
    localStorage.setItem(getBestKey(d), v);
  }

  function showBest() {
    const b = getBest(diff);
    document.getElementById("best-time").textContent = b !== null ? b + "s" : "—";
  }

  function setDiff(d) {
    diff = d;
    document.querySelectorAll(".diff-btn").forEach((b) => b.classList.remove("active"));
    document.getElementById("d-" + d).classList.add("active");
    newGame();
  }

  function getCellSize() {
    const cfg = DIFFS[diff];
    const available = window.innerWidth - 32;
    const maxCell = Math.floor((available - (cfg.cols - 1) * 2) / cfg.cols);
    return Math.min(32, Math.max(18, maxCell));
  }

  function newGame() {
    const cfg = DIFFS[diff];
    cols = cfg.cols;
    rows = cfg.rows;
    mineCount = cfg.mines;
    grid = Array.from({ length: rows }, () => Array(cols).fill(0));
    revealed = Array.from({ length: rows }, () => Array(cols).fill(false));
    flagged = Array.from({ length: rows }, () => Array(cols).fill(false));
    gameState = "idle";
    timerSecs = 0;
    clearInterval(timerInterval);
    document.getElementById("timer").textContent = "0s";
    document.getElementById("mine-count").textContent = mineCount;
    document.getElementById("status").textContent = "Left-click to reveal · Right-click to flag";
    const cs = getCellSize();
    document.documentElement.style.setProperty("--cell-size", cs + "px");
    document.getElementById("board").style.gridTemplateColumns = `repeat(${cols},${cs}px)`;
    showBest();
    render();
  }

  function placeMines(sr, sc) {
    let placed = 0;
    while (placed < mineCount) {
      const r = Math.floor(Math.random() * rows),
        c = Math.floor(Math.random() * cols);
      if (grid[r][c] === -1 || (Math.abs(r - sr) <= 1 && Math.abs(c - sc) <= 1)) continue;
      grid[r][c] = -1;
      placed++;
    }
    for (let r = 0; r < rows; r++)
      for (let c = 0; c < cols; c++) {
        if (grid[r][c] === -1) continue;
        let n = 0;
        for (let dr = -1; dr <= 1; dr++)
          for (let dc = -1; dc <= 1; dc++) {
            const nr = r + dr,
              nc = c + dc;
            if (nr >= 0 && nr < rows && nc >= 0 && nc < cols && grid[nr][nc] === -1) n++;
          }
        grid[r][c] = n;
      }
  }

  function reveal(r, c) {
    if (r < 0 || r >= rows || c < 0 || c >= cols || revealed[r][c] || flagged[r][c]) return;
    revealed[r][c] = true;
    if (grid[r][c] === 0) for (let dr = -1; dr <= 1; dr++) for (let dc = -1; dc <= 1; dc++) reveal(r + dr, c + dc);
  }

  function click(r, c) {
    if (gameState === "over" || gameState === "win" || flagged[r][c]) return;
    if (gameState === "idle") {
      placeMines(r, c);
      gameState = "playing";
      startTime = Date.now();
      timerInterval = setInterval(() => {
        timerSecs = Math.floor((Date.now() - startTime) / 1000);
        document.getElementById("timer").textContent = timerSecs + "s";
      }, 1000);
    }
    if (grid[r][c] === -1) {
      revealed[r][c] = true;
      gameState = "over";
      clearInterval(timerInterval);
      for (let rr = 0; rr < rows; rr++)
        for (let cc = 0; cc < cols; cc++) if (grid[rr][cc] === -1) revealed[rr][cc] = true;
      document.getElementById("status").textContent = "💥 Boom! Game over!";
      render();
      return;
    }
    reveal(r, c);
    const safe = rows * cols - mineCount;
    let revCount = 0;
    for (let rr = 0; rr < rows; rr++) for (let cc = 0; cc < cols; cc++) if (revealed[rr][cc]) revCount++;
    if (revCount >= safe) {
      gameState = "win";
      clearInterval(timerInterval);
      const t = Math.floor((Date.now() - startTime) / 1000);
      const prev = getBest(diff);
      if (prev === null || t < prev) {
        setBest(diff, t);
        showBest();
      }
      document.getElementById("status").textContent = `🎉 You won in ${t}s!`;
    }
    render();
  }

  function flag(e, r, c) {
    e.preventDefault();
    if (gameState === "over" || gameState === "win" || revealed[r][c]) return;
    flagged[r][c] = !flagged[r][c];
    const f = flagged.flat().filter(Boolean).length;
    document.getElementById("mine-count").textContent = mineCount - f;
    render();
  }

  // Long-press for mobile flagging
  let longPressTimer = null;
  function onTouchStart(e, r, c) {
    longPressTimer = setTimeout(() => {
      longPressTimer = null;
      flag(e, r, c);
      render();
    }, 500);
  }
  function onTouchEnd(e, r, c) {
    if (longPressTimer) {
      clearTimeout(longPressTimer);
      longPressTimer = null;
    }
  }

  function render() {
    const board = document.getElementById("board");
    board.innerHTML = "";
    for (let r = 0; r < rows; r++)
      for (let c = 0; c < cols; c++) {
        const cell = document.createElement("div");
        cell.className = "cell";
        if (revealed[r][c]) {
          cell.classList.add("revealed");
          if (grid[r][c] === -1)
            (cell.classList.add(gameState === "over" && !flagged[r][c] ? "mine-hit" : "safe-reveal"),
              (cell.textContent = "💣"));
          else if (grid[r][c] > 0) {
            cell.classList.add("n" + grid[r][c]);
            cell.textContent = grid[r][c];
          }
        } else if (flagged[r][c]) {
          cell.classList.add("flagged");
          cell.textContent = "🚩";
        }
        cell.onclick = () => click(r, c);
        cell.oncontextmenu = (e) => flag(e, r, c);
        cell.addEventListener("touchstart", (e) => onTouchStart(e, r, c), { passive: true });
        cell.addEventListener("touchend", (e) => onTouchEnd(e, r, c), { passive: true });
        board.appendChild(cell);
      }
  }

  newGame();
</script>
