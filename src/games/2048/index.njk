---
layout: layouts/game.njk
title: 2048
description: Slide and merge numbered tiles to reach the 2048 tile.
category: puzzle
icon: "🔢"
---

<style>
  #game-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 60px);
    gap: 1.5rem;
    padding: 1rem;
  }
  #header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: min(340px, calc(100vw - 2rem));
  }
  .stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    min-width: 80px;
  }
  .stat-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .stat-value {
    font-size: 1.2rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  #board {
    width: min(340px, calc(100vw - 2rem));
    aspect-ratio: 1;
    background: #0f172a;
    border-radius: 8px;
    border: 2px solid #1e293b;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(4, 1fr);
    gap: 8px;
    padding: 8px;
    position: relative;
  }
  .tile {
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-family: monospace;
    font-size: 1.5rem;
    transition: all 0.1s ease;
    background: #1e293b;
    color: #94a3b8;
  }
  .tile[data-v="2"] {
    background: #1e3a2f;
    color: #4ade80;
    font-size: 1.6rem;
  }
  .tile[data-v="4"] {
    background: #1e3a4f;
    color: #60a5fa;
    font-size: 1.6rem;
  }
  .tile[data-v="8"] {
    background: #312e81;
    color: #a78bfa;
    font-size: 1.6rem;
  }
  .tile[data-v="16"] {
    background: #4c1d95;
    color: #c4b5fd;
    font-size: 1.4rem;
  }
  .tile[data-v="32"] {
    background: #7c2d12;
    color: #fdba74;
    font-size: 1.4rem;
  }
  .tile[data-v="64"] {
    background: #92400e;
    color: #fcd34d;
    font-size: 1.4rem;
  }
  .tile[data-v="128"] {
    background: #78350f;
    color: #fef08a;
    font-size: 1.2rem;
  }
  .tile[data-v="256"] {
    background: #854d0e;
    color: #fef9c3;
    font-size: 1.2rem;
  }
  .tile[data-v="512"] {
    background: #713f12;
    color: #fff;
    font-size: 1.2rem;
  }
  .tile[data-v="1024"] {
    background: #451a03;
    color: #fff;
    font-size: 1rem;
  }
  .tile[data-v="2048"] {
    background: linear-gradient(135deg, #7c3aed, #db2777);
    color: #fff;
    font-size: 1rem;
  }
  #overlay {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.9);
    border-radius: 6px;
    gap: 1rem;
  }
  #overlay h2 {
    font-size: 1.5rem;
    font-weight: bold;
    color: white;
  }
  .play-btn {
    padding: 0.5rem 1.5rem;
    background: #7c3aed;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .play-btn:hover {
    background: #6d28d9;
  }
  .controls-hint {
    font-size: 0.75rem;
    color: #64748b;
  }
  #dpad {
    display: grid;
    grid-template-columns: repeat(3, 52px);
    grid-template-rows: repeat(2, 52px);
    gap: 6px;
  }
  .dpad-btn {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    color: white;
    font-size: 1.3rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .dpad-btn:active {
    background: #334155;
  }
  .new-btn {
    padding: 0.4rem 1rem;
    background: #334155;
    color: #e2e8f0;
    border: none;
    border-radius: 6px;
    font-size: 0.85rem;
    cursor: pointer;
    touch-action: manipulation;
  }
  .new-btn:hover {
    background: #475569;
  }
  .info-section {
    width: 100%;
    max-width: 380px;
    padding: 0 1rem 2rem;
    margin: 0 auto;
  }
  .info-details {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    margin-bottom: 0.75rem;
    overflow: hidden;
  }
  .info-details summary {
    padding: 0.75rem 1rem;
    font-weight: 600;
    color: #e2e8f0;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
  }
  .info-details summary::-webkit-details-marker {
    display: none;
  }
  .info-details summary::after {
    content: "+";
    font-size: 1.1rem;
    color: #64748b;
  }
  .info-details[open] summary::after {
    content: "−";
  }
  .info-body {
    padding: 0.75rem 1rem 1rem;
    color: #94a3b8;
    font-size: 0.875rem;
    line-height: 1.6;
    border-top: 1px solid #334155;
  }
  .info-body h4 {
    color: #e2e8f0;
    font-weight: 600;
    margin: 0.75rem 0 0.25rem;
    font-size: 0.875rem;
  }
  .info-body h4:first-child {
    margin-top: 0;
  }
  .info-body ul {
    padding-left: 1.25rem;
    margin: 0.25rem 0;
  }
  .info-body li {
    margin-bottom: 0.25rem;
  }
  .info-body p {
    margin: 0.25rem 0;
  }
</style>

<div id="game-wrapper">
  <div id="header">
    <div class="stat">
      <div class="stat-label">Score</div>
      <div class="stat-value" id="score">0</div>
    </div>
    <div style="text-align: center"><div style="font-size: 1.5rem; font-weight: bold; color: white">2048</div></div>
    <div class="stat">
      <div class="stat-label">Best</div>
      <div class="stat-value" id="best">0</div>
    </div>
  </div>
  <div id="board">
    <div id="overlay">
      <h2 id="overlay-title">2048</h2>
      <p id="overlay-msg" style="color: #94a3b8; font-size: 0.85rem">Reach the 2048 tile!</p>
      <button class="play-btn" id="overlay-btn" onclick="newGame()">Start Game</button>
    </div>
  </div>
  <div id="dpad">
    <div></div>
    <button class="dpad-btn" onclick="move('up')">▲</button>
    <div></div>
    <button class="dpad-btn" onclick="move('left')">◀</button>
    <button class="dpad-btn" onclick="move('down')">▼</button>
    <button class="dpad-btn" onclick="move('right')">▶</button>
  </div>
  <p class="controls-hint">Arrow keys · D-pad · or swipe</p>
  <button class="new-btn" onclick="newGame()">New Game</button>
</div>

<div class="info-section">
  <details class="info-details">
    <summary>How to Play</summary>
    <div class="info-body">
      <h4>Goal</h4>
      <p>
        Slide all tiles in one direction. Tiles with the same number <strong>merge</strong> into one tile with their
        sum. Reach the <strong>2048 tile</strong> to win!
      </p>
      <h4>Controls</h4>
      <ul>
        <li><strong>Arrow keys</strong> — slide all tiles in that direction (desktop)</li>
        <li><strong>Swipe</strong> — swipe left/right/up/down on the board (mobile)</li>
      </ul>
      <h4>Strategy Tips</h4>
      <ul>
        <li>Keep your highest tile in a corner</li>
        <li>Build a chain of decreasing values towards that corner</li>
        <li>Avoid filling the board — plan ahead!</li>
      </ul>
    </div>
  </details>
  <details class="info-details">
    <summary>FAQ</summary>
    <div class="info-body">
      <h4>What happens after reaching 2048?</h4>
      <p>You win, but the game continues! You can keep merging tiles to reach 4096, 8192, and beyond.</p>
      <h4>Is my best score saved?</h4>
      <p>Yes — your best score is automatically saved in your browser's local storage.</p>
      <h4>Can I undo a move?</h4>
      <p>Not currently. Think carefully before each swipe!</p>
    </div>
  </details>
</div>

<script>
  function launchConfetti() {
    const canvas = document.createElement("canvas");
    canvas.style.cssText = "position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999";
    document.body.appendChild(canvas);
    const ctx = canvas.getContext("2d");
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    const colors = ["#7c3aed", "#db2777", "#f59e0b", "#10b981", "#3b82f6", "#ef4444", "#fbbf24"];
    const pieces = Array.from({ length: 80 }, () => ({
      x: Math.random() * canvas.width,
      y: -10 - Math.random() * 40,
      r: Math.random() * 6 + 3,
      color: colors[Math.floor(Math.random() * colors.length)],
      vx: (Math.random() - 0.5) * 5,
      vy: Math.random() * 4 + 2,
      angle: Math.random() * Math.PI * 2,
      va: (Math.random() - 0.5) * 0.15,
    }));
    const start = performance.now();
    function draw(now) {
      if (now - start > 1500) {
        canvas.remove();
        return;
      }
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      pieces.forEach((p) => {
        p.x += p.vx;
        p.y += p.vy;
        p.angle += p.va;
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.angle);
        ctx.fillStyle = p.color;
        ctx.fillRect(-p.r, -p.r / 2, p.r * 2, p.r);
        ctx.restore();
      });
      requestAnimationFrame(draw);
    }
    requestAnimationFrame(draw);
  }

  const STORAGE_KEY = "mini-2048-best";
  let grid,
    score,
    best = parseInt(localStorage.getItem(STORAGE_KEY) || "0", 10),
    gameWon = false,
    newBestThisGame = false;

  document.getElementById("best").textContent = best;

  function newGrid() {
    return Array.from({ length: 4 }, () => Array(4).fill(0));
  }

  function addRandom(g) {
    const empty = [];
    for (let r = 0; r < 4; r++) for (let c = 0; c < 4; c++) if (!g[r][c]) empty.push([r, c]);
    if (!empty.length) return;
    const [r, c] = empty[Math.floor(Math.random() * empty.length)];
    g[r][c] = Math.random() < 0.9 ? 2 : 4;
  }

  function newGame() {
    grid = newGrid();
    score = 0;
    gameWon = false;
    newBestThisGame = false;
    addRandom(grid);
    addRandom(grid);
    document.getElementById("overlay").style.display = "none";
    render();
  }

  function slide(row) {
    let r = row.filter((x) => x),
      added = 0;
    for (let i = 0; i < r.length - 1; i++) {
      if (r[i] === r[i + 1]) {
        r[i] *= 2;
        score += r[i];
        r.splice(i + 1, 1);
        added++;
        if (r[i] === 2048 && !gameWon) gameWon = true;
      }
    }
    while (r.length < 4) r.push(0);
    return r;
  }

  function move(dir) {
    const prev = JSON.stringify(grid);
    if (dir === "left") grid = grid.map((r) => slide(r));
    else if (dir === "right") grid = grid.map((r) => slide([...r].reverse()).reverse());
    else if (dir === "up") {
      for (let c = 0; c < 4; c++) {
        const col = grid.map((r) => r[c]);
        slide(col).forEach((v, r) => (grid[r][c] = v));
      }
    } else if (dir === "down") {
      for (let c = 0; c < 4; c++) {
        const col = grid.map((r) => r[c]).reverse();
        slide(col)
          .reverse()
          .forEach((v, r) => (grid[r][c] = v));
      }
    }
    if (JSON.stringify(grid) !== prev) {
      addRandom(grid);
      if (score > best) {
        best = score;
        newBestThisGame = true;
        localStorage.setItem(STORAGE_KEY, best);
        document.getElementById("best").textContent = best;
      }
    }
    render();
    if (gameWon) {
      launchConfetti();
      showOverlay("You Win! 🎉", "Score: " + score, "Keep Going");
    } else if (isGameOver()) {
      if (newBestThisGame) launchConfetti();
      showOverlay("Game Over", "Score: " + score, "Try Again");
    }
  }

  function isGameOver() {
    for (let r = 0; r < 4; r++)
      for (let c = 0; c < 4; c++) {
        if (!grid[r][c]) return false;
        if (c < 3 && grid[r][c] === grid[r][c + 1]) return false;
        if (r < 3 && grid[r][c] === grid[r + 1][c]) return false;
      }
    return true;
  }

  function showOverlay(title, msg, btn) {
    document.getElementById("overlay-title").textContent = title;
    document.getElementById("overlay-msg").textContent = msg;
    document.getElementById("overlay-btn").textContent = btn;
    document.getElementById("overlay").style.display = "flex";
    gameWon = false;
  }

  function render() {
    document.getElementById("score").textContent = score;
    const board = document.getElementById("board");
    const overlay = document.getElementById("overlay");
    board.querySelectorAll(".tile").forEach((t) => t.remove());
    for (let r = 0; r < 4; r++)
      for (let c = 0; c < 4; c++) {
        const tile = document.createElement("div");
        tile.className = "tile";
        tile.dataset.v = grid[r][c] || "";
        tile.textContent = grid[r][c] || "";
        board.appendChild(tile);
      }
    board.appendChild(overlay);
  }

  document.addEventListener("keydown", (e) => {
    const map = { ArrowLeft: "left", ArrowRight: "right", ArrowUp: "up", ArrowDown: "down" };
    if (map[e.key]) {
      e.preventDefault();
      move(map[e.key]);
    }
  });

  let touchStart = null;
  document.getElementById("board").addEventListener(
    "touchstart",
    (e) => {
      touchStart = e.touches[0];
    },
    { passive: true }
  );
  document.getElementById("board").addEventListener(
    "touchend",
    (e) => {
      if (!touchStart) return;
      const dx = e.changedTouches[0].clientX - touchStart.clientX;
      const dy = e.changedTouches[0].clientY - touchStart.clientY;
      if (Math.abs(dx) > 20 || Math.abs(dy) > 20) {
        if (Math.abs(dx) > Math.abs(dy)) move(dx > 0 ? "right" : "left");
        else move(dy > 0 ? "down" : "up");
      }
      touchStart = null;
    },
    { passive: true }
  );

  render();
  document.getElementById("overlay").style.display = "flex";
</script>
