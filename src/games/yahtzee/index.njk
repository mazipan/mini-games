---
layout: layouts/game.njk
title: Yahtzee
description: Roll 5 dice up to 3 times and score your result in one of 13 categories!
category: board
icon: "🎲"
---

{% from "macros/game-components.njk" import statCard, summaryStatCard, infoDetails %}

<style>
  #game-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: calc(100vh - 60px);
    gap: 1rem;
    padding: 1rem;
  }
  .score-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.5rem 1rem;
  }
  .stat-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .stat-value {
    font-size: 1.2rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }
  .play-btn {
    padding: 0.5rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    background: #7c3aed;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .play-btn:hover {
    background: #6d28d9;
  }

  /* Dice area */
  #dice-area {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .die {
    width: 60px;
    height: 60px;
    background: #e2e8f0;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    cursor: pointer;
    transition:
      transform 0.1s,
      background 0.2s;
    border: 3px solid #e2e8f0;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }
  .die.held {
    background: #fbbf24;
    border-color: #f59e0b;
    transform: translateY(-6px);
  }
  .die.rolling {
    animation: roll-shake 0.3s ease;
  }
  @keyframes roll-shake {
    0%,
    100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(-15deg);
    }
    75% {
      transform: rotate(15deg);
    }
  }

  /* Roll button */
  #roll-btn {
    padding: 0.6rem 2rem;
    font-size: 1rem;
    font-weight: 700;
    background: #7c3aed;
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  #roll-btn:disabled {
    background: #334155;
    color: #64748b;
    cursor: not-allowed;
  }
  #rolls-left {
    color: #94a3b8;
    font-size: 0.85rem;
    text-align: center;
  }

  /* Scorecard */
  #scorecard {
    width: 100%;
    max-width: 400px;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 10px;
    overflow: hidden;
  }
  .scorecard-section {
    padding: 0.5rem 0;
  }
  .scorecard-title {
    padding: 0.4rem 1rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #7c3aed;
    background: #0f172a;
  }
  .score-row-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.4rem 1rem;
    border-bottom: 1px solid #1a2840;
    cursor: pointer;
    transition: background 0.15s;
  }
  .score-row-item:hover:not(.filled):not(.bonus-row) {
    background: #2d3f55;
  }
  .score-row-item.filled {
    cursor: default;
  }
  .score-row-item.bonus-row {
    cursor: default;
    background: #0f172a;
  }
  .score-row-item .cat-name {
    font-size: 0.85rem;
    color: #cbd5e1;
  }
  .score-row-item .cat-score {
    font-size: 0.9rem;
    font-weight: bold;
    font-family: monospace;
    color: #e2e8f0;
    min-width: 2.5rem;
    text-align: right;
  }
  .score-row-item.filled .cat-score {
    color: #22c55e;
  }
  .score-row-item .cat-score.potential {
    color: #64748b;
    font-style: italic;
  }
  .score-row-item .cat-score.zero {
    color: #475569;
  }

  #total-display {
    padding: 0.6rem 1rem;
    font-size: 1rem;
    font-weight: bold;
    color: #e2e8f0;
    background: #0f172a;
    text-align: right;
  }

  /* Win overlay */
  #win-overlay {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 1.5rem 1.25rem;
    text-align: center;
    width: 100%;
    max-width: 400px;
  }
  #win-overlay span:first-child {
    font-size: 3rem;
  }
  #win-overlay h2 {
    color: white;
    font-size: 1.4rem;
    margin: 0;
  }
  /* Score breakdown table */
  #score-breakdown {
    width: 100%;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    overflow: hidden;
    text-align: left;
  }
  .bd-title {
    padding: 0.22rem 0.75rem;
    font-size: 0.56rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #7c3aed;
    background: #0f172a;
  }
  .bd-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.18rem 0.75rem;
    border-bottom: 1px solid #1a2840;
    font-size: 0.7rem;
    color: #cbd5e1;
  }
  .bd-row.bd-bonus {
    background: rgba(124, 58, 237, 0.1);
    color: #a78bfa;
  }
  .bd-row.bd-total {
    background: #0f172a;
    font-weight: 700;
    font-size: 0.78rem;
    color: #e2e8f0;
    padding: 0.32rem 0.75rem;
    border-bottom: none;
  }
  .bd-val {
    font-family: monospace;
    font-weight: 600;
    color: #22c55e;
    min-width: 2.5rem;
    text-align: right;
  }
  .bd-val.zero {
    color: #475569;
  }
  .bd-val.bonus {
    color: #a78bfa;
  }
  .summary-row {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
  }
  .summary-stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.4rem 0.9rem;
  }
  .summary-label {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .summary-value {
    font-size: 1.2rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }

  /* Info section */
  .info-section {
    width: 100%;
    max-width: 480px;
    padding: 0 1rem 2rem;
    margin: 0 auto;
  }
  .info-details {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    margin-bottom: 0.5rem;
    overflow: hidden;
  }
  .info-details summary {
    padding: 0.75rem 1rem;
    cursor: pointer;
    font-weight: 600;
    color: #e2e8f0;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
  }
  .info-details summary::-webkit-details-marker {
    display: none;
  }
  .info-details summary::after {
    content: "+";
    font-size: 1.1rem;
    color: #64748b;
  }
  .info-details[open] summary::after {
    content: "−";
  }
  .info-body {
    padding: 0.75rem 1rem 1rem;
    color: #94a3b8;
    font-size: 0.875rem;
    line-height: 1.6;
    border-top: 1px solid #334155;
  }
  .info-body h4 {
    color: #e2e8f0;
    margin: 0.75rem 0 0.25rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .info-body h4:first-child {
    margin-top: 0;
  }
  .info-body ul {
    padding-left: 1.25rem;
    margin: 0.25rem 0;
  }
  .info-body li {
    margin-bottom: 0.25rem;
  }
  .info-body p {
    margin: 0.25rem 0;
  }
</style>

<div id="game-wrapper">
  <div class="score-row">
    {{ statCard("Round", "round-display", "1") }} {{ statCard("Score", "score-display", "0") }} {{ statCard("Best",
    "best-display", "0") }}
  </div>

  <div id="dice-area">
    <div class="die" id="die-0" onclick="toggleHold(0)">⚀</div>
    <div class="die" id="die-1" onclick="toggleHold(1)">⚀</div>
    <div class="die" id="die-2" onclick="toggleHold(2)">⚀</div>
    <div class="die" id="die-3" onclick="toggleHold(3)">⚀</div>
    <div class="die" id="die-4" onclick="toggleHold(4)">⚀</div>
  </div>
  <div id="rolls-left">Roll the dice to start!</div>
  <button id="roll-btn" onclick="rollDice()">🎲 Roll Dice</button>

  <div id="scorecard">
    <div class="scorecard-section">
      <div class="scorecard-title">Upper Section</div>
      <div class="score-row-item" id="cat-ones" onclick="scoreCategory('ones')">
        <span class="cat-name">Ones (1s)</span>
        <span class="cat-score" id="score-ones">—</span>
      </div>
      <div class="score-row-item" id="cat-twos" onclick="scoreCategory('twos')">
        <span class="cat-name">Twos (2s)</span>
        <span class="cat-score" id="score-twos">—</span>
      </div>
      <div class="score-row-item" id="cat-threes" onclick="scoreCategory('threes')">
        <span class="cat-name">Threes (3s)</span>
        <span class="cat-score" id="score-threes">—</span>
      </div>
      <div class="score-row-item" id="cat-fours" onclick="scoreCategory('fours')">
        <span class="cat-name">Fours (4s)</span>
        <span class="cat-score" id="score-fours">—</span>
      </div>
      <div class="score-row-item" id="cat-fives" onclick="scoreCategory('fives')">
        <span class="cat-name">Fives (5s)</span>
        <span class="cat-score" id="score-fives">—</span>
      </div>
      <div class="score-row-item" id="cat-sixes" onclick="scoreCategory('sixes')">
        <span class="cat-name">Sixes (6s)</span>
        <span class="cat-score" id="score-sixes">—</span>
      </div>
      <div class="score-row-item bonus-row">
        <span class="cat-name">Upper Bonus (+35 if ≥63)</span>
        <span class="cat-score" id="score-upper-bonus">—</span>
      </div>
    </div>
    <div class="scorecard-section">
      <div class="scorecard-title">Lower Section</div>
      <div class="score-row-item" id="cat-three-of-a-kind" onclick="scoreCategory('threeOfAKind')">
        <span class="cat-name">Three of a Kind</span>
        <span class="cat-score" id="score-three-of-a-kind">—</span>
      </div>
      <div class="score-row-item" id="cat-four-of-a-kind" onclick="scoreCategory('fourOfAKind')">
        <span class="cat-name">Four of a Kind</span>
        <span class="cat-score" id="score-four-of-a-kind">—</span>
      </div>
      <div class="score-row-item" id="cat-full-house" onclick="scoreCategory('fullHouse')">
        <span class="cat-name">Full House (25 pts)</span>
        <span class="cat-score" id="score-full-house">—</span>
      </div>
      <div class="score-row-item" id="cat-small-straight" onclick="scoreCategory('smallStraight')">
        <span class="cat-name">Small Straight (30 pts)</span>
        <span class="cat-score" id="score-small-straight">—</span>
      </div>
      <div class="score-row-item" id="cat-large-straight" onclick="scoreCategory('largeStraight')">
        <span class="cat-name">Large Straight (40 pts)</span>
        <span class="cat-score" id="score-large-straight">—</span>
      </div>
      <div class="score-row-item" id="cat-yahtzee" onclick="scoreCategory('yahtzee')">
        <span class="cat-name">Yahtzee! (50 pts)</span>
        <span class="cat-score" id="score-yahtzee">—</span>
      </div>
      <div class="score-row-item" id="cat-chance" onclick="scoreCategory('chance')">
        <span class="cat-name">Chance (any sum)</span>
        <span class="cat-score" id="score-chance">—</span>
      </div>
    </div>
    <div id="total-display">Total: 0</div>
  </div>

  <div id="win-overlay">
    <span id="win-icon">🏆</span>
    <h2 id="win-title">Game Complete!</h2>
    <div class="summary-row">
      {{ summaryStatCard("Score", "go-score") }} {{ summaryStatCard("Best", "go-best") }} {{ summaryStatCard("Yahtzees",
      "go-yahtzees") }}
    </div>
    <div id="score-breakdown"></div>
    <button class="play-btn" onclick="startGame()">New Game</button>
  </div>
</div>

<div class="info-section">
  {% call infoDetails("How to Play") %}
  <h4>Goal</h4>
  <p>Fill all 13 scoring categories over 13 rounds to maximize your total score.</p>
  <h4>Each Turn</h4>
  <ul>
    <li>Roll 5 dice up to 3 times per turn</li>
    <li>Click a die to <strong>hold</strong> it between rolls — it turns gold and lifts up</li>
    <li>After rolling, click a category in the scorecard to score it</li>
    <li>Grey numbers show what each unfilled category would score with your current dice</li>
  </ul>
  <h4>Upper Section</h4>
  <ul>
    <li><strong>Ones–Sixes:</strong> Sum of all dice showing that number</li>
    <li><strong>Upper Bonus:</strong> Score ≥63 in the upper section to earn +35 bonus points</li>
  </ul>
  <h4>Lower Section</h4>
  <ul>
    <li><strong>Three/Four of a Kind:</strong> Sum of all dice (if condition met)</li>
    <li><strong>Full House:</strong> Three of one + two of another = 25 pts</li>
    <li><strong>Small Straight:</strong> 4 sequential dice = 30 pts</li>
    <li><strong>Large Straight:</strong> 5 sequential dice = 40 pts</li>
    <li><strong>Yahtzee:</strong> All 5 dice the same = 50 pts; extra Yahtzees score +100 bonus each</li>
    <li><strong>Chance:</strong> Sum of all 5 dice, no conditions</li>
  </ul>
  {% endcall %} {% call infoDetails("FAQ") %}
  <h4>What if I can't score anything useful?</h4>
  <p>
    You must still choose a category every turn — click any unfilled category to score it (even for 0 points). Every
    category must be filled exactly once.
  </p>
  <h4>Can I re-use a category?</h4>
  <p>No — each of the 13 categories can only be scored once per game.</p>
  <h4>What is the upper bonus?</h4>
  <p>
    If your total score in the Ones through Sixes categories is 63 or more, you earn a +35 bonus. To hit 63 you
    generally need to score three of each number (e.g. three 3s = 9, three 6s = 18, etc.).
  </p>
  <h4>What happens with extra Yahtzees?</h4>
  <p>
    If you roll a Yahtzee after already scoring 50 pts in the Yahtzee category, you earn a +100 bonus and must score the
    roll in another open category.
  </p>
  <h4>Is my best score saved?</h4>
  <p>Yes — your highest score is saved in your browser's local storage and persists between sessions.</p>
  {% endcall %}
</div>

<script>
  const STORAGE_KEY = "mini-yahtzee-best";
  const DICE_FACES = ["", "⚀", "⚁", "⚂", "⚃", "⚄", "⚅"];
  const CATEGORIES = [
    "ones",
    "twos",
    "threes",
    "fours",
    "fives",
    "sixes",
    "threeOfAKind",
    "fourOfAKind",
    "fullHouse",
    "smallStraight",
    "largeStraight",
    "yahtzee",
    "chance",
  ];

  let best = parseInt(localStorage.getItem(STORAGE_KEY) || "0", 10);
  let dice, held, rollsLeft, round, scores, yahtzeeBonusCount, gameActive, rollGen;

  // ── Helpers ──────────────────────────────────────────────────────────────────

  function catToId(cat) {
    return cat.replace(/([A-Z])/g, "-$1").toLowerCase();
  }

  function calcScore(cat, d) {
    const counts = Array(7).fill(0);
    d.forEach((v) => counts[v]++);
    const sum = d.reduce((a, b) => a + b, 0);
    const vals = counts
      .slice(1)
      .filter((c) => c > 0)
      .sort((a, b) => b - a);

    switch (cat) {
      case "ones":
        return counts[1] * 1;
      case "twos":
        return counts[2] * 2;
      case "threes":
        return counts[3] * 3;
      case "fours":
        return counts[4] * 4;
      case "fives":
        return counts[5] * 5;
      case "sixes":
        return counts[6] * 6;
      case "threeOfAKind":
        return vals[0] >= 3 ? sum : 0;
      case "fourOfAKind":
        return vals[0] >= 4 ? sum : 0;
      case "fullHouse":
        return vals[0] === 3 && vals[1] === 2 ? 25 : 0;
      case "smallStraight":
        return hasSequence(counts, 4) ? 30 : 0;
      case "largeStraight":
        return hasSequence(counts, 5) ? 40 : 0;
      case "yahtzee":
        return vals[0] === 5 ? 50 : 0;
      case "chance":
        return sum;
      default:
        return 0;
    }
  }

  function hasSequence(counts, len) {
    let streak = 0;
    let best = 0;
    for (let i = 1; i <= 6; i++) {
      streak = counts[i] > 0 ? streak + 1 : 0;
      best = Math.max(best, streak);
    }
    return best >= len;
  }

  // ── Scorecard display ────────────────────────────────────────────────────────

  function updatePotentialScores() {
    CATEGORIES.forEach((cat) => {
      if (scores[cat] === null) {
        const potential = calcScore(cat, dice);
        const el = document.getElementById(`score-${catToId(cat)}`);
        if (el) {
          el.textContent = potential;
          el.className = `cat-score potential${potential === 0 ? " zero" : ""}`;
        }
      }
    });
  }

  function clearPotentialScores() {
    CATEGORIES.forEach((cat) => {
      if (scores[cat] === null) {
        const el = document.getElementById(`score-${catToId(cat)}`);
        if (el) {
          el.textContent = "—";
          el.className = "cat-score";
        }
      }
    });
  }

  function getUpperTotal() {
    const upper = ["ones", "twos", "threes", "fours", "fives", "sixes"];
    return upper.reduce((sum, cat) => sum + (scores[cat] || 0), 0);
  }

  function updateTotal() {
    const upper = getUpperTotal();
    const bonus = upper >= 63 ? 35 : 0;
    const lower = ["threeOfAKind", "fourOfAKind", "fullHouse", "smallStraight", "largeStraight", "yahtzee", "chance"];
    const lowerTotal = lower.reduce((sum, cat) => sum + (scores[cat] || 0), 0);
    const yahtzeeBonuses = scores._yahtzeeBonuses || 0;
    const total = upper + bonus + lowerTotal + yahtzeeBonuses;

    document.getElementById("score-upper-bonus").textContent = upper >= 63 ? "35" : `${upper}/63`;
    document.getElementById("score-display").textContent = total;
    document.getElementById("total-display").textContent = `Total: ${total}`;
    return total;
  }

  function updateRollsLeft() {
    const el = document.getElementById("rolls-left");
    if (rollsLeft === 3) {
      el.textContent = `Round ${round}/13 — Roll the dice!`;
      el.style.color = "";
    } else if (rollsLeft === 2) {
      el.textContent = "2 rolls left — hold dice to keep them";
      el.style.color = "";
    } else if (rollsLeft === 1) {
      el.textContent = "1 roll left — choose wisely!";
      el.style.color = "#fbbf24";
    } else {
      el.textContent = "No rolls left — pick a category below ↓";
      el.style.color = "#a78bfa";
    }
  }

  function updateRoundDisplay() {
    document.getElementById("round-display").textContent = round <= 13 ? round : "13";
  }

  function resetScorecard() {
    CATEGORIES.forEach((cat) => {
      const idSuffix = catToId(cat);
      const scoreEl = document.getElementById(`score-${idSuffix}`);
      const rowEl = document.getElementById(`cat-${idSuffix}`);
      if (scoreEl) {
        scoreEl.textContent = "—";
        scoreEl.className = "cat-score";
      }
      if (rowEl) {
        rowEl.classList.remove("filled");
      }
    });
    document.getElementById("score-upper-bonus").textContent = "—";
    document.getElementById("total-display").textContent = "Total: 0";
  }

  // ── Dice actions ─────────────────────────────────────────────────────────────

  function toggleHold(i) {
    if (rollsLeft === 3 || !gameActive) return;
    held[i] = !held[i];
    document.getElementById(`die-${i}`).classList.toggle("held", held[i]);
  }

  function rollDice() {
    if (rollsLeft === 0 || !gameActive) return;

    rollsLeft--;
    document.getElementById("roll-btn").disabled = true;
    updateRollsLeft();

    const newDice = dice.map((d, i) => (held[i] ? d : Math.ceil(Math.random() * 6)));
    const thisGen = ++rollGen;

    dice.forEach((_, i) => {
      if (!held[i]) document.getElementById(`die-${i}`).classList.add("rolling");
    });

    setTimeout(() => {
      if (thisGen !== rollGen) return;

      dice = newDice;
      dice.forEach((v, i) => {
        const el = document.getElementById(`die-${i}`);
        el.classList.remove("rolling");
        el.textContent = DICE_FACES[v];
      });

      updatePotentialScores();

      if (rollsLeft > 0) {
        document.getElementById("roll-btn").disabled = false;
      }
    }, 300);
  }

  // ── Scoring ──────────────────────────────────────────────────────────────────

  function scoreCategory(cat) {
    if (!gameActive || scores[cat] !== null || rollsLeft === 3) return;

    rollGen++; // cancel any in-flight roll animation from this round

    let points;
    const isYahtzeeRoll = calcScore("yahtzee", dice) === 50;

    if (cat === "yahtzee" && scores.yahtzee === 50 && isYahtzeeRoll) {
      // Extra Yahtzee bonus — can't re-fill the yahtzee box, so treat as bonus only
      yahtzeeBonusCount++;
      scores._yahtzeeBonuses = (scores._yahtzeeBonuses || 0) + 100;
      // Still need to pick a different category — return early and let player choose
      return;
    }

    points = calcScore(cat, dice);
    scores[cat] = points;

    const idSuffix = catToId(cat);
    const scoreEl = document.getElementById(`score-${idSuffix}`);
    if (scoreEl) {
      scoreEl.textContent = points;
      scoreEl.className = "cat-score";
    }
    const rowEl = document.getElementById(`cat-${idSuffix}`);
    if (rowEl) rowEl.classList.add("filled");

    round++;
    held = [false, false, false, false, false];
    rollsLeft = 3;

    dice.forEach((_, i) => {
      document.getElementById(`die-${i}`).classList.remove("held");
    });

    updateTotal();
    clearPotentialScores();
    updateRoundDisplay();

    if (round > 13) {
      gameActive = false;
      endGame();
    } else {
      document.getElementById("roll-btn").disabled = false;
      updateRollsLeft();
    }
  }

  // ── Game lifecycle ────────────────────────────────────────────────────────────

  function startGame() {
    dice = [1, 1, 1, 1, 1];
    held = [false, false, false, false, false];
    rollsLeft = 3;
    round = 1;
    yahtzeeBonusCount = 0;
    gameActive = true;
    rollGen = 0;
    scores = {};
    CATEGORIES.forEach((cat) => (scores[cat] = null));
    scores._yahtzeeBonuses = 0;

    document.getElementById("win-overlay").style.display = "none";
    document.getElementById("round-display").textContent = "1";
    document.getElementById("score-display").textContent = "0";
    document.getElementById("roll-btn").disabled = false;
    document.getElementById("rolls-left").textContent = "Round 1/13 — Roll the dice!";

    dice.forEach((_, i) => {
      const el = document.getElementById(`die-${i}`);
      el.textContent = "⚀";
      el.classList.remove("held", "rolling");
    });

    resetScorecard();
  }

  function buildBreakdown() {
    const upper = ["ones", "twos", "threes", "fours", "fives", "sixes"];
    const upperLabels = ["Ones", "Twos", "Threes", "Fours", "Fives", "Sixes"];
    const lower = ["threeOfAKind", "fourOfAKind", "fullHouse", "smallStraight", "largeStraight", "yahtzee", "chance"];
    const lowerLabels = [
      "Three of a Kind",
      "Four of a Kind",
      "Full House",
      "Small Straight",
      "Large Straight",
      "Yahtzee!",
      "Chance",
    ];

    const upperTotal = upper.reduce((s, c) => s + (scores[c] || 0), 0);
    const bonus = upperTotal >= 63 ? 35 : 0;
    const lowerTotal = lower.reduce((s, c) => s + (scores[c] || 0), 0);
    const yahtzeeBonus = scores._yahtzeeBonuses || 0;
    const grandTotal = upperTotal + bonus + lowerTotal + yahtzeeBonus;

    function row(label, val, cls) {
      const valCls = cls || (val === 0 ? "zero" : "");
      return `<div class="bd-row"><span>${label}</span><span class="bd-val ${valCls}">${val}</span></div>`;
    }

    let html = `<div class="bd-title">Upper Section</div>`;
    upper.forEach((c, i) => (html += row(upperLabels[i], scores[c] || 0)));
    const bonusLabel = bonus > 0 ? `Upper Bonus ✓` : `Upper Bonus (${upperTotal}/63)`;
    const bonusVal = bonus > 0 ? "+35" : "—";
    html += `<div class="bd-row bd-bonus"><span>${bonusLabel}</span><span class="bd-val bonus">${bonusVal}</span></div>`;

    html += `<div class="bd-title">Lower Section</div>`;
    lower.forEach((c, i) => (html += row(lowerLabels[i], scores[c] || 0)));
    if (yahtzeeBonus > 0) {
      html += row(`Yahtzee Bonus ×${yahtzeeBonusCount}`, `+${yahtzeeBonus}`, "bonus");
    }

    html += `<div class="bd-row bd-total"><span>Grand Total</span><span class="bd-val">${grandTotal}</span></div>`;

    document.getElementById("score-breakdown").innerHTML = html;
  }

  function endGame() {
    gameActive = false;
    const total = updateTotal();
    const isNewBest = total > best;
    if (isNewBest) {
      best = total;
      localStorage.setItem(STORAGE_KEY, best);
      document.getElementById("best-display").textContent = best;
      launchConfetti();
    }
    document.getElementById("win-icon").textContent = isNewBest ? "🎉" : "🏆";
    document.getElementById("win-title").textContent = isNewBest ? "New Best Score!" : "Game Complete!";
    document.getElementById("go-score").textContent = total;
    document.getElementById("go-best").textContent = best;
    const yahtzeeCount = yahtzeeBonusCount + (scores.yahtzee === 50 ? 1 : 0);
    document.getElementById("go-yahtzees").textContent = yahtzeeCount;
    buildBreakdown();
    document.getElementById("win-overlay").style.display = "flex";
  }

  // ── Confetti ──────────────────────────────────────────────────────────────────

  function launchConfetti() {
    const cc = document.createElement("canvas");
    cc.style.cssText = "position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999";
    document.body.appendChild(cc);
    const cctx = cc.getContext("2d");
    cc.width = window.innerWidth;
    cc.height = window.innerHeight;
    const colors = ["#7c3aed", "#db2777", "#f59e0b", "#10b981", "#3b82f6", "#ef4444", "#fbbf24"];
    const pieces = Array.from({ length: 80 }, () => ({
      x: Math.random() * cc.width,
      y: -10 - Math.random() * 40,
      r: Math.random() * 6 + 3,
      color: colors[Math.floor(Math.random() * colors.length)],
      vx: (Math.random() - 0.5) * 5,
      vy: Math.random() * 4 + 2,
      angle: Math.random() * Math.PI * 2,
      va: (Math.random() - 0.5) * 0.15,
    }));
    const start = performance.now();
    function drawC(now) {
      if (now - start > 3000) {
        cc.remove();
        return;
      }
      cctx.clearRect(0, 0, cc.width, cc.height);
      pieces.forEach((p) => {
        p.x += p.vx;
        p.y += p.vy;
        p.angle += p.va;
        cctx.save();
        cctx.translate(p.x, p.y);
        cctx.rotate(p.angle);
        cctx.fillStyle = p.color;
        cctx.fillRect(-p.r, -p.r / 2, p.r * 2, p.r);
        cctx.restore();
      });
      requestAnimationFrame(drawC);
    }
    requestAnimationFrame(drawC);
  }

  // ── Init ──────────────────────────────────────────────────────────────────────

  document.getElementById("best-display").textContent = best;
  startGame();
</script>
