---
layout: layouts/base.njk
title: Design System
description: Shared components, tokens, and patterns used across all mini-games.
---

<style>
  /* ── Page chrome ───────────────────────────────────────── */
  .ds-section {
    margin-bottom: 4rem;
    scroll-margin-top: 5rem;
  }
  .ds-section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #e2e8f0;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #1e293b;
    margin-bottom: 1.5rem;
  }
  .ds-subsection-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 1.5rem 0 0.75rem;
  }
  .ds-preview {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-start;
  }
  .ds-preview.center {
    justify-content: center;
  }
  .ds-code {
    background: #020617;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 1rem 1.25rem;
    font-family: "JetBrains Mono", "Fira Code", monospace;
    font-size: 0.78rem;
    line-height: 1.7;
    color: #94a3b8;
    overflow-x: auto;
    margin-top: 0.75rem;
    white-space: pre;
  }
  .ds-code .kw {
    color: #c084fc;
  }
  .ds-code .sel {
    color: #67e8f9;
  }
  .ds-code .val {
    color: #86efac;
  }
  .ds-code .cmt {
    color: #475569;
  }
  .ds-note {
    font-size: 0.8rem;
    color: #64748b;
    margin-top: 0.5rem;
    line-height: 1.6;
  }

  /* ── Color swatches ────────────────────────────────────── */
  .swatch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 0.75rem;
  }
  .swatch {
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #1e293b;
  }
  .swatch-color {
    height: 56px;
  }
  .swatch-info {
    padding: 0.4rem 0.5rem;
    background: #0f172a;
  }
  .swatch-name {
    font-size: 0.7rem;
    font-weight: 600;
    color: #e2e8f0;
  }
  .swatch-hex {
    font-size: 0.65rem;
    color: #64748b;
    font-family: monospace;
  }

  /* ── Stat cards (game component) ──────────────────────── */
  .stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    min-width: 80px;
  }
  .stat-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .stat-value {
    font-size: 1.2rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }

  /* ── Summary stat cards (game-over component) ──────────── */
  .summary-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .summary-stat {
    text-align: center;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.5rem 0.9rem;
    min-width: 72px;
  }
  .summary-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }
  .summary-value {
    font-size: 1.2rem;
    font-weight: bold;
    color: #e2e8f0;
    font-family: monospace;
  }

  /* ── Score row ──────────────────────────────────────────── */
  .score-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
  }

  /* ── Buttons (game components) ─────────────────────────── */
  .play-btn {
    padding: 0.5rem 1.5rem;
    background: #7c3aed;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .play-btn:hover {
    background: #6d28d9;
  }

  .play-btn.green {
    background: #16a34a;
  }
  .play-btn.green:hover {
    background: #15803d;
  }
  .play-btn.orange {
    background: #ea580c;
  }
  .play-btn.orange:hover {
    background: #c2410c;
  }

  .new-btn {
    padding: 0.4rem 1rem;
    background: #334155;
    color: #e2e8f0;
    border: none;
    border-radius: 6px;
    font-size: 0.85rem;
    cursor: pointer;
    touch-action: manipulation;
  }
  .new-btn:hover {
    background: #475569;
  }

  .diff-btn {
    padding: 0.3rem 0.8rem;
    background: #1e293b;
    color: #94a3b8;
    border: 1px solid #334155;
    border-radius: 6px;
    font-size: 0.8rem;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .diff-btn.active,
  .diff-btn:hover {
    background: #334155;
    color: white;
    border-color: #7c3aed;
  }

  /* ── D-pad ──────────────────────────────────────────────── */
  .dpad {
    display: grid;
    grid-template-columns: repeat(3, 52px);
    grid-template-rows: repeat(2, 52px);
    gap: 6px;
  }
  .dpad-btn {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    color: white;
    font-size: 1.3rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .dpad-btn:active {
    background: #334155;
  }

  /* ── Overlay (demo card) ────────────────────────────────── */
  .overlay-card {
    background: rgba(15, 23, 42, 0.96);
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 1.5rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    min-width: 220px;
  }
  .overlay-card h3 {
    font-size: 1.4rem;
    font-weight: bold;
    color: white;
  }
  .demo-label {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #7c3aed;
  }

  /* ── Playing cards ─────────────────────────────────────── */
  .playing-card {
    width: 56px;
    height: 82px;
    background: white;
    border: 1.5px solid #d1d5db;
    border-radius: 6px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 3px 4px;
    font-weight: bold;
    font-family: monospace;
    color: #1e293b;
    cursor: pointer;
    user-select: none;
    flex-shrink: 0;
    position: relative;
  }
  .playing-card.red {
    color: #dc2626;
  }
  .playing-card.face-down {
    background: repeating-linear-gradient(135deg, #1e40af 0px, #1e40af 4px, #1d4ed8 4px, #1d4ed8 8px);
    border-color: #1e3a8a;
    cursor: default;
  }
  .playing-card.selected {
    border-color: #3b82f6;
    box-shadow:
      0 0 0 2px #3b82f6,
      0 0 10px rgba(59, 130, 246, 0.5);
  }
  .playing-card.hinted {
    border-color: #fbbf24;
    animation: pc-hint-pulse 0.9s ease-in-out infinite;
  }
  .playing-card.foundation-ready {
    border-color: #22c55e;
    animation: pc-foundation-pulse 0.9s ease-in-out infinite;
  }
  @keyframes pc-hint-pulse {
    0%,
    100% {
      box-shadow:
        0 0 0 2px #fbbf24,
        0 0 8px rgba(251, 191, 36, 0.4);
    }
    50% {
      box-shadow:
        0 0 0 3px #fbbf24,
        0 0 16px rgba(251, 191, 36, 0.7);
    }
  }
  @keyframes pc-foundation-pulse {
    0%,
    100% {
      box-shadow:
        0 0 0 2px #22c55e,
        0 0 8px rgba(34, 197, 94, 0.4);
    }
    50% {
      box-shadow:
        0 0 0 3px #22c55e,
        0 0 16px rgba(34, 197, 94, 0.7);
    }
  }
  .pc-corner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1;
    gap: 1px;
  }
  .pc-corner.pc-bottom {
    transform: rotate(180deg);
    align-self: flex-end;
  }
  .pc-rank {
    font-size: 0.75rem;
  }
  .pc-suit {
    font-size: 0.6rem;
  }
  .pc-center {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    pointer-events: none;
  }

  /* ── Info / collapsible section ─────────────────────────── */
  .info-details {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 8px;
    margin-bottom: 0.75rem;
    overflow: hidden;
    width: 100%;
  }
  .info-details summary {
    padding: 0.75rem 1rem;
    font-weight: 600;
    color: #e2e8f0;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
  }
  .info-details summary::-webkit-details-marker {
    display: none;
  }
  .info-details summary::after {
    content: "+";
    font-size: 1.1rem;
    color: #64748b;
  }
  .info-details[open] summary::after {
    content: "−";
  }
  .info-body {
    padding: 0.75rem 1rem 1rem;
    color: #94a3b8;
    font-size: 0.875rem;
    line-height: 1.6;
    border-top: 1px solid #334155;
  }
  .info-body h4 {
    color: #e2e8f0;
    font-weight: 600;
    margin: 0.75rem 0 0.25rem;
    font-size: 0.875rem;
  }
  .info-body h4:first-child {
    margin-top: 0;
  }
  .info-body ul {
    padding-left: 1.25rem;
    margin: 0.25rem 0;
  }
  .info-body li {
    margin-bottom: 0.25rem;
  }
</style>

